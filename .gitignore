*.backup.*
*.pre-xtmux
*.tmp
.DS_Store

# Compiled Bun binary — build locally via `bun run build` (xtmux-3xs.11)
/bin/xtmux-obs
/bin/*.map
.xtrm/hooks/tsconfig-cache.json

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
# Passive export of the Dolt audit log — rewritten on every bd action (xtrm-136tf)
.beads/interactions.jsonl

# Local Serena project metadata
.serena/

# Local pi harness artifacts
.pi/

# xt / bd worktrees (transient sandbox checkouts)
.xtrm/worktrees/
.worktrees/

# Bun / Node
node_modules/
dist/
*.tsbuildinfo

# xtrm runtime state (per-machine, do not track)
.xtrm/skills/state.json
.pi/skills/
.xtrm/cache/
.xtrm/statusline-claim

# specialists runtime state (per-machine, do not track) — xtrm-136tf.
# Enumerated, not a blanket `.specialists/`: repo-local specialist config
# (default/, mandatory-rules/, user.json) must stay trackable.
.specialists/db/
.specialists/jobs/
.specialists/ready/
.specialists/trace.jsonl
.specialists/executor-result.md

# Runtime skill links are machine-specific absolute symlinks into ~/.xtrm.
# The blanket .agents/ rule above cannot exclude them because .agents/skills/beads
# is intentionally tracked, so git descends into the directory regardless.
.agents/skills/*
!.agents/skills/beads/

# Post-migration residue: per-repo copies of skills/hooks now owned by the
# global ~/.xtrm tree. Kept on disk as a safety net, never committed.
.xtrm/skills/local-legacy/
.xtrm/hooks/inbox-reminder-stop.mjs
.xtrm/hooks/project-memory.mjs
.xtrm/hooks/worktree-reap-sweep.mjs
