}

instance_get() {
  # K4 (xtmux-s96.4). agent-state.sh calls this through the `xtmux` name on
  # PATH, which is THIS dispatcher — an unrouted subcommand would fall through
  # to the interactive picker and the pane-metadata rehydration would silently
  # no-op on every real install while passing every test that stubs `xtmux`.
  local target="${1:-}" json=0
  [ -n "$target" ] || { printf 'usage: instance-get <instance-id> [--json]\n' >&2; return 2; }
  shift || true
  [ "${1:-}" = '--json' ] && json=1
  obs_v2_mode
  [ "$REPLY" = on ] || { printf 'instance-get: requires XTMUX_OBS_V2=1\n' >&2; return 2; }
  obs_runtime_argv
  local args=(instance-get "$target")
  [ "$json" = 1 ] && args+=(--json)
  exec "${OBS_ARGV[@]}" "${args[@]}"
}

