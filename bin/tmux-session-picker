    picker_state_write filter '' || true
    exit 0
    ;;
  filter-preset)
    shift
    [ "$#" -eq 1 ] || die_usage "filter-preset requires all, waiting, or running"
    case "$1" in all) _preset='' ;; waiting|running) _preset="$1" ;; *) die_usage "invalid filter preset: $1" ;; esac
    picker_state_write filter "$_preset" || true
    exit 0
    ;;
  prompt-label)
    # fzf transform-prompt source: reflects the active filter in the prompt.
    shift
    _style="${1:-classic}"
    picker_state_read filter || true
    _spec="$REPLY"
    if [ -n "$_spec" ]; then printf '%s> ' "$_spec"; else printf 'all> '; fi
    exit 0
    ;;
  install-hooks)
    shift
    install_tmux_hooks "${1:-}"
    exit 0
    ;;
  "")
    # Bare legacy picker: the original classic newline-TSV launcher and
    # interaction semantics, byte-compatible (NAV-2 split-launch invariant).
    pick_classic
    exit $?
    ;;
  help|--help|-h)
    help_text
    exit 0
    ;;
  *)
    # The old ~1,500-character usage blob lived here. It listed every flag and
    # was unreadable, so agents missed required args that were technically in it
    # (`message-list --for`). Point at the grouped reference instead.
    printf 'xtmux: unknown command: %s\n' "${1:-}" >&2
    printf 'run `xtmux help` for the command reference, `xtmux mux-help` for the delegation protocol.\n' >&2
    exit 2
    ;;
esac

# Every dispatch arm above exits. Bare `xtmux` routes to pick_classic and bare
# `xtmux nav` to pick_nav; nothing falls through to a second launcher.
exit 0
