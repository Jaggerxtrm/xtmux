}

# xtmux-gdk: the viewer-facing episode projection — one user prompt plus all
# continuations until control returns to the operator. The latest agent_turns
# row is never the response; the episode is.
agent_episode() {
  local target="${1:-}" json=0
  [ -n "$target" ] || { printf 'usage: agent-episode <pane-id|session-id> [--json]\n' >&2; return 2; }
  shift || true
  [ "${1:-}" = '--json' ] && json=1
  obs_v2_mode
  [ "$REPLY" = on ] || { printf 'agent-episode: requires XTMUX_OBS_V2=1\n' >&2; return 2; }
  obs_runtime_argv
  local args=(agent-episode "$target")
  [ "$json" = 1 ] && args+=(--json)
  exec "${OBS_ARGV[@]}" "${args[@]}"
}

unread_count() {
  local recipient="" pane="" arg
  while [ "$#" -gt 0 ]; do
    arg="$1"; shift
    case "$arg" in
      --for) [ "$#" -gt 0 ] || return 2; recipient="$1"; shift ;;
      --for=*) recipient="${arg#--for=}" ;;
      --pane) [ "$#" -gt 0 ] || return 2; pane="$1"; shift ;;
      --pane=*) pane="${arg#--pane=}" ;;
      *) printf 'unread-count: unknown arg: %s\n' "$arg" >&2; return 2 ;;
    esac
  done
  # xtrm-wiy5n.4.24: --for is optional. The underlying CLI resolves the missing
  # value through liveTmuxRequester when running under tmux, so a Claude hook
  # can call `unread-count --pane $TMUX_PANE` without a prior session-id lookup.
  obs_v2_mode
  [ "$REPLY" = on ] || { printf 'unread-count: requires XTMUX_OBS_V2=1\n' >&2; return 2; }
  if [ -n "$recipient" ] && resolve_to_session_id "$recipient"; then recipient="$REPLY"; fi
  obs_runtime_argv
  local args=(unread-count)
  [ -n "$recipient" ] && args+=(--for "$recipient")
  [ -n "$pane" ] && args+=(--pane "$pane")
  exec "${OBS_ARGV[@]}" "${args[@]}"
}

message_json_field() {
  local name="$1" line="$2"
  printf '%s\n' "$line" | sed -n "s/.*\"$name\":\"\([^\"\\]*\)\".*/\1/p"
}

# _message_list_v1_body — V1 JSONL scan producing message-list stdout.
# Shared between the mode=off direct path and the mode=shadow capture-then-diff
# path (xtmux-3xs.12). Args: <for> <since_secs> <limit> <unacked_bool> <message_key>.
_message_list_v1_body() {
  local to="$1" since="$2" limit="$3" unacked="$4" message_key="${5:-}"
  local file files=() now since_epoch ack_tmp line ts_epoch id from target bead text ts to_sid=''
  event_log_file; file="$REPLY"
  if [ -n "$to" ]; then
    if resolve_to_session_id "$to"; then to_sid="$REPLY"; else to_sid=''; fi
  fi
  local i
  [ -f "$file" ] && files+=("$file")
  for ((i=1; i<=XTMUX_EVENT_LOG_KEEP; i++)); do
    [ -f "${file}.$i" ] && files+=("${file}.$i")
  done
  [ ${#files[@]} -gt 0 ] || return 0
  now="$(date +%s)"; since_epoch=0
  [ -n "$since" ] && since_epoch=$(( now - since ))
  ack_tmp="$(mktemp)"
  trap 'rm -f "${ack_tmp:-}"' RETURN EXIT INT TERM
  grep -hF '"type":"message.ack"' "${files[@]}" 2>/dev/null | sed -n 's/.*"id":"\([^"\\]*\)".*/\1/p' > "$ack_tmp" || true
  while IFS= read -r line; do
    case "$line" in *'"type":"message.sent"'*) ;; *) continue ;; esac
    ts_epoch="$(printf '%s\n' "$line" | sed -n 's/.*"ts_epoch":\([0-9][0-9]*\).*/\1/p')"
    if [ "$since_epoch" -gt 0 ]; then
      [ -n "$ts_epoch" ] && [ "$ts_epoch" -lt "$since_epoch" ] && continue
    fi
    id="$(message_json_field id "$line")"
    from="$(message_json_field from "$line")"
    target="$(message_json_field to "$line")"
    bead="$(message_json_field bead "$line")"
    text="$(message_json_field text "$line")"
    ts="$(message_json_field ts "$line")"
    if [ -n "$to" ] && [ "$target" != "$to" ] && { [ -z "$to_sid" ] || [ "$target" != "$to_sid" ]; }; then
      continue
    fi
    [ -z "$message_key" ] || [ "$id" = "$message_key" ] || continue
    if [ "$unacked" = 1 ] && grep -Fx -- "$id" "$ack_tmp" >/dev/null 2>&1; then continue; fi
    if [ "$unacked" = 1 ]; then
      format_age_short "${ts_epoch:-0}"
      printf 'message\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$ts" "$REPLY" "$from" "$target" "$bead" "$text"
    else
      printf 'message\t%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$ts" "$from" "$target" "$bead" "$text"
    fi
  done < <(grep -hF '"type":"message.sent"' "${files[@]}" 2>/dev/null) | tail -n "$limit"
}

message_list() {
  local to='' pane='' from='' since='' message_key='' limit=100 unacked=0 expects_reply=0 json=0 arg
  while [ "$#" -gt 0 ]; do
    arg="$1"; shift
    case "$arg" in
      --for|--to) [ "$#" -gt 0 ] || return 2; to="$1"; shift ;;
      --for=*|--to=*) to="${arg#*=}" ;;
      --from) [ "$#" -gt 0 ] || return 2; from="$1"; shift ;;
      --from=*) from="${arg#--from=}" ;;
      --message-key) [ "$#" -gt 0 ] || return 2; message_key="$1"; shift ;;
      --message-key=*) message_key="${arg#--message-key=}" ;;
      --since) [ "$#" -gt 0 ] || return 2; parse_wait_duration "$1" || return 2; since="$REPLY"; shift ;;
      --since=*) parse_wait_duration "${arg#--since=}" || return 2; since="$REPLY" ;;
      --limit) [ "$#" -gt 0 ] || return 2; limit="$1"; shift ;;
      --limit=*) limit="${arg#--limit=}" ;;
      --pane) [ "$#" -gt 0 ] || return 2; pane="$1"; shift ;;
      --pane=*) pane="${arg#--pane=}" ;;
      --unacked) unacked=1 ;;
      --expects-reply) expects_reply=1 ;;
      --json) json=1 ;;
      *) printf 'message-list: unknown arg: %s\n' "$arg" >&2; return 2 ;;
    esac
  done
  obs_v2_mode; local mode="$REPLY"
  if [ "$mode" != 'on' ] && { [ "$expects_reply" = 1 ] || [ "$json" = 1 ] || [ -n "$pane" ]; }; then
    printf 'message-list: --pane/--expects-reply/--json require V2\n' >&2
    return 2
  fi
  # xtrm-wiy5n.4.24 (Codex #87): the no---for form is V2-only. The legacy
  # v1/shadow scanners (_message_list_v1_body) receive `to` verbatim and, when
  # it is empty, skip the recipient predicate — returning messages for every
  # recipient in the events log. That is an information-disclosure shape,
  # not a cosmetic gap, so refuse it here loudly instead of silently
  # widening the query. V2 mode still resolves the implicit recipient through
  # liveTmuxRequester in the underlying CLI (see cliMessageList).
  if [ "$mode" != 'on' ] && [ -z "$to" ]; then
    printf 'message-list: --for is required in XTMUX_OBS_V2=%s mode (implicit live-tmux fallback is V2-only)\n' "$mode" >&2
    return 2
  fi
  if [ "$mode" = 'on' ]; then
    # xtrm-wiy5n.4.24: --for is optional; the CLI resolves it through
    # liveTmuxRequester when running under tmux (Claude hook use case).
    # V1/shadow paths still need a name/id up front — they scan events.jsonl.
    local to_sid_v2=''
    if [ -n "$to" ] && resolve_to_session_id "$to"; then to_sid_v2="$REPLY"; else to_sid_v2="$to"; fi
    obs_runtime_argv
    local cli_args=(message-list --limit "$limit")
    [ -n "$to_sid_v2" ]      && cli_args+=(--for "$to_sid_v2")
    [ "$unacked" = 1 ]       && cli_args+=(--unacked)
    [ "$expects_reply" = 1 ] && cli_args+=(--expects-reply)
    [ "$json" = 1 ]          && cli_args+=(--json)
    [ -n "$pane" ]           && cli_args+=(--pane "$pane")
    [ -n "$from" ]           && cli_args+=(--from "$from")
    [ -n "$message_key" ]    && cli_args+=(--message-key "$message_key")
    [ -n "$since" ]          && cli_args+=(--since "$since")
    exec "${OBS_ARGV[@]}" "${cli_args[@]}"
  fi
  if [ "$mode" = 'shadow' ]; then
    local v1_out v2_out=''
    v1_out="$(_message_list_v1_body "$to" "$since" "$limit" "$unacked" "$message_key")"
    if obs_available; then
      local to_sid_v2=''
      if [ -n "$to" ] && resolve_to_session_id "$to"; then to_sid_v2="$REPLY"; else to_sid_v2="$to"; fi
      if [ -n "$to_sid_v2" ]; then
        obs_runtime_argv
        local v2_args=(message-list --for "$to_sid_v2" --limit "$limit")
        [ "$unacked" = 1 ] && v2_args+=(--unacked)
        [ "$expects_reply" = 1 ] && v2_args+=(--expects-reply)
        [ -n "$from" ] && v2_args+=(--from "$from")
        [ -n "$message_key" ] && v2_args+=(--message-key "$message_key")
        [ -n "$since" ] && v2_args+=(--since "$since")
        v2_out="$("${OBS_ARGV[@]}" "${v2_args[@]}" 2>/dev/null || true)"
      fi
    fi
    obs_shadow_diff messages message-list content "$v1_out" "$v2_out"
    [ -n "$v1_out" ] && printf '%s\n' "$v1_out"
    return 0
  fi
  _message_list_v1_body "$to" "$since" "$limit" "$unacked" "$message_key"
}

join_args_for_log() {
  local out='' arg
  for arg in "$@"; do
    out+="${out:+ }$arg"
  done
  printf '%s' "$out"
}

git_repo_root() {
  REPLY="$(git rev-parse --show-toplevel 2>/dev/null || true)"
}

git_current_branch() {
  REPLY="$(git branch --show-current 2>/dev/null || git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
}

git_head_hash() {
  REPLY="$(git rev-parse --short HEAD 2>/dev/null || true)"
}

# One command_runs row per invocation (xtmux-3xs.7): insert on start, UPDATE the
# same row on finish. The wrapped command still runs here in the shell, so its
# stdout/stderr/exit pass through untouched (PRD §20).
obs_run_start() {
  local tool="$1" mode="$2" session="$3" pane="$4" bead="$5" cwd="$6" repo="$7" branch="$8" head="$9"; shift 9
  [ "$mode" = 'off' ] && return 0
  obs_available || return 0
  obs_runtime_argv
  local args=(telemetry start --tool "$tool" --pid "$$")
  [ -n "$session" ] && args+=(--session "$session")
  [ -n "$pane" ] && args+=(--pane "$pane")
  [ -n "$bead" ] && args+=(--bead "$bead")
  [ -n "$cwd" ] && args+=(--cwd "$cwd")
  [ -n "$repo" ] && args+=(--repo "$repo")
  [ -n "$branch" ] && args+=(--branch "$branch")
  [ -n "$head" ] && args+=(--head "$head")
  args+=(-- "$@")
  "${OBS_ARGV[@]}" "${args[@]}" 2>/dev/null || true
}
obs_run_finish() {
  local run_id="$1" rc="$2" branch="$3" head="$4"
  [ -n "$run_id" ] || return 0
  obs_call telemetry finish --id "$run_id" --exit "$rc" --branch "$branch" --head "$head"
}

telemetry_run() {
  local tool="${1:-}"; shift || true
  [ -n "$tool" ] || { printf 'usage: telemetry <git|bd|gh> -- <args...>\n' >&2; return 2; }
  [ "${1:-}" = -- ] && shift
  [ "$#" -gt 0 ] || { printf 'usage: telemetry %s -- <args...>\n' "$tool" >&2; return 2; }
  local event args pane session bead cwd rc repo branch head sub mode run_id session_id
  args="$(join_args_for_log "$@")"
  obs_v2_mode; mode="$REPLY"
  pane=''; session=''; session_id=''; bead=''
  # In V2, a missing TMUX context means identity is unknown. Do not let tmux
  # resolve its default server and credit a bystander pane. V1 keeps its
  # historical lookup for byte-identity compatibility.
  if tmux_identity_available; then
    current_tmux_pane; pane="$REPLY"
    current_tmux_session; session="$REPLY"
    current_tmux_session_id; session_id="$REPLY"
    [ -n "$pane" ] && bead="$(tmux show-options -p -t "$pane" -qv @agent_bead 2>/dev/null || true)"
  fi
  cwd="$(pwd -P 2>/dev/null || pwd)"
  run_id=''
  case "$tool" in
    git)
      case "${1:-}" in
        commit) event='git.commit' ;;
        push) event='git.push' ;;
        merge) event='git.merge' ;;
        *) event='git.command' ;;
      esac
      git_repo_root; repo="$REPLY"; git_current_branch; branch="$REPLY"; git_head_hash; head="$REPLY"
      log_event telemetry.command.started tool=git event="$event" pane="$pane" session="$session" bead="$bead" cwd="$cwd" repo="$repo" branch="$branch" head="$head" argv="$args"
      run_id="$(obs_run_start git "$mode" "$session_id" "$pane" "$bead" "$cwd" "$repo" "$branch" "$head" "$@")"
      set +e
      git "$@"
      rc=$?
      set -e
      git_head_hash; head="$REPLY"; git_current_branch; branch="$REPLY"
      log_event "$event" tool=git exit="$rc" pane="$pane" session="$session" bead="$bead" cwd="$cwd" repo="$repo" branch="$branch" head="$head" argv="$args"
      obs_run_finish "$run_id" "$rc" "$branch" "$head"
      return "$rc"
      ;;
    bd)
      sub="${1:-}"
      case "$sub" in
        create) event='bd.create' ;;
        close) event='bd.close' ;;
        remember) event='bd.remember' ;;
        update)
          if printf '%s
' "$@" | grep -Eq '^--claim$|^--claim='; then event='bd.claim'; else event='bd.update'; fi
          ;;
        *) event='bd.command' ;;
      esac
      log_event telemetry.command.started tool=bd event="$event" pane="$pane" session="$session" bead="$bead" cwd="$cwd" argv="$args"
      run_id="$(obs_run_start bd "$mode" "$session_id" "$pane" "$bead" "$cwd" '' '' '' "$@")"
      set +e
      bd "$@"
      rc=$?
      set -e
      log_event "$event" tool=bd exit="$rc" pane="$pane" session="$session" bead="$bead" cwd="$cwd" argv="$args"
      obs_run_finish "$run_id" "$rc" '' ''
      return "$rc"
      ;;
    gh)
      if [ "${1:-}" = pr ] && [ "${2:-}" = create ]; then
        event='git.pr.create'
      elif [ "${1:-}" = pr ] && [ "${2:-}" = merge ]; then
        event='git.pr.merge'
      else
        event='gh.command'
      fi
      git_repo_root; repo="$REPLY"; git_current_branch; branch="$REPLY"; git_head_hash; head="$REPLY"
      log_event telemetry.command.started tool=gh event="$event" pane="$pane" session="$session" bead="$bead" cwd="$cwd" repo="$repo" branch="$branch" head="$head" argv="$args"
      run_id="$(obs_run_start gh "$mode" "$session_id" "$pane" "$bead" "$cwd" "$repo" "$branch" "$head" "$@")"
      set +e
      gh "$@"
      rc=$?
      set -e
      git_head_hash; head="$REPLY"; git_current_branch; branch="$REPLY"
      log_event "$event" tool=gh exit="$rc" pane="$pane" session="$session" bead="$bead" cwd="$cwd" repo="$repo" branch="$branch" head="$head" argv="$args"
      obs_run_finish "$run_id" "$rc" "$branch" "$head"
      return "$rc"
      ;;
    *) printf 'telemetry: unknown tool: %s\n' "$tool" >&2; return 2 ;;
  esac
}


git_branch_name() {
  local root="${1:-}"
  [ -n "$root" ] || { REPLY=''; return 0; }
  REPLY="$(git -C "$root" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
}

git_dirty_count() {
  local root="${1:-}"
  [ -n "$root" ] || { REPLY=0; return 0; }
  REPLY="$(git -C "$root" status --short 2>/dev/null | wc -l | tr -d ' ' || true)"
  [ -n "$REPLY" ] || REPLY=0
}

idle_label_plain() {
  local activity="${1:-}" now="${2:-}" age mins threshold_mins="${TMUX_PICKER_STALE_MINS:-60}"
  IDLE_STALE=0
  [[ "$activity" =~ ^[0-9]+$ ]] || { REPLY=''; return 0; }
  [[ "$now" =~ ^[0-9]+$ ]] || now="$(date +%s)"
  [[ "$threshold_mins" =~ ^[0-9]+$ ]] || threshold_mins=60
  age=$(( now - activity )); [ "$age" -lt 0 ] && age=0
  mins=$(( age / 60 ))
  [ "$mins" -ge "$threshold_mins" ] && IDLE_STALE=1
  if [ "$age" -lt 60 ]; then REPLY='<1m'
  elif [ "$age" -lt 3600 ]; then REPLY="${mins}m"
  elif [ "$age" -lt 86400 ]; then REPLY="$(( age / 3600 ))h"
  else REPLY="$(( age / 86400 ))d"; fi
}

# `stale` outranks everything: it is the one state that means the tooling has
# lost sight of a lane. A session rollup that let a healthy sibling pane hide a
# stale one would reproduce exactly the blindness of xtmux-dvs.
dashboard_state_rank() {
  case "${1:-}" in
    stale) REPLY=0 ;;
    needs-input) REPLY=1 ;;
    running) REPLY=2 ;;
    done) REPLY=3 ;;
    idle) REPLY=4 ;;
    *) REPLY=5 ;;
  esac
}

dashboard_choose_state() {
  local current="${1:-}" candidate="${2:-}" cr nr
  [ -n "$candidate" ] || { REPLY="$current"; return 0; }
  [ -n "$current" ] || { REPLY="$candidate"; return 0; }
  dashboard_state_rank "$current"; cr="$REPLY"
  dashboard_state_rank "$candidate"; nr="$REPLY"
  if [ "$nr" -lt "$cr" ]; then REPLY="$candidate"; else REPLY="$current"; fi
}

_dashboard_tsv() {
  local mode="${1:-sessions-only}" json_internal="${2:-0}" now sid sname pane_id path activity root repo branch dirty idle idle_ms shared state bead task
  local pane_sid pane_sname pane_cmd pane_path pane_state pane_bead pane_task pane_parent pane_pid pane_root pane_state_norm
  local tmp_panes _sid_list _sid
  case "$mode" in expanded|sessions-only) ;; *) mode='sessions-only' ;; esac
  now="$(date +%s)"
  tmp_panes="$(mktemp)"
  trap 'rm -f "${tmp_panes:-}"' RETURN EXIT INT TERM
  declare -A sess_name=()
  declare -A sess_path=()
  declare -A sess_activity=()
  declare -A sess_root=()
  declare -A sess_state=()
  declare -A sess_bead=()
  declare -A sess_task=()
  declare -A root_sids=()
  declare -A sess_shared=()

  while IFS=$'\t' read -r sid sname pane_id path activity; do
    [ -n "$sid" ] || continue
    path="${path:-$HOME}"
    git_root_for_path "$path"; root="$REPLY"
    sess_name["$sid"]="$sname"
    sess_path["$sid"]="$path"
    sess_activity["$sid"]="${activity:-0}"
    sess_root["$sid"]="$root"
    if [ -n "$root" ]; then
      case " ${root_sids[$root]:-} " in *" $sid "*) ;; *) root_sids[$root]+=" $sid" ;; esac
    fi
  done < <(session_meta)

  while IFS=$'\t' read -r pane_sid pane_sname pane_id pane_cmd pane_path pane_state pane_pid pane_bead pane_task pane_parent pane_transition; do
    [ -n "$pane_sid" ] || continue
    normalize_agent_state "$pane_id" "$pane_state" "$pane_cmd" "$pane_transition"; pane_state_norm="$REPLY"
    dashboard_choose_state "${sess_state[$pane_sid]:-}" "$pane_state_norm"; sess_state["$pane_sid"]="$REPLY"
    agent_meta_value "$pane_bead"; pane_bead="$REPLY"
    agent_meta_value "$pane_task"; pane_task="$REPLY"
    [ -z "${sess_bead[$pane_sid]:-}" ] && [ -n "$pane_bead" ] && sess_bead["$pane_sid"]="$pane_bead"
    [ -z "${sess_task[$pane_sid]:-}" ] && [ -n "$pane_task" ] && sess_task["$pane_sid"]="$pane_task"
    if [ "$mode" = expanded ]; then
      printf 'pane\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$pane_sid" "$(tsv_clean "$pane_sname")" "$pane_id" "${pane_state_norm:-}" "$(tsv_clean "$pane_bead")" "$(tsv_clean "$pane_task")" "$(tsv_clean "$pane_cmd")" "$(tsv_clean "$pane_path")" >> "$tmp_panes"
    fi
  done < <(tmux list-panes -a -F $'#{session_id}\t#{session_name}\t#{pane_id}\t#{pane_current_command}\t#{pane_current_path}\t#{?@agent_state,#{@agent_state},-}\t#{pane_pid}\t#{?@agent_bead,#{@agent_bead},-}\t#{?@agent_task,#{@agent_task},-}\t#{?@agent_parent_session,#{@agent_parent_session},-}\t#{?@agent_last_transition,#{@agent_last_transition},-}' 2>/dev/null || true)

  for root in "${!root_sids[@]}"; do
    _sid_list="${root_sids[$root]}"; set -- $_sid_list
    if [ "$#" -gt 1 ]; then for _sid in "$@"; do sess_shared["$_sid"]=1; done; fi
  done

  printf 'dashboard\tmode\t%s\n' "$mode"
  for sid in "${!sess_name[@]}"; do
    sname="${sess_name[$sid]}"; path="${sess_path[$sid]:-$HOME}"; root="${sess_root[$sid]:-}"
    repo="${root##*/}"; [ -n "$root" ] || repo=''
    git_branch_name "$root"; branch="$REPLY"
    git_dirty_count "$root"; dirty="$REPLY"
    idle_label_plain "${sess_activity[$sid]:-}" "$now"; idle="$REPLY"
    if [[ "${sess_activity[$sid]:-}" =~ ^[0-9]+$ ]]; then idle_ms="$(( (now - sess_activity[$sid]) * 1000 ))"; [ "$idle_ms" -lt 0 ] && idle_ms=0; else idle_ms=0; fi
    state="${sess_state[$sid]:-}"
    bead="${sess_bead[$sid]:-}"
    if [ -z "$bead" ]; then derive_bead_id "$sname" "$path" "$root"; bead="$REPLY"; fi
    task="${sess_task[$sid]:-}"
    shared="${sess_shared[$sid]:-0}"
    printf 'session\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s' \
      "$sid" "$(tsv_clean "$sname")" "${state:-}" "$(tsv_clean "$bead")" "$(tsv_clean "$task")" "$(tsv_clean "$repo")" "$(tsv_clean "$branch")" "$dirty" "$shared" "$idle" "$(tsv_clean "$path")"
    [ "$json_internal" = 1 ] && printf '\t%s' "$idle_ms"
    printf '\n'
    if [ "$mode" = expanded ]; then
      awk -F '\t' -v s="$sid" '$1=="pane" && $2==s {print}' "$tmp_panes"
    fi
  done | sort -t $'\t' -k1,1 -k2,2
}

dashboard() {
  local mode='sessions-only' json=0 arg out line type first sid name state bead task repo branch dirty shared idle path idle_ms
  local pane_id command session_count=0 pane_count=0 started_ms="$(date +%s%3N)"
  for arg in "$@"; do
    case "$arg" in expanded|sessions-only) mode="$arg" ;; --json) json=1 ;; *) return 2 ;; esac
  done
  if [ "$json" != 1 ]; then _dashboard_tsv "$mode"; return; fi
  out="$(_dashboard_tsv "$mode" 1)"
  printf '{"mode":"%s","sessions":[' "$mode"
  first=1
  while IFS= read -r line; do
    type="$(audit_tsv_field "$line" 1)"; [ "$type" = session ] || continue
    session_count=$(( session_count + 1 ))
    sid="$(audit_tsv_field "$line" 2)"; name="$(audit_tsv_field "$line" 3)"; state="$(audit_tsv_field "$line" 4)"
    bead="$(audit_tsv_field "$line" 5)"; task="$(audit_tsv_field "$line" 6)"; repo="$(audit_tsv_field "$line" 7)"
    branch="$(audit_tsv_field "$line" 8)"; dirty="$(audit_tsv_field "$line" 9)"; shared="$(audit_tsv_field "$line" 10)"
    idle="$(audit_tsv_field "$line" 11)"; path="$(audit_tsv_field "$line" 12)"; idle_ms="$(audit_tsv_field "$line" 13)"
    [ "$first" = 1 ] || printf ','; first=0
    printf '{"sessionId":"%s","sessionName":"%s","state":%s,"beadId":%s,"task":%s,"repo":%s,"branch":%s,"dirtyCount":%s,"sharedWorktree":%s,"idleMs":%s,"path":"%s"}' \
      "$(json_escape "$sid")" "$(json_escape "$name")" "$(json_nullable "$state")" "$(json_nullable "$bead")" "$(json_nullable "$task")" \
      "$(json_nullable "$repo")" "$(json_nullable "$branch")" "${dirty:-0}" "$([ "${shared:-0}" = 1 ] && printf true || printf false)" "${idle_ms:-0}" "$(json_escape "$path")"
  done <<< "$out"
  printf '],"panes":['
  first=1
  while IFS= read -r line; do
    type="$(audit_tsv_field "$line" 1)"; [ "$type" = pane ] || continue
    pane_count=$(( pane_count + 1 ))
    sid="$(audit_tsv_field "$line" 2)"; name="$(audit_tsv_field "$line" 3)"; pane_id="$(audit_tsv_field "$line" 4)"
    state="$(audit_tsv_field "$line" 5)"; bead="$(audit_tsv_field "$line" 6)"; task="$(audit_tsv_field "$line" 7)"
    command="$(audit_tsv_field "$line" 8)"; path="$(audit_tsv_field "$line" 9)"
    [ "$first" = 1 ] || printf ','; first=0
    printf '{"sessionId":"%s","sessionName":"%s","paneId":"%s","state":%s,"beadId":%s,"task":%s,"command":%s,"path":"%s"}' \
      "$(json_escape "$sid")" "$(json_escape "$name")" "$(json_escape "$pane_id")" "$(json_nullable "$state")" "$(json_nullable "$bead")" \
      "$(json_nullable "$task")" "$(json_nullable "$command")" "$(json_escape "$path")"
  done <<< "$out"
  printf ']}\n'
  log_cli_emit query.completed command=dashboard session_count="$session_count" pane_count="$pane_count" duration_ms="$(( $(date +%s%3N) - started_ms ))" outcome=ok
}

topology_json() {
  local json=0 arg rows row sid sname created activity attached wid windex wname wactive
  local pane_id pindex pactive width height left top pid command path instance state bead task prompt parent transition role worktree branch parent_pane
  local key session_first window_first pane_first agent
  for arg in "$@"; do
    case "$arg" in
      --json) json=1 ;;
      *) command_error "$json" XTMUX_INVALID_ARGUMENT "topology: unknown arg: $arg" topology 2; return $? ;;
    esac
  done
  [ "$json" = 1 ] || { printf 'usage: topology --json\n' >&2; return 2; }

  local picker_source host_id_source
  picker_source="$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
  host_id_source="$(cd -- "$(dirname -- "$picker_source")/../scripts" && pwd)/xtmux-host-id.sh"
  source "$host_id_source"
  unset host_id_source picker_source

  host_id
  local host_id="$REPLY" generated_at_ms="$(date +%s%3N)"
  # One list-panes pass supplies every session, window and pane field. Do not
  # add display-message/show-options calls here: Console needs one coherent
  # snapshot, not independently sampled hierarchy levels.
  rows="$(tmux list-panes -a -F $'#{session_id}\t#{session_name}\t#{session_created}\t#{session_activity}\t#{session_attached}\t#{window_id}\t#{window_index}\t#{window_name}\t#{window_active}\t#{pane_id}\t#{pane_index}\t#{pane_active}\t#{pane_width}\t#{pane_height}\t#{pane_left}\t#{pane_top}\t#{pane_pid}\t#{pane_current_command}\t#{pane_current_path}\t#{?@agent_instance_id,#{@agent_instance_id},-}\t#{?@agent_state,#{@agent_state},-}\t#{?@agent_bead,#{@agent_bead},-}\t#{?@agent_task,#{@agent_task},-}\t#{?@agent_prompt_file,#{@agent_prompt_file},-}\t#{?@agent_parent_session,#{@agent_parent_session},-}\t#{?@agent_last_transition,#{@agent_last_transition},-}\t#{?@agent_role,#{@agent_role},-}\t#{?@agent_worktree,#{@agent_worktree},-}\t#{?@agent_branch,#{@agent_branch},-}\t#{?@agent_parent_pane,#{@agent_parent_pane},-}' 2>/dev/null || true)"

  local -a sessions=() pane_rows=()
  declare -A session_seen=() session_name=() session_created=() session_activity=() session_attached=()
  declare -A session_windows=() window_seen=() window_index=() window_name=() window_active=()
  while IFS=$'\t' read -r sid sname created activity attached wid windex wname wactive pane_id pindex pactive width height left top pid command path instance state bead task prompt parent transition role worktree branch parent_pane; do
    [ -n "$sid" ] || continue
    sname="$(tsv_clean "$sname")"
    created="$(tsv_clean "$created")"; activity="$(tsv_clean "$activity")"; attached="$(tsv_clean "$attached")"
    windex="$(tsv_clean "$windex")"; wname="$(tsv_clean "$wname")"; wactive="$(tsv_clean "$wactive")"
    pindex="$(tsv_clean "$pindex")"; pactive="$(tsv_clean "$pactive")"; width="$(tsv_clean "$width")"
    height="$(tsv_clean "$height")"; left="$(tsv_clean "$left")"; top="$(tsv_clean "$top")"; pid="$(tsv_clean "$pid")"
    command="$(tsv_clean "$command")"; path="$(tsv_clean "$path")"
    instance="$(tsv_clean "$instance")"; state="$(tsv_clean "$state")"; bead="$(tsv_clean "$bead")"
    task="$(tsv_clean "$task")"; prompt="$(tsv_clean "$prompt")"; parent="$(tsv_clean "$parent")"
    transition="$(tsv_clean "$transition")"
    role="$(tsv_clean "$role")"; worktree="$(tsv_clean "$worktree")"
    branch="$(tsv_clean "$branch")"; parent_pane="$(tsv_clean "$parent_pane")"
    if [ -z "${session_seen[$sid]:-}" ]; then
      session_seen["$sid"]=1; sessions+=("$sid")
      session_name["$sid"]="$sname"; session_created["$sid"]="$created"
      session_activity["$sid"]="$activity"; session_attached["$sid"]="$attached"
    fi
    key="$sid|$wid"
    if [ -z "${window_seen[$key]:-}" ]; then
      window_seen["$key"]=1; session_windows["$sid"]+="${session_windows[$sid]:+ }$wid"
      window_index["$key"]="$windex"; window_name["$key"]="$wname"; window_active["$key"]="$wactive"
    fi
    pane_rows+=("$sid"$'\t'"$wid"$'\t'"$pane_id"$'\t'"$pindex"$'\t'"$pactive"$'\t'"$width"$'\t'"$height"$'\t'"$left"$'\t'"$top"$'\t'"$pid"$'\t'"$command"$'\t'"$path"$'\t'"$instance"$'\t'"$state"$'\t'"$bead"$'\t'"$task"$'\t'"$prompt"$'\t'"$parent"$'\t'"$transition"$'\t'"$role"$'\t'"$worktree"$'\t'"$branch"$'\t'"$parent_pane")
  done <<< "$rows"

  printf '{"schema_version":"xtrm.xtmux.topology.v1","generated_at_ms":%s,"host":{"host_id":"%s"},"sessions":[' \
    "$(topology_number "$generated_at_ms")" "$(json_escape "$host_id")"
  session_first=1
  for sid in "${sessions[@]}"; do
    [ "$session_first" = 1 ] || printf ','; session_first=0
    printf '{"session_id":"%s","name":"%s","created_at_ms":%s,"activity_at_ms":%s,"attached":%s,"active":%s,"windows":[' \
      "$(json_escape "$sid")" "$(json_escape "${session_name[$sid]}")" \
      "$(topology_milliseconds "${session_created[$sid]}")" "$(topology_milliseconds "${session_activity[$sid]}")" \
      "$(topology_boolean "${session_attached[$sid]}")" "$(topology_boolean "${session_attached[$sid]}")"
    window_first=1
    read -ra _topology_windows <<< "${session_windows[$sid]:-}"
    for wid in "${_topology_windows[@]}"; do
      key="$sid|$wid"
      [ "$window_first" = 1 ] || printf ','; window_first=0
      printf '{"window_id":"%s","window_index":%s,"name":"%s","active":%s,"panes":[' \
        "$(json_escape "$wid")" "$(topology_number "${window_index[$key]}")" "$(json_escape "${window_name[$key]}")" "$(topology_boolean "${window_active[$key]}")"
      pane_first=1
      for row in "${pane_rows[@]}"; do
        IFS=$'\t' read -r row_sid row_wid pane_id pindex pactive width height left top pid command path instance state bead task prompt parent transition role worktree branch parent_pane <<< "$row"
        [ "$row_sid" = "$sid" ] && [ "$row_wid" = "$wid" ] || continue
        [ "$pane_first" = 1 ] || printf ','; pane_first=0
        printf '{"pane_id":"%s","pane_index":%s,"active":%s,"width":%s,"height":%s,"left":%s,"top":%s,"pid":%s,"current_command":"%s","current_path":"%s"' \
          "$(json_escape "$pane_id")" "$(topology_number "$pindex")" "$(topology_boolean "$pactive")" \
          "$(topology_number "$width")" "$(topology_number "$height")" "$(topology_number "$left")" "$(topology_number "$top")" \
          "$(topology_number "$pid")" "$(json_escape "$command")" "$(json_escape "$path")"
        agent="$(topology_agent_json "$instance" "$state" "$bead" "$task" "$prompt" "$parent" "$transition" "$role" "$worktree" "$branch" "$parent_pane")"
        [ -n "$agent" ] && printf ',"agent":{%s}' "$agent"
        printf '}'
      done
      printf ']}'
    done
    printf ']}'
  done
  printf ']}\n'
}

audit_tsv_field() {
  local line="$1" n="$2"
  awk -F '\t' -v n="$n" '{print $n}' <<< "$line"
}

mux_help() {
  cat <<'EOF'
multiplexing-safe delegation

communication contract
  1. beads first: durable task contract (`bd show <id>`)
  2. /tmp prompt-file second: ephemeral constraints/meta-protocol
  3. send-keys third: single-line pointer only

never send while working
  wait-agent <pane> [--wait-for-transition] --timeout 30m --interval 30s
  monitor-agent <pane> [--wait-for-transition] --timeout 30m --interval 30s
  monitor-list --json / monitor-kill <id>

safe handoff
  handoff --target <pane> --bead <id> --note 'NO push'   [--prompt-file X --wait-ready 2m --monitor]
  safe-send-pointer [--reply-to <messageKey>] <pane> 'leggi /tmp/file.txt e seguilo'
  add --yes only after inspecting the printed command

message replies
  message-reply --in-reply-to <messageKey> --text <text> [--message-key K] [--json]
  message-cancel --message-key <messageKey> [--json]
  message-ack means receipt, not reply

inventory / dashboard
  dashboard sessions-only    compact orchestrator TSV
  dashboard expanded         pane-level detail
  audit                      read-only hygiene report
  worktree-collisions        shared checkout warnings

picker keys
  Tab      toggle nesting (expanded / sessions-only)
  Space    mark row for Alt-X bulk kill
  Ctrl-f   filters: repo / branch / cmd:agent / grep
  Ctrl-r   refresh active filter/mode
  Alt-i    interrupt pane micro-action
  Ctrl-Y   approve/waiting-agent micro-action
  Ctrl-O   one-line message micro-action
  ?        show this cheatsheet

cleanup rule of thumb
  cleanup rows are candidates; warning rows need operator judgment.
  dirty, shared, or working sessions are not safe to kill blindly.
EOF
}

# The command reference. Two rules when editing this:
#   1. Every command in the top-level dispatch must appear here, and nothing that
#      is not a command may appear as one. test/contract.sh fails otherwise.
#   2. The `json output:` field lists must match what the commands actually emit.
#      contract.sh compares them against live --json output, not against a doc —
#      a wrong INPUT flag fails loudly (exit 2), but a wrong OUTPUT field name
#      returns null silently, which is how `id`/`text` got guessed for messages.
# Full JSON contract (envelope, ordering, error codes): docs/json-command-api.md.
help_text() {
  cat <<'EOF'
xtmux — tmux session/pane picker and agent-orchestration CLI

usage:  xtmux <command> [args]
        xtmux help              this reference
        xtmux mux-help          delegation safety protocol (beads > /tmp > send-keys)

`tmux-session-picker` is the same program under its legacy name; every command
below works under either. <angled> args are REQUIRED, [bracketed] are optional.
[json] marks commands that accept --json and print machine-readable output.

MESSAGES — short status/escalation between panes.
Durable task content belongs in beads (`bd`), not here.
  message-send   --to <target> --text <text> [--from <id>] [--bead <id>]
                 [--to-pane <%id>] [--from-pane <%id>] [--message-key <key>]
                 [--expects-reply[=true|false]] [--reply-to <messageKey>] [json]
                 --bead implies --expects-reply=true; opt out explicitly.
  message-list   [--for <target>] [--pane <%id>] [--from <id>] [--message-key <key>]
                 [--unacked] [--expects-reply] [--limit <n>] [--since <dur>] [json]
                 --expects-reply adds correlated reply fields; --for is REQUIRED
                 outside tmux, else it defaults to the live session.
  message-get   <messageKey|messageId> [json]   read one message; never acks it
  message-reply  --in-reply-to <messageKey> --text <text> [--message-key <key>] [json]
  message-cancel --message-key <messageKey> [json]
  message-ack    <message-id> [--by <target>] [json] (receipt, not reply)
  message-status <message-key> [--json] (add --json for correlated reply state)
  unread-count   [--for <recipient>] [--pane <%id>] [json]  --for defaults to live tmux.
  obligations list [--pane <%id>] [json]   active reply obligations owned by this live pane.
  json output:
    message        messageKey, senderId, senderPaneId, senderKind, recipientId,
                   targetPaneId, recipientKind, beadId, summary, createdAtMs,
                   expectsReply, acked, ackedAtMs, ackedBy
    message-send   messageKey, messageId, duplicate, senderId, senderPaneId,
                   senderKind, recipientId, recipientKind, targetPaneId, beadId,
                   expectsReply, createdAtMs
    message-ack    messageKey, acked, ackedAtMs, ackedBy, status
    message-reply  messageKey, messageId, duplicate, replyToMessageKey,
                   fulfilledMessageKey, fulfilled, senderId, senderPaneId,
                   recipientId, targetPaneId, createdAtMs
    message-cancel messageKey, cancelled, cancelledAtMs
    message-list   correlated opt-in adds replyStatus, fulfilledAtMs,
                   fulfilledByMessageKey, correlatedReply
    message-status --json adds replyStatus, fulfilledAtMs,
                   fulfilledByMessageKey, correlatedReply
    unread-count   recipientId, unreadCount, oldestUnackedAtMs
    obligations    messageKey, messageId, senderId, senderPaneId, recipientId,
                   targetPaneId, summary, createdAtMs, acked, ackedAtMs, replyStatus

    TRAP: the message body is `summary` and its id is `messageKey`. There is
    no `text` field and no `id` field — reading those yields null.

  A target is a session id ($1732), a pane id (%2635), or a session name. Quote
    Pane/session ids in shells: '$1732' unquoted expands to nothing and acts under the WRONG identity.

MONITORS — never prompt a pane that is working; wait for it instead.
  wait-agent    <target> [--wait-for-transition] [--consume] [--timeout <dur>]
                [--interval <dur>] [json]        blocks until the pane leaves
                                                 working/running/busy/thinking (--consume claims its wake once)
  monitor-agent <target> [--wait-for-transition] [--timeout <dur>]
                [--interval <dur>] [json]        same, but registered + background
  monitor-list  [json]                             monitors [--all] [json] pretty view
  monitor-kill  <id> [json]                        monitor-run <internal>: do not call

  json output:
    wait-agent    waitId, target, requesterSessionId, requesterPaneId,
                  targetSessionId, targetPaneId, state, monitorId,
                  terminalStatus, wakeDelivered, wakeConsumed, replayed,
                  startedAtMs, completedAtMs, timeoutMs, intervalMs
    monitor-agent monitorId, waitId, target, requesterSessionId, requesterPaneId,
                  sessionId, paneId, state, paneState, startedAtMs, timeoutMs,
                  intervalMs, terminalStatus, wakeDelivered
    monitor-list  monitorId, waitId, target, requesterSessionId, requesterPaneId,
                  sessionId, paneId, state (terminal-overlaid), paneState,
                  startedAtMs, updatedAtMs, timeoutMs, intervalMs,
                  terminalStatus, terminalAtMs, wakeDelivered, wakeConsumed, orphan
    monitor-kill  monitorId, status

DELEGATION — hand work to another pane without fragmenting its prompt.
  handoff          --target <target> --bead <id> [--note <text>] [--file <path>]
                   [--yes] [json]   writes the /tmp prompt file, keeps the bead as
                                    the contract, prints the exact send command
  handoff          --target <t> --prompt-file <path> [--wait-ready <dur>] [--monitor]
                   [--handoff-key <k>] [--yes] [json]   durable, readiness-aware
                                    path over an existing file; send-keys success
                                    is an ATTEMPT, never acceptance
  safe-send-pointer [--yes] [--double-enter|--no-double-enter]
                   [--force-freeform] [--reply-to <messageKey>]
                   <target> <slash-command | /tmp pointer> [json]
                   --reply-to fulfils only after successful tmux injection; injection failure never fulfils.
                   Refuses working targets, multiline payloads and $(...); dry-runs
                   unless --yes; adds the second Enter Claude panes eat (pi/Codex do not).

  json output:
    handoff        target, paneId, beadId, promptFile, handoffKey, monitorId, sent,
                   durable, createdAtMs

IDENTITY & LAST TURN — who a pane is, and what it last said.
  context --current [--json]   the runtime origin of the INVOKING pane, as
                               xtrm.runtime-origin.v1. Read-only; outside tmux, or
                               unverifiable, exits non-zero — never a guessed binding.
  agent-last <pane-id|session-id> [--json]   full text of the target's most recent agent turn (pi+claude); plain falls back to summary; exit 5 XTMUX_NOT_FOUND.  agent-episode <pane-id|session-id> [--json]  latest response episode: primary + follow-ups, acks collapsed.
  instance-get <instance-id> [--json]        one durable agent occupation by id; plain output is field<TAB>value so a hook can read one field without a JSON parser; exit 5 XTMUX_NOT_FOUND.

  json output:
    context        schema_version, kind, host_id, tmux_session_id/window_id/
                   pane_id (stable $N/@N/%N ids, never names or indexes),
                   agent_instance_id?, bead_id?, parent_session_id?,
                   captured_at_ms, capture_source, verified
    agent-last/agent-episode  turnId, ..., completedAt (OMITTED when absent); episode:
                   episodeId, openedAtMs, closedAtMs, primary, followUps[], collapsed[]

SESSIONS & DASHBOARD — inventory for orchestrators.
  dashboard [sessions-only|expanded] [json]   agent-readable inventory
  topology --json                            complete host/session/window/pane snapshot
  list [all|waiting|running|repo:<x>|branch:<x>|cmd:<x>|grep:<x>]   list-active  same list under the active filter

NAVIGATION — operator traversal over sessions and attention targets.
  nav [next|prev|attention-next|attention-prev|back|help]
                   `nav` opens the navigator; next/prev follow tmux session order,
                   attention-* cycle the attention ordering, back returns.

  json output:
    dashboard      mode, sessions, panes
                   sessions/panes rows: sessionId, sessionName, paneId, state,
                   beadId, task, repo, branch, dirtyCount, sharedWorktree,
                   idleMs, path
    topology       schema_version, generated_at_ms, host, sessions
                   host: host_id
                   session: session_id, name, created_at_ms, activity_at_ms,
                   attached, active, windows
                   window: window_id, window_index, name, active, panes
                   pane: pane_id, pane_index, active, width, height, left, top,
                   pid, current_command, current_path, agent?
                   agent: instance_id, state, bead_id, task, prompt_file,
                   parent_session_id, last_transition, role, worktree, branch, parent_pane_id
                   topology uses stable $/@/% ids, omits absent agent metadata,
                   and never includes pane content.

PANE CONTENT — bounded, on-demand terminal preview.
  pane capture --pane <%id> [--lines N] [--json]
                   the last N lines of one pane, ANSI escapes intact

  json output:
    pane capture   schema_version, pane_id, captured_at_ms, requested_lines,
                   returned_lines, max_lines, truncated, content

    --lines above max_lines is CLAMPED, never silently honored. truncated means
    only "there is more above what you were given"; never journalled.

REMOTE — read-only observation of another host, over your own ssh.
  bridge --stdio   NDJSON request/response on stdin/stdout, meant to be run as
                   `ssh <host> xtmux bridge --stdio`: OpenSSH owns transport and
                   auth; this stores no keys and listens on no socket.

    methods:       bridge.hello, bridge.cancel, topology.snapshot, journal.query,
                   journal.follow, pane.capture, health.get
    read-only:     anything that would MUTATE is refused (XTMUX_BRIDGE_READ_ONLY),
                   and anything not on that list is refused too. Frames are
                   size-capped; malformed input is answered and the stream keeps serving.

OBSERVABILITY — the local event log and command telemetry (see also the standalone `xtmux-events` live tail).
  log emit  <type> [key=value ...]
  log tail  [n]
  log query [--type <t>] [--session <s>] [--pane <%id>] [--bead <id>]
            [--since <dur>] [--limit <n>] [--after-id <n>] [json]
  log follow --after-id <n> [--interval <ms>] [--once] [json]
            NDJSON stream of committed journal items — same envelope as the
            log query page items, not a second schema. SIGINT/SIGTERM exit 0.
  telemetry <git|bd|gh> -- <args ...>          run a command and record it

  json output:
    log query      createdAtMs, type, domain, eventKey, sessionId, paneId,
                   beadId, correlationId, plus type-specific detail keys

    --after-id <n> cursor-paged envelope (xtrm.xtmux.journal-page.v1): journal_id
                   per item, plus next_after_id / oldest_available_id /
                   latest_available_id / has_more. Cursor = committed SQLite
                   journal id; EXCLUSIVE, ascending; never page by timestamp; a
                   cursor older than retained history returns XTMUX_CURSOR_EXPIRED
                   (oldest_available_id re-anchors the next page).

HYGIENE — end-of-session cleanup.
  audit                [json]   read-only report: `warning` rows need judgment,
                                `cleanup` rows are safe candidates
  worktree-collisions  [json]   sessions sharing one git checkout
  clear-cache                   drop the picker's git cache
  install-hooks [picker-path]   tmux cache-invalidation hooks

  json output:
    audit                severity, kind, sessionId, sessionName, paneId,
                         paneIndex, path, repo, detail
    worktree-collisions  path, sessionCount, paneCount, sessionNames

PICKER INTERNALS — invoked by the fzf UI. Agents do not normally call these.
  preview, popup, jump, kill, act, attn-jump, jump-back, kill-confirm, bulk-kill, bulk-kill-targets
  bulk-kill-confirm, rename, rename-apply, mode-toggle, filter-menu, filter-clear, filter-preset, prompt-label, border-label, nav-go, nav-act
  nav-border-label, nav-key-help, list-nav, list-nav-single, list-active-nav,
  list-active-nav-single, list-active-nav-chain, list-active-nav-single-chain

Errors are `exit 2` with a usage line; under --json they are
{"code":"XTMUX_...","message":...}. See docs/json-command-api.md.
EOF
}

audit_json() {
  local input="$1" line severity kind sid name pane path repo state cmd dirty first=1 field
  printf '['
  while IFS= read -r line; do
    IFS=$'\t' read -r severity kind sid name field _ <<< "$line"
    case "$severity" in warning|cleanup) ;; *) continue ;; esac
    pane=''; path=''; repo=''; state=''; cmd=''; dirty=''
    IFS=$'\t' read -ra _audit_fields <<< "$line"
    for field in "${_audit_fields[@]:4}"; do
      case "$field" in %*) pane="$field" ;; path=*) path="${field#path=}" ;; repo=*) repo="${field#repo=}" ;; state=*) state="${field#state=}" ;; cmd=*) cmd="${field#cmd=}" ;; dirty=*) dirty="${field#dirty=}" ;; *) [ "$kind" = missing-path ] && [ -z "$path" ] && path="$field" ;; esac
    done
    [ "$first" = 1 ] || printf ','; first=0
    printf '{"severity":"%s","kind":"%s","sessionId":%s,"sessionName":"%s","paneId":%s,"paneIndex":null,"path":%s,"repo":%s,"detail":{' \
      "$severity" "$(json_escape "$kind")" "$(json_nullable "$sid")" "$(json_escape "$name")" "$(json_nullable "$pane")" "$(json_nullable "$path")" "$(json_nullable "$repo")"
    local detail_first=1
    if [ -n "$state" ]; then printf '"state":"%s"' "$(json_escape "$state")"; detail_first=0; fi
    if [ -n "$cmd" ]; then [ "$detail_first" = 1 ] || printf ','; printf '"command":"%s"' "$(json_escape "$cmd")"; detail_first=0; fi
    if [ -n "$dirty" ]; then [ "$detail_first" = 1 ] || printf ','; printf '"dirtyCount":%s' "$dirty"; fi
    printf '}}'
  done <<< "$input"
  printf ']\n'
}

# audit_walk emits V1's human TSV. audit() wraps it so persistence is purely
# additive: stdout is whatever the walk printed, byte for byte (PRD §20), and a
# copy is piped to the runtime (xtmux-3xs.8).
audit() {
  local mode out display_out rc session stable=0 json=0 arg finding_count=0 started_ms="$(date +%s%3N)"
  while [ "$#" -gt 0 ]; do
    arg="$1"; shift
    case "$arg" in
      --stable) stable=1 ;;
      --json) json=1 ;;
      *) command_error "$json" XTMUX_INVALID_ARGUMENT "audit: unknown arg: $arg" audit 2; return $? ;;
    esac
  done
  obs_v2_mode; mode="$REPLY"
  if [ "$mode" = 'off' ] || ! obs_available; then
    audit_walk
    return "$?"
  fi
  out="$(audit_walk)"; rc=$?
  display_out="$out"
  if [ "$stable" = 1 ] && [[ "$out" == *$'\n'* ]]; then
    local header="${out%%$'\n'*}" body="${out#*$'\n'}"
    display_out="$header"$'\n'"$(printf '%s\n' "$body" | sort -t $'\t' -k1,1 -k2,2 -k4,4 -k5,5)"
  fi
  if [ "$json" = 1 ]; then
    audit_json "$display_out"
    finding_count="$(printf '%s\n' "$display_out" | grep -Ec $'^(warning|cleanup)\t' || true)"
    log_cli_emit query.completed command=audit count="$finding_count" duration_ms="$(( $(date +%s%3N) - started_ms ))" outcome="$([ "$rc" -eq 0 ] && printf ok || printf error)"
  elif [ -n "$display_out" ]; then printf '%s\n' "$display_out"; fi
  current_tmux_session_id; session="$REPLY"
  # A walk that failed halfway is a PARTIAL run: it records what it saw but must
  # never resolve findings it simply never reached. Omit unknown optional
  # identity so SQLite stores NULL rather than an empty sentinel.
  local ingest_args=(audit ingest)
  [ -n "$session" ] && ingest_args+=(--session "$session")
  [ "$rc" -eq 0 ] || ingest_args+=(--partial)
  printf '%s\n' "$out" | obs_call "${ingest_args[@]}"
  # Shadow diff for audit is a follow-up: audit_walk reads live tmux state
  # which drifts between two walks, so a live V1-vs-V2 comparison would
  # produce racy false positives. xtmux-3xs.17's --stable makes ORDER
  # comparable; a stable input-fixture harness would make CONTENT comparable.
  return "$rc"
}

audit_walk() {
  local line type sid name state bead task repo branch dirty shared idle path pane cmd
  current_tmux_session; log_event audit.run session="${REPLY:-unknown}"
  dashboard expanded | while IFS= read -r line; do
    [ -n "$line" ] || continue
    type="$(audit_tsv_field "$line" 1)"
    case "$type" in
      dashboard) printf 'audit\tread-only\twarnings-and-cleanup-candidates\n' ;;
      session)
        sid="$(audit_tsv_field "$line" 2)"
        name="$(audit_tsv_field "$line" 3)"
        state="$(audit_tsv_field "$line" 4)"
        bead="$(audit_tsv_field "$line" 5)"
        task="$(audit_tsv_field "$line" 6)"
        repo="$(audit_tsv_field "$line" 7)"
        branch="$(audit_tsv_field "$line" 8)"
        dirty="$(audit_tsv_field "$line" 9)"
        shared="$(audit_tsv_field "$line" 10)"
        idle="$(audit_tsv_field "$line" 11)"
        path="$(audit_tsv_field "$line" 12)"
        [ -n "$sid" ] || continue
        if [ -n "$path" ] && [ ! -d "$path" ]; then
          printf 'cleanup\tmissing-path\t%s\t%s\t%s\n' "$sid" "$(tsv_clean "$name")" "$(tsv_clean "$path")"
        fi
        if [[ "$name" == sp-* ]] && { [ "$state" = done ] || [ -z "$state" ]; }; then
          printf 'cleanup\tstale-specialist\t%s\t%s\tstate=%s\n' "$sid" "$(tsv_clean "$name")" "$(tsv_clean "$state")"
        fi
        if [ "${dirty:-0}" -gt 0 ] 2>/dev/null; then
          printf 'warning\tdirty-worktree\t%s\t%s\tdirty=%s\trepo=%s\tpath=%s\n' "$sid" "$(tsv_clean "$name")" "$dirty" "$(tsv_clean "$repo")" "$(tsv_clean "$path")"
        fi
        if [ "${shared:-0}" = 1 ]; then
          printf 'warning\tshared-worktree\t%s\t%s\trepo=%s\tpath=%s\n' "$sid" "$(tsv_clean "$name")" "$(tsv_clean "$repo")" "$(tsv_clean "$path")"
        fi
        if agent_state_is_working "$state"; then
          printf 'warning\tworking-do-not-kill\t%s\t%s\tstate=%s\n' "$sid" "$(tsv_clean "$name")" "$state"
        fi
        case "$name" in
          tmp-*|test-*|*-tmp|*-test|*' '*) printf 'warning\tnaming-convention\t%s\t%s\n' "$sid" "$(tsv_clean "$name")" ;;
        esac
        ;;
      pane)
        sid="$(audit_tsv_field "$line" 2)"
        name="$(audit_tsv_field "$line" 3)"
        pane="$(audit_tsv_field "$line" 4)"
        state="$(audit_tsv_field "$line" 5)"
        bead="$(audit_tsv_field "$line" 6)"
        task="$(audit_tsv_field "$line" 7)"
        cmd="$(audit_tsv_field "$line" 8)"
        path="$(audit_tsv_field "$line" 9)"
        if [ -n "$state" ] && [ -z "$bead" ]; then
          printf 'warning\tagent-pane-without-bead\t%s\t%s\t%s\tstate=%s\tcmd=%s\n' "$sid" "$(tsv_clean "$name")" "$(tsv_clean "$pane")" "$state" "$(tsv_clean "$cmd")"
        fi
        ;;
    esac
  done
}

render_pane_line() {
  local window_index="$1"
  local window_name="$2"
  local pane_id="$3"
  local pane_active="$4"
  local pane_cmd="$5"
  local pane_path="$6"
  local root="$7"
  local state="${8:-}"
  local session_name="${9:-}"
  local pane_pid="${10:-}"
  local meta_bead="${11:-}"
  local meta_task="${12:-}"
  local meta_parent="${13:-}"
  local marker cmd badge loc out sp_badge_str role_str meta_label

  marker=' '
  [ "$pane_active" = '1' ] && marker='*'
  cmd="${pane_cmd:-shell}"
  state_badge "$state"; badge="$REPLY"
  pane_location_hint "$pane_path" "$root"; loc="$REPLY"

  # specialist awareness (xtmux-rib.4): fast list path uses session name + live
  # pane pid only. bead/job details are resolved in preview to keep list warm fast.
  sp_is_specialist "$session_name" "$pane_pid"; sp_role="$REPLY"
  sp_bead=''; sp_state=''; sp_stale='' 

  paint "$c_pane" "    ↳ $marker $window_index:$window_name $pane_id"; out="$REPLY"
  if [ -n "$sp_role" ]; then
    sp_badge; sp_badge_str="$REPLY"
    out+=" $sp_badge_str"
    # show real state badges for specialists too (e.g. [wait] in the waiting
    # filter). do not show the synthetic [done] used only to rank stale cleanup.
    if [ -n "$badge" ] && ! { [ "${sp_stale:-0}" = 1 ] && [ -z "$sp_state" ] && [ "$state" = 'done' ]; }; then
      out+=" $badge"
    fi
    paint "$c_sp" "$sp_role"; role_str="$REPLY"
    [ -n "$sp_bead" ] && role_str+=" $c_dim· $sp_bead$c_reset"
    out+=" $role_str"
  else
    [ -n "$badge" ] && out+=" $badge"
    paint "$c_dim" "$cmd"; out+=" $REPLY"
  fi
  agent_meta_label "$meta_bead" "$meta_task" "$meta_parent"; meta_label="$REPLY"
  [ -n "$meta_label" ] && out+="$meta_label"
  [ -n "$loc" ] && out+="  $loc"
  REPLY="$out"
}

# ── richer filters: ctrl-f submenu + spec language (xtmux-rib.11) ────────────
# one active filter at a time, carried in a state file so the ctrl-f submenu
# can hand the chosen spec to the main fzf's reload. ctrl-a/w/e reset the slot
# (they stay pure attention filters); ctrl-f sets a content filter.
picker_state_dir() {
  local dir="${TMPDIR:-/tmp}/tmux-picker-state-${UID:-$(id -u)}"
  REPLY=''
  [ ! -L "$dir" ] || return 1
  if [ ! -e "$dir" ]; then
    (umask 077; mkdir -p "$dir") 2>/dev/null || return 1
    chmod 700 "$dir" 2>/dev/null || return 1
  fi
  [ -d "$dir" ] && [ -O "$dir" ] || return 1
  REPLY="$dir"
}

picker_state_file() {
  local name="$1" dir file
  picker_state_dir || { REPLY=''; return 1; }; dir="$REPLY"; file="$dir/$name"
  if [ -e "$file" ] || [ -L "$file" ]; then
    [ -f "$file" ] && [ ! -L "$file" ] && [ -O "$file" ] \
      || { REPLY=''; return 1; }
  fi
  REPLY="$file"
}

picker_state_read() {
  local file
  picker_state_file "$1" || { REPLY=''; return 1; }; file="$REPLY"
  # A missing state file is the normal cold-start case: return empty instead
  # of letting $(<missing) raise a redirection error, which exits the script
  # under `set -e` even when the caller guards with `|| true`.
  [ -f "$file" ] || { REPLY=''; return 1; }
  REPLY="$(<"$file")"
}

picker_state_write() {
  local name="$1" value="${2:-}" file dir tmp
  picker_state_file "$name" || return 1; file="$REPLY"; dir="${file%/*}"
  tmp="$(mktemp "$dir/.${name}.XXXXXX")" || return 1
  if printf '%s' "$value" > "$tmp" && mv -f -- "$tmp" "$file"; then return 0; fi
  rm -f -- "$tmp"; return 1
}

filter_state_file() { picker_state_file filter; }
list_mode_file() { picker_state_file list-mode; }

read_list_mode() {
  picker_state_read list-mode || true
  case "$REPLY" in sessions-only) ;; *) REPLY='expanded' ;; esac
}

write_list_mode() {
  picker_state_write list-mode "${1:-expanded}"
}

toggle_list_mode() {
  read_list_mode
  case "$REPLY" in
    sessions-only) write_list_mode 'expanded' ;;
    *) write_list_mode 'sessions-only' ;;
  esac
}

# ── nav record + renderer helpers (xtmux-rib.23/.27) ───────────────────
# NAV-1 record: type<TAB>sid<TAB>name<TAB>target<TAB>token<TAB>display<NUL>.
# Field 6 is presentation-only and may contain anything (spaces, newlines,
# shell metacharacters); only the first five fields are machine identity.
#
# nav_row_fields <row> -> REPLY='type\tsid\ttarget\ttoken'. The display
# text is never parsed. A NUL-delimited read (`read -r -d ''`) returns 1 at
# EOF with no NUL; the parser tolerates that so the CLI does not abort
# mid-row under set -euo pipefail.
nav_row_fields() {
  local row="$1" type sid target token
  IFS=$'\t' read -r -d '' type sid _ target token _ <<< "$row" || true
  REPLY="$type"$'\t'"$sid"$'\t'"$target"$'\t'"$token"
}

# display_fallback <text> -> REPLY: newlines collapsed to one line. Used when
# the installed fzf cannot safely render multi-line records.
display_fallback() {
  REPLY="${1//$'\n'/ }"
}

# fit_width <text> <width> -> REPLY: unchanged when it fits, otherwise
# truncated to exactly <width> characters ending in a single ellipsis.
# Character-safe: bash substring indexing counts characters, so a multi-byte
# UTF-8 char is never split.
fit_width() {
  local text="$1" width="$2"
  if [ "$width" -le 0 ]; then
    REPLY=''
  elif [ "${#text}" -le "$width" ]; then
    REPLY="$text"
  else
    REPLY="${text:0:$((width - 1))}…"
  fi
}

# nav_wrap_text <text> <width> -> REPLY: newline-joined lines, each <= width.
# Greedy word wrap; words longer than width are hard-split (bash substring is
# character-safe). Every character of <text> is preserved, none is cut.
nav_wrap_text() {
  local text="$1" width="$2" line='' word out=''
  local -a words=() lines=()
  if [ "$width" -le 0 ]; then REPLY="$text"; return 0; fi
  # Fast path: text already fits and needs no splitting.
  if [ "${#text}" -le "$width" ] && [[ "$text" != *$'\n'* ]]; then REPLY="$text"; return 0; fi
  read -r -a words <<< "$text"
  for word in "${words[@]}"; do
    while [ "${#word}" -gt "$width" ]; do
      [ -n "$line" ] && { lines+=("$line"); line=''; }
      lines+=("${word:0:$width}")
      word="${word:$width}"
    done
    if [ -z "$line" ]; then line="$word"
    elif [ $(( ${#line} + 1 + ${#word} )) -le "$width" ]; then line+=" $word"
    else lines+=("$line"); line="$word"; fi
  done
  [ -n "$line" ] && lines+=("$line")
  [ "${#lines[@]}" -eq 0 ] && { REPLY=''; return 0; }
  printf -v out '%s
' "${lines[@]}"
  REPLY="${out%$'
'}"
}

# nav_wrap_styled <text> <width> <role> <indent> -> REPLY: wrapped, then styled
# per line with the indent prepended. Styling stays after all width math.
nav_wrap_styled() {
  local text="$1" width="$2" role="$3" indent="$4" line out=''
  nav_wrap_text "$text" "$width"
  if [[ "$REPLY" != *$'
'* ]]; then
    nav_style "$role" "$REPLY"
    REPLY="$indent$REPLY"
    return 0
  fi
  while IFS= read -r line; do
    nav_style "$role" "$line"
    out+="${out:+$'
'}$indent$REPLY"
  done <<< "$REPLY"
  REPLY="$out"
}

# current_marker <row-id> <current-id> -> REPLY='▶' when the row IS the
# current session/pane, else a single space (keeps columns aligned).
current_marker() {
  if [ "$1" = "$2" ]; then REPLY='▶'; else REPLY=' '; fi
}

# _fzf_multiline_probe_run <fzf-bin> -> on|off|classic
# Runs in command substitution, so its EXIT trap cannot affect caller traps.
# Machine-field action safety is verified FIRST (single {5}, multi {+5},
# reload-sync+track-current {5}) against single-line records; any failure is
# `classic` because a token architecture that cannot be proven must not be
# used. Only then is multi-line display integrity checked: `on` when two NUL
# records with newline displays stay distinct and round-trip, `off` when they
# do not (bounded one-line nav keeps the same proven token architecture).
_fzf_multiline_probe_run() {
  local bin="$1" work capture records expected runner actual rc
  command -v timeout >/dev/null 2>&1 || { printf 'classic\n'; return; }
  work="$(mktemp -d "${TMPDIR:-/tmp}/xtmux-fzf-probe.XXXXXX" 2>/dev/null)" || { printf 'classic\n'; return; }
  trap "rm -rf -- '$work'" EXIT INT TERM
  capture="$work/capture"
  records="$work/records"
  cat > "$capture" <<'CAPEOF'
#!/bin/sh
printf '%s\0' "$@" > "$CAPTURE"
CAPEOF
  chmod +x "$capture"
  # Machine-field records use single-line displays so token resolution is
  # tested independently of multi-line rendering.
  printf 'pane\t$42\talpha\t%%17\tp:$42:%%17\tline one\0session\t$43\tbeta\t$43\ts:$43\tsecond\0' > "$records"

  # Single highlight: {5} must resolve the hidden action token and {} must be
  # the complete machine record, never a parsed display fragment.
  runner="$work/single"
  cat > "$runner" <<EOF
#!/bin/sh
exec env -u FZF_DEFAULT_OPTS -u FZF_DEFAULT_OPTS_FILE -u FZF_DEFAULT_COMMAND \
  '$bin' --read0 --sync --no-sort --delimiter='$(printf '\t')' --with-nth=6 \
  --bind='load:become($capture {5} {})' < '$records'
EOF
  chmod +x "$runner"
  actual="$work/single.actual"
  CAPTURE="$actual" timeout --foreground --kill-after=1s 3s script -qfec "$runner" /dev/null >/dev/null 2>&1 || { printf 'classic\n'; return; }
  expected="$work/single.expected"
  printf 'p:$42:%%17\0pane\t$42\talpha\t%%17\tp:$42:%%17\tline one\0' > "$expected"
  cmp -s "$actual" "$expected" || { printf 'classic\n'; return; }

  # Multi-select must pass only field-5 machine tokens as separate arguments.
  runner="$work/multi"
  cat > "$runner" <<EOF
#!/bin/sh
exec env -u FZF_DEFAULT_OPTS -u FZF_DEFAULT_OPTS_FILE -u FZF_DEFAULT_COMMAND \
  '$bin' --read0 --sync --no-sort --multi --delimiter='$(printf '\t')' --with-nth=6 \
  --bind='load:select-all+become($capture {+5})' < '$records'
EOF
  chmod +x "$runner"
  actual="$work/multi.actual"
  CAPTURE="$actual" timeout --foreground --kill-after=1s 3s script -qfec "$runner" /dev/null >/dev/null 2>&1 || { printf 'classic\n'; return; }
  expected="$work/multi.expected"
  printf 'p:$42:%%17\0s:$43\0' > "$expected"
  cmp -s "$actual" "$expected" || { printf 'classic\n'; return; }

  # The exact reload/track/execute-silent actions used by nav must resolve the token.
  runner="$work/reload"
  cat > "$runner" <<EOF
#!/bin/sh
exec env -u FZF_DEFAULT_OPTS -u FZF_DEFAULT_OPTS_FILE -u FZF_DEFAULT_COMMAND \
  '$bin' --read0 --sync --track --delimiter='$(printf '\t')' --with-nth=6 \
  --bind='load:reload-sync(cat $records)+track-current+execute-silent($capture {5})+abort' < '$records'
EOF
  chmod +x "$runner"
  actual="$work/reload.actual"
  set +e
  CAPTURE="$actual" timeout --foreground --kill-after=1s 3s script -qfec "$runner" /dev/null >/dev/null 2>&1
  rc=$?
  set -e
  [ "$rc" -eq 130 ] || { printf 'classic\n'; return; }
  expected="$work/reload.expected"
  printf 'p:$42:%%17\0' > "$expected"
  cmp -s "$actual" "$expected" || { printf 'classic\n'; return; }

  # Multi-line integrity: two NUL records whose displays contain newlines must
  # remain exactly two selectable records with intact field-5 tokens, and the
  # complete record must round-trip through {} byte-for-byte.
  records="$work/multi-records"
  printf 'pane\t$42\talpha\t%%17\tp:$42:%%17\tline one\nline two\0session\t$43\tbeta\t$43\ts:$43\tsecond\0' > "$records"
  runner="$work/multiline"
  cat > "$runner" <<EOF
#!/bin/sh
exec env -u FZF_DEFAULT_OPTS -u FZF_DEFAULT_OPTS_FILE -u FZF_DEFAULT_COMMAND \
  '$bin' --read0 --sync --no-sort --multi --delimiter='$(printf '\t')' --with-nth=6 \
  --bind='load:select-all+become($capture {+5})' < '$records'
EOF
  chmod +x "$runner"
  actual="$work/multiline.actual"
  CAPTURE="$actual" timeout --foreground --kill-after=1s 3s script -qfec "$runner" /dev/null >/dev/null 2>&1 || { printf 'off\n'; return; }
  expected="$work/multiline.expected"
  printf 'p:$42:%%17\0s:$43\0' > "$expected"
  cmp -s "$actual" "$expected" || { printf 'off\n'; return; }
  runner="$work/multiline-full"
  cat > "$runner" <<EOF
#!/bin/sh
exec env -u FZF_DEFAULT_OPTS -u FZF_DEFAULT_OPTS_FILE -u FZF_DEFAULT_COMMAND \
  '$bin' --read0 --sync --no-sort --delimiter='$(printf '\t')' --with-nth=6 \
  --bind='load:become($capture {5} {})' < '$records'
EOF
  chmod +x "$runner"
  actual="$work/multiline-full.actual"
  CAPTURE="$actual" timeout --foreground --kill-after=1s 3s script -qfec "$runner" /dev/null >/dev/null 2>&1 || { printf 'off\n'; return; }
  expected="$work/multiline-full.expected"
  printf 'p:$42:%%17\0pane\t$42\talpha\t%%17\tp:$42:%%17\tline one\nline two\0' > "$expected"
  cmp -s "$actual" "$expected" || { printf 'off\n'; return; }
  printf 'on\n'
}

# fzf_multiline_probe -> REPLY=on|off|classic. on = NUL multi-line nav is
# proven; off = machine-field actions are proven but multi-line display is not
# (bounded one-line nav); classic = machine-field action safety cannot be
# proven, so nav must route to the classic launcher. Cached by fzf path+version
# in UI state (not the lifecycle-cleared git cache); the probe itself never
# runs fzf's search engine (--filter) — it verifies explicit action payloads.
fzf_multiline_probe() {
  REPLY='classic'
  command -v fzf >/dev/null 2>&1 || return 0
  command -v script >/dev/null 2>&1 || return 0
  command -v cmp >/dev/null 2>&1 || return 0
  command -v timeout >/dev/null 2>&1 || return 0
  local bin ver identity key cache cached_key cached_value verdict cache_ok=0
  bin="$(command -v fzf)"
  ver="$(fzf --version 2>/dev/null | head -1)"
  identity="$(stat -Lc '%d:%i:%s:%Y' "$bin" 2>/dev/null || printf unknown)"
  key="probe-v2 $bin $ver $identity"
  if picker_state_file fzf-multiline; then cache="$REPLY"; cache_ok=1; else cache=''; fi
  if [ "$cache_ok" = 1 ] && [ "${TMUX_PICKER_NO_CACHE:-0}" != '1' ] && [ -f "$cache" ]; then
    { IFS= read -r cached_key || true; IFS= read -r cached_value || true; } < "$cache"
    if [ "$cached_key" = "$key" ]; then
      case "$cached_value" in on|off|classic) REPLY="$cached_value"; return 0 ;; esac
    fi
  fi
  verdict="$(_fzf_multiline_probe_run "$bin")"
  case "$verdict" in on|off|classic) REPLY="$verdict" ;; *) REPLY='classic' ;; esac
  if [ "$cache_ok" = 1 ] && [ "${TMUX_PICKER_NO_CACHE:-0}" != '1' ]; then
    picker_state_write fzf-multiline "$(printf '%s\n%s\n' "$key" "$REPLY")" || true
  fi
}

# ── NAV-2/5: bounded hierarchy cards + launcher routing ─────────────────
# Cards are built from the SAME inventory build_list already collected: no new
# git/tmux/process queries. Free-text fields are sanitized at tmux emission, so
# the only newline a display can contain is the structural card break below.

# nav_card_width -> REPLY: bounded card width. XTMUX_NAV_WIDTH pins it for
# tests (32/44/60); otherwise the invoking client's columns (52 default).
# Hard-capped at NAV_MAX_CARD_WIDTH so a hostile XTMUX_NAV_WIDTH can never
# widen a record beyond the byte budget (§19/§32).
nav_card_width() {
  local w="${XTMUX_NAV_WIDTH:-${COLUMNS:-52}}"
  case "$w" in ''|*[!0-9]*) w=52 ;; esac
  [ "$w" -gt 0 ] || w=52
  [ "$w" -gt "$NAV_MAX_CARD_WIDTH" ] && w=$NAV_MAX_CARD_WIDTH
  REPLY="$w"
}

# ── NAV-T4: bounded-record budgets (prompt §19/§32, epic xtmux-w5i) ───────
# Per-type VISUAL line budgets are explicit and authoritative; the default nav
# list never exceeds them. Overflow content is truncated with an ellipsis and
# remains available behind details (^/ preview), never stored unbounded in an
# fzf record.
#   session record: ≤ NAV_SESSION_LINES visual lines
#   window record:  ≤ NAV_WINDOW_LINES visual lines
#   pane record:    ≤ NAV_PANE_LINES visual lines
# The record byte bound is guaranteed BY CONSTRUCTION (every free-text input
# and every display line is capped below, so the widest possible record —
# 160-char name + 3×120-char lines of 4-byte UTF-8 — still lands well under
# NAV_MAX_RECORD_BYTES) and defended by a cheap char guard at emission.
readonly NAV_SESSION_LINES=3
readonly NAV_WINDOW_LINES=2
readonly NAV_PANE_LINES=1
readonly NAV_MAX_RECORD_BYTES=4096
readonly NAV_MAX_RECORD_CHARS=2048
readonly NAV_MAX_NAME_CHARS=160      # record field-3 (presentation name) cap
readonly NAV_MAX_LOC_CHARS=80        # bounded location-projection cap (§3/§31)
readonly NAV_MAX_CARD_WIDTH=120      # hard cap on any drawer width

# nav_line_budget <record-type> -> REPLY = the §19 visual line budget.
nav_line_budget() {
  case "$1" in
    session) REPLY=$NAV_SESSION_LINES ;;
    window)  REPLY=$NAV_WINDOW_LINES ;;
    pane)    REPLY=$NAV_PANE_LINES ;;
    *)       REPLY=1 ;;
  esac
}

# nav_bounded_name <text> -> REPLY: cap a record field-3 presentation name.
# Machine identity never comes from this field, so hard-cutting is safe. The
# display cards make their own (finer) truncation.
nav_bounded_name() {
  local text="${1:-}"
  [ "${#text}" -le "$NAV_MAX_NAME_CHARS" ] || text="${text:0:$NAV_MAX_NAME_CHARS}"
  REPLY="$text"
}

# nav_bounded_rel <rel-path> -> REPLY: bounded relative path. Shallow paths
# stay intact; deep middles elide to the trailing two components and the whole
# is hard-fitted to the location cap (a single hostile component cannot grow
# the record, §32).
nav_bounded_rel() {
  local rel="${1:-}" parts n out
  [ -n "$rel" ] || { REPLY=''; return 0; }
  IFS='/' read -r -a parts <<< "$rel"
  n=${#parts[@]}
  if [ "$n" -le 2 ]; then out="$rel"; else out="…/${parts[$((n-2))]}/${parts[$((n-1))]}"; fi
  fit_width "$out" "$NAV_MAX_LOC_CHARS"
}

# nav_bounded_norepo <abs-path> -> REPLY: §3/§31 no-repo projection. Never a
# full absolute path: ~-relative under $HOME, otherwise the trailing ≤2
# components with an eliding prefix; always fitted to the location cap.
nav_bounded_norepo() {
  local p="${1:-}" rel parts n out=''
  p="${p:-$HOME}"
  if [[ "$p" == "$HOME"* ]]; then
    rel="${p#"$HOME"}"; rel="${rel#/}"
    if [ -z "$rel" ]; then out='~'
    else
      IFS='/' read -r -a parts <<< "$rel"; n=${#parts[@]}
      if [ "$n" -le 2 ]; then out="~/$rel"; else out="~/…/${parts[$((n-2))]}/${parts[$((n-1))]}"; fi
    fi
  else
    IFS='/' read -r -a parts <<< "$p"; n=${#parts[@]}
    if [ "$n" -le 2 ]; then out="$p"; else out="…/${parts[$((n-2))]}/${parts[$((n-1))]}"; fi
  fi
  fit_width "$out" "$NAV_MAX_LOC_CHARS"
}

# nav_pane_location <pane_path> <git_root> -> REPLY: bounded paneLocation
# projection (§3/§17/§31), the inline repo/path shown on the pane row (PART VII).
#   path == root        -> canonical repo label
#   path inside root    -> filesystem repo/path, middle elided to …/
#   worktree pane       -> parent-repo label / bounded worktree-relative path
#                          (never a long .xtrm/worktrees/… wall)
#   no repo             -> shortened user-relative path (never full absolute)
# Reuses the already-collected pane cwd, the existing path→git-root cache, and
# the canonical worktree/root grouping: zero git subprocesses, zero filesystem
# traversal on the hot path. Full absolute path is details-only (§18).
nav_pane_location() {
  local pane_path="${1:-}" root="${2:-}" group repo rel
  pane_path="${pane_path:-$HOME}"
  if [ -n "$root" ]; then
    group_root_for_path "$pane_path" "$root"; group="$REPLY"
    repo="${group##*/}"
    [ -n "$repo" ] || repo="${root##*/}"
    if [ "$pane_path" = "$root" ]; then REPLY="$repo"; return 0; fi
    rel="${pane_path#"$root"/}"
    if [ "$rel" != "$pane_path" ] && [ -n "$rel" ]; then
      nav_bounded_rel "$rel"; rel="$REPLY"
      # filesystem-style repo/path projection (§3/§17 PART VII): the repo
      # prefix and the useful trailing components survive; deep middles elide
      # to …/ (nav_bounded_rel already collapses to the last two components).
      REPLY="$repo/$rel"
      fit_width "$REPLY" "$NAV_MAX_LOC_CHARS"
    else
      REPLY="$repo"
    fi
    return 0
  fi
  nav_bounded_norepo "$pane_path"
}

# nav_lines_cap <text> <max-lines> <width> -> REPLY: at most <max-lines>
# newline-joined lines; when the wrapped text exceeds the budget, the last
# retained line is refitted to <width>-1 and gains a terminal ellipsis. This
# is the §19 overflow policy: truncate, never grow the record.
nav_lines_cap() {
  local text="${1:-}" max="${2:-1}" width="${3:-0}" line out='' count=0 last
  local -a _lc=()
  [ "$max" -lt 1 ] && max=1
  [ "$width" -lt 1 ] && width=1
  while IFS= read -r line; do _lc+=("$line"); done <<< "$text"
  count=${#_lc[@]}
  if [ "$count" -le "$max" ]; then REPLY="$text"; return 0; fi
  local i
  last="${_lc[$((max-1))]}"
  fit_width "$last" $((width - 1)); last="$REPLY"
  case "$last" in *…*) ;; *) last+='…' ;; esac
  if [ "$max" -eq 1 ]; then REPLY="$last"; return 0; fi
  out="${_lc[0]}"
  for ((i=1; i<max-1; i++)); do out+=$'\n'"${_lc[$i]}"; done
  REPLY="$out"$'\n'"$last"
}

# nav_enforce_bounded <record> -> REPLY ≤ NAV_MAX_RECORD_CHARS: defense-in-
# depth emission guard. The input/display caps make this unreachable for real
# data; it exists so an unforeseen pathological input can never grow a record
# past the bound (§19). Machine fields 1..5 are preserved verbatim (identity
# safety), only the display tail (field 6) is refitted.
nav_enforce_bounded() {
  local rec="${1:-}" rest f prefix='' i keep
  if [ "${#rec}" -le "$NAV_MAX_RECORD_CHARS" ]; then REPLY="$rec"; return 0; fi
  rest="$rec"
  for ((i=0; i<5; i++)); do
    f="${rest%%$'\t'*}"
    prefix+="$f"
    [ "$i" -lt 4 ] && prefix+=$'\t'
    rest="${rest#*$'\t'}"
  done
  keep=$(( NAV_MAX_RECORD_CHARS - ${#prefix} - 1 ))
  [ "$keep" -lt 0 ] && keep=0
  fit_width "$rest" "$keep"
  REPLY="$prefix"$'\t'"$REPLY"
}


# nav_text_clean removes control bytes that could alter record framing or ANSI
# presentation. Structural newlines are added only by the card renderers.
nav_text_clean() {
  local text="${1:-}"
  while [[ "$text" == *[[:cntrl:]]* ]]; do text="${text/[[:cntrl:]]/ }"; done
  REPLY="$text"
}

# nav_window_label <index> <name> -> REPLY=presentation "index:name" label,
# control-clean and bounded to the card width. Presentation only: the machine
# identity of a window row is its @N target, which never derives from this
# label (§30 — hostile characters in a window name/index cannot affect it).
nav_window_label() {
  local index="${1:-}" name="${2:-}" label
  nav_text_clean "$name"; name="$REPLY"
  label="${index}${name:+:$name}"
  nav_card_width
  fit_width "$label" "$REPLY"
}

# nav_state_tag <normalized-state> -> REPLY=plain badge text ('' if none).
nav_state_tag() {
  case "$1" in
    stale) REPLY='stale' ;;
    needs-input) REPLY='wait' ;;
    done) REPLY='done' ;;
    running) REPLY='run' ;;
    idle) REPLY='idle' ;;
    *) REPLY='' ;;
  esac
}

# attn_state_name <rank> -> REPLY=stale|needs-input|done|running|idle
attn_state_name() {
  case "$1" in
    0) REPLY='stale' ;;
    1) REPLY='needs-input' ;;
    2) REPLY='done' ;;
    3) REPLY='running' ;;
    *) REPLY='idle' ;;
  esac
}

# nav_branch_label <branch> -> REPLY. Humanize common branch naming syntax and
# cap it before the complete context line is fitted to the drawer width.
nav_branch_label() {
  local branch="${1:-}"
  branch="${branch#refs/heads/}"
  case "$branch" in
    feature/*|feat/*|fix/*|bugfix/*|hotfix/*|chore/*|docs/*|refactor/*|test/*|release/*|xt/*) branch="${branch#*/}" ;;
  esac
  branch="${branch//\// }"; branch="${branch//_/ }"; branch="${branch//-/ }"
  while [[ "$branch" == *'  '* ]]; do branch="${branch//  / }"; done
  REPLY="$branch"
}

# nav_session_context <group-root> <root-status> <age> <shared-wt> -> REPLY
# The default row keeps only repo, concise branch, terse flags, and shared state.
nav_session_context() {
  local root="${1:-}" root_status="${2:-}" shared="${4:-}"
  local repo branch flags rest out=''
  if [ -n "$root" ]; then
    repo="${root##*/}"
    branch_from_root_status "$root_status"; branch="$REPLY"
    nav_branch_label "$branch"; branch="$REPLY"
    rest="${root_status#* }"; rest="${rest#* }"; rest="${rest#* }"
    flags=''
    case "$rest" in *'  '*) flags="${rest%%  *}" ;; esac
    out="$repo"
    [ -n "$branch" ] && out+=" · $branch"
    [ -n "$flags" ] && out+=" · $flags"
  fi
  if [ "$shared" = 1 ]; then
    [ -n "$out" ] && out+=" · "
    out+='shared'
  fi
  REPLY="$out"
}

# nav_pane_context <bead> <task> <pane-path> <root> -> REPLY
# Prefer the human task, then the bead id. Paths are details-only.
nav_pane_context() {
  local bead="${1:-}" task="${2:-}"
  agent_meta_value "$bead"; bead="$REPLY"
  agent_meta_value "$task"; task="$REPLY"
  if [[ "$task" == session:* ]]; then
    nav_branch_label "${task#session:}"; task="$REPLY"
  fi
  REPLY="${task:-$bead}"
}

nav_state_label() {
  case "$1" in
    stale) REPLY='stale' ;;
    needs-input|wait) REPLY='wait' ;;
    running|run) REPLY='run' ;;
    done) REPLY='done' ;;
    idle) REPLY='idle' ;;
    *) REPLY='' ;;
  esac
}

# nav_style <role> <text> -> REPLY. Truecolor is presentation-only and is
# applied after width calculation so ANSI bytes never affect truncation.
# SEMANTIC PALETTE (PART VIII): one PRIMARY neutral off-white, one MUTED
# medium gray, one desaturated cool ACCENT (current/focus/pointer), one
# desaturated ATTENTION amber (urgent/wait/stale/needs-input), and a
# restrained DANGER red reserved for hard failure only. Lifecycle states
# run/done/idle are NEUTRAL, never green/blue/rainbow. No bold anywhere.
nav_style() {
  local role="$1" text="${2:-}" code
  case "$role" in
    # PRIMARY — neutral off-white: identity and important names
    session) code='38;2;232;234;237' ;;
    window-id) code='38;2;232;234;237' ;;
    pane-id) code='38;2;232;234;237' ;;
    primary) code='38;2;232;234;237' ;;
    # MUTED — medium gray: task, path, age, group labels, separators, secondary
    # runtime, non-current/non-attention lifecycle state
    runtime) code='38;2;122;128;134' ;;
    context|task) code='38;2;122;128;134' ;;
    section) code='38;2;122;128;134' ;;
    age) code='38;2;122;128;134' ;;
    idle) code='38;2;122;128;134' ;;      # neutral, not grey-poisoned, just muted
    running|run) code='38;2;122;128;134' ;; # NEUTRAL — never green
    done) code='38;2;122;128;134' ;;       # NEUTRAL — never blue
    active) code='38;2;122;128;134' ;;    # muted parent group
    other) code='38;2;122;128;134' ;;     # muted parent group
    muted) code='38;2;122;128;134' ;;
    # ACCENT — one desaturated cool steel-blue: current row emphasis
    current) code='38;2;104;168;196' ;;
    accent) code='38;2;104;168;196' ;;
    # ATTENTION — one desaturated amber: urgent / wait / needs-input / stale
    stale) code='38;2;205;165;95' ;;
    needs-input|wait) code='38;2;205;165;95' ;;
    urgent) code='38;2;205;165;95' ;;
    attention) code='38;2;205;165;95' ;;
    # DANGER — restrained red: hard failure / unreachable / destructive only
    danger) code='38;2;196;92;92' ;;
    *) REPLY="$text"; return 0 ;;
  esac
  REPLY=$'\033['"$code"'m'"$text"$'\033[0m'
}

# nav_group_label <normalized-state> -> REPLY=urgent|active|other.
# PROMPT 14 (option B, documented): the visual group is a relevance bucket,
# NOT a claim of full attention membership. stale+needs-input = `urgent` (the
# waiting preset, rank ≤1); `attention-next` traverses the BROADER canonical
# cycle set (rank ≤2, stale+needs-input+done). The label was renamed away from
# `attn` so it cannot overclaim; done/idle sessions sit in `other` yet remain
# attention-cycle targets. The hierarchy aggregation stays the one
# nav_state_max order; only the visible label changed.
nav_group_label() {
  case "$1" in
    stale|needs-input|wait) REPLY='urgent' ;;
    running|run) REPLY='active' ;;
    *) REPLY='other' ;;
  esac
}

# nav_window_card <marker> <window-id> <label> <state> <count> <lines>
# [<current>] -> REPLY (§15): compact independently-selectable window row
#   `↳ @17  0:coord  run · 2`
# The ancestry glyph is ALWAYS `↳` (uniform, invariant to sibling position). The
# current window is distinguished by ACCENT styling on the `↳` and @id, never by
# replacing the glyph (§ PART V/VIII). @window-id is machine identity and is
# NEVER truncated (§15 priority 1); index:name truncates; state = aggregate;
# count = pane count. ≤ NAV_WINDOW_LINES lines.
nav_window_card() {
  local marker="${1:- }" wid="${2:-}" label="$3" state="$4" count="$5" lines="${6:-multi}" current="${7:-0}"
  local w sep suffix label_budget out id_styled label_styled state_styled count_styled marker_styled
  nav_card_width; w="$REPLY"
  nav_state_label "$state"; state="$REPLY"
  nav_text_clean "$label"; label="$REPLY"
  sep='  '
  [ "$w" -lt 32 ] && sep=' '
  suffix="$state"
  [ -n "$count" ] && suffix="${suffix:+$suffix }· $count"
  label_budget=$(( w - ${#marker} - 1 - ${#wid} - ${#sep} - ${#suffix} - ${#sep} ))
  [ "$label_budget" -lt 0 ] && label_budget=0
  fit_width "$label" "$label_budget"; label="$REPLY"
  if [ "$current" = 1 ]; then
    nav_style current "$marker"; marker_styled="$REPLY"
    nav_style current "$wid"; id_styled="$REPLY"
  else
    nav_style section "$marker"; marker_styled="$REPLY"
    nav_style window-id "$wid"; id_styled="$REPLY"
  fi
  nav_style session "$label"; label_styled="$REPLY"
  nav_style "$state" "$state"; state_styled="$REPLY"
  nav_style age "$count"; count_styled="$REPLY"
  out="$marker_styled $id_styled$sep$label_styled$sep$state_styled"
  [ -n "$count" ] && out+=" · $count_styled"
  REPLY="$out"
}

# nav_session_card <marker> <name> <state> <age> <context> <lines>
# Every session carries its compact group label, so fuzzy filtering cannot remove
# the only heading for retained rows. Pane rows retain the precise state label.
# §19: ≤3 visual lines — name up to 2 wrapped lines, context exactly 1 fitted
# line; overflow is ellipsized, never wrapped past the budget.
nav_session_card() {
  local marker="${1:- }" name="$2" state="$3" age="$4" context="$5" lines="${6:-multi}" w
  local label group exact suffix prefix name_budget head body marker_styled name_styled age_styled state_styled context_styled
  nav_text_clean "$name"; name="$REPLY"
  nav_text_clean "$age"; age="$REPLY"
  nav_text_clean "$context"; context="$REPLY"
  nav_group_label "$state"; group="$REPLY"
  nav_state_label "$state"; exact="$REPLY"
  nav_card_width; w="$REPLY"
  if [ "$w" -lt 32 ]; then
    case "$group" in urgent) group='w' ;; active) group='r' ;; *) group='o' ;; esac
    label="$group${exact:+/$exact}"
  else
    label="$group${exact:+ $exact}"
  fi
  suffix=''
  [ -n "$age" ] && suffix="$age"
  [ -n "$label" ] && suffix+="${suffix:+  }$label"
  prefix="$marker "
  name_budget=$(( w - ${#prefix} - ${#suffix} - 2 ))
  [ "$name_budget" -lt 1 ] && name_budget=1

  if [ "$lines" = single ]; then
    fit_width "$name" "$name_budget"; name="$REPLY"
    head="$prefix$name${suffix:+  $suffix}"
    local rest=$(( w - ${#head} - 3 ))
    if [ -n "$context" ] && [ "$rest" -ge 4 ]; then
      fit_width "$context" "$rest"; context="$REPLY"
      head+=" · $context"
    fi
    fit_width "$head" "$w"; REPLY="$REPLY"
    return 0
  fi

  # Multi: wrap instead of cut, but bounded to the §19 name budget (≤2 of the
  # 3 session lines; context takes the third as one fitted line).
  nav_wrap_text "$name" "$name_budget"; local _wname="$REPLY"
  local _maxlines=1
  nav_line_budget session; _maxlines="$REPLY"
  nav_lines_cap "$_wname" $((_maxlines - 1)) "$name_budget"; name="$REPLY"
  local -a _name_lines=()
  if [[ "$name" == *$'\n'* ]]; then
    while IFS= read -r _nl; do _name_lines+=("$_nl"); done <<< "$name"
  else
    _name_lines=("$name")
  fi
  local _first="${_name_lines[0]}"
  nav_style current "$marker"; marker_styled="$REPLY"
  nav_style session "$_first"; name_styled="$REPLY"
  nav_style age "$age"; age_styled="$REPLY"
  nav_style "$state" "$label"; state_styled="$REPLY"
  head="$marker_styled $name_styled"
  [ -n "$age" ] && head+="  $age_styled"
  [ -n "$age" ] && [ -n "$label" ] && head+='  '
  [ -n "$label" ] && head+="$state_styled"
  local _i
  for _i in "${_name_lines[@]:1}"; do
    [ -n "$_i" ] || continue
    nav_style session "$_i"; head+=$'\n'"  $REPLY"
  done

  body="$head"
  if [ -n "$context" ]; then
    # context is exactly one bounded line (§19 line 3); it never wraps past it
    fit_width "$context" $(( w - 4 )); context="$REPLY"
    nav_style context "$context"; body+=$'\n'"    $REPLY"
  fi
  REPLY="$body"
  return 0
}

# nav_pane_card <branch> <pane-id> <runtime> <state> <task> <session-state>
# <lines> [<location>] [<current>]
# §3/§16/§19/§20 (PART V/VI): EVERY pane renders on exactly ONE visual line,
# for both the multiline-capable expanded path and the single-line fallback
# (NAV_PANE_LINES=1). There is no second location line — the bounded
# repo/path location rides inline. Row order and width priority:
#   %pane-id > runtime > exact state > location > task
# Task yields first, then location; %pane-id, runtime and exact state are never
# given up. The ancestry glyph is ALWAYS `↳`; the current pane is distinguished
# by ACCENT styling on the `↳` and %pane-id, never by replacing the glyph.
nav_pane_card() {
  local branch="${1:-}" pane="${2:-}" runtime="$3" state="$4" task="$5" session_state="$6" lines="${7:-multi}" location="${8:-}" current="${9:-0}" w label group grole
  local indent runtime_sep sep suffix bare state_on used fixed loc_budget task_budget loc_len _loc_reserve
  local branch_styled pane_styled runtime_styled task_styled group_styled state_styled loc_styled
  nav_text_clean "$runtime"; runtime="$REPLY"
  nav_text_clean "$task"; task="$REPLY"
  nav_text_clean "$location"; location="$REPLY"
  nav_state_label "$state"; label="$REPLY"
  nav_group_label "$session_state"; group="$REPLY"
  nav_card_width; w="$REPLY"
  indent='    '; runtime_sep='  '; sep='  '
  if [ "$w" -lt 32 ]; then indent=''; runtime_sep=' '; sep=' '; fi
  fixed=$(( ${#indent} + ${#branch} + 1 + ${#pane} + ${#runtime_sep} ))
  # runtime budget reserves the minimal parent-group suffix so %id+runtime
  # always fit first (§16); runtime shrinks before exact state is dropped.
  runtime_budget=$(( w - fixed - ${#sep} - 1 ))
  [ "$runtime_budget" -lt 0 ] && runtime_budget=0
  fit_width "$runtime" "$runtime_budget"; runtime="$REPLY"
  used=$(( fixed + ${#runtime} ))
  # parent group: full word when it fits, else its letter; always muted except
  # the urgent bucket (amber). Emphasise exact state, not the grouping.
  case "$group" in urgent) grole='urgent' ;; *) grole='section' ;; esac
  bare="$sep$group"
  [ $(( used + ${#bare} )) -gt "$w" ] && { bare="$sep${group:0:1}"; grole='section'; }
  suffix="$bare"
  state_on=0
  if [ -n "$label" ] && [ $(( used + ${#suffix} + 2 + ${#label} )) -le "$w" ]; then
    suffix+="  $label"; state_on=1
  fi
  # location rides inline before task; yields before task only ever squeezes
  # task — never a continuation line, never id/runtime/state.
  loc_len=0
  if [ -n "$location" ]; then
    loc_budget=$(( w - used - ${#suffix} - 1 ))
    [ "$loc_budget" -gt 24 ] && loc_budget=24
    [ "$loc_budget" -lt 1 ] && loc_budget=0
    fit_width "$location" "$loc_budget"; location="$REPLY"
    loc_len=${#location}
  fi
  # reserve the inline location width (loc + leading space) only when it rendered
  _loc_reserve=0
  [ "$loc_len" -gt 0 ] && _loc_reserve=$(( loc_len + 1 ))
  task_budget=$(( w - used - ${#suffix} - _loc_reserve - 2 ))
  [ "$task_budget" -lt 3 ] && task_budget=0
  fit_width "$task" "$task_budget"; task="$REPLY"
  if [ "$current" = 1 ]; then
    nav_style current "$branch"; branch_styled="$REPLY"
    nav_style current "$pane"; pane_styled="$REPLY"
  else
    nav_style section "$branch"; branch_styled="$REPLY"
    nav_style pane-id "$pane"; pane_styled="$REPLY"
  fi
  nav_style runtime "$runtime"; runtime_styled="$REPLY"
  nav_style "$grole" "${bare#"$sep"}"; group_styled="$REPLY"
  [ "$state_on" = 1 ] && nav_style "$state" "$label"; state_styled="$REPLY"
  nav_style task "$location"; loc_styled="$REPLY"
  nav_style task "$task"; task_styled="$REPLY"
  out="$indent$branch_styled $pane_styled$runtime_sep$runtime_styled"
  out+="$sep$group_styled"
  [ "$state_on" = 1 ] && out+="  $state_styled"
  [ -n "$location" ] && [ "$loc_len" -gt 0 ] && out+=" $loc_styled"
  [ -n "$task" ] && out+="  $task_styled"
  REPLY="$out"
  return 0
}

# nav_route -> REPLY=classic|multiline|oneline. Maps the capability probe onto
# the three ADR fallback levels (NAV-2): on -> multiline, off -> one-line nav
# (same token architecture), classic -> classic launcher.
nav_route() {
  fzf_multiline_probe
  case "$REPLY" in
    on) REPLY='multiline' ;;
    off) REPLY='oneline' ;;
    *) REPLY='classic' ;;
  esac
}

# nav_act <token> <action> — the single strict dispatcher for every nav
# single-row action (Enter uses nav_go; popup/kill/rename/approve/interrupt/
# message use nav_act). The hidden action token is the ONLY input; display text
# never reaches any tmux command. The nav renderer never emits header records,
# and an empty/malformed token is rejected here, so no fzf row is a dead,
# closable selection.
#
# Action table (§22): actions apply by record type.
#   session: go(nav_go) popup kill-session rename-session
#   window:  go(record+select @N) popup(attach+select-window @N) kill-window
#            rename-window; approve/interrupt/message are pane-only and get a
#            bounded operator message, never a silent pane action
#   pane:    go(nav_go) popup kill-pane rename-window(its own window)
#            approve/interrupt/message (act_on_target)
nav_act() {
  local token="${1:-}" action="${2:-}" parsed type sid target
  if [ -z "$token" ] || ! parse_nav_token "$token"; then
    tmux display-message 'tmux-picker: riga non azionabile' 2>/dev/null || true
    return 1
  fi
  parsed="$REPLY"
  IFS=$'\t' read -r type sid target <<< "$parsed"
  [ "$sid" = - ] && sid=''
  case "$type" in
    session)
      case "$action" in
        popup)  open_popup_client session "$sid" "$sid" ;;
        kill)   kill_target session "$sid" "$sid" ;;
        rename) rename_target session "$sid" "$sid" ;;
        *)
          tmux display-message "tmux-picker: azione non valida su riga sessione: $action" 2>/dev/null || true
          return 1
          ;;
      esac
      ;;
    window)
      # ownership revalidated against live tmux before ANY window mutation
      resolve_nav_window_session "$sid" "$target" || return 1
      sid="$REPLY"
      case "$action" in
        go)     record_prev; jump_to_target window "$sid" "$target" ;;
        popup)  open_popup_client window "$sid" "$target" ;;
        kill)   kill_target window "$sid" "$target" ;;
        rename) rename_target window "$sid" "$target" ;;
        approve|interrupt|message)
          # pane-only actions: a bounded non-error operator message, never a
          # guessed pane target (§22)
          tmux display-message "tmux-picker: '$action' agisce solo sui riquadri (riga finestra)" 2>/dev/null || true
          return 0
          ;;
        *)
          tmux display-message "tmux-picker: azione non valida su riga finestra: $action" 2>/dev/null || true
          return 1
          ;;
      esac
      ;;
    pane)
      resolve_nav_pane_session "$sid" "$target" || return 1
      sid="$REPLY"
      case "$action" in
        popup)  open_popup_client pane "$sid" "$target" ;;
        kill)   kill_target pane "$sid" "$target" ;;
        rename) rename_target pane "$sid" "$target" ;;
        approve|interrupt|message) act_on_target pane "$sid" "$target" "$action" ;;
        *)
          tmux display-message "tmux-picker: azione sconosciuta: $action" 2>/dev/null || true
          return 1
          ;;
      esac
      ;;
  esac
}

# nav_border_label — fzf transform-border-label source for the nav launcher.
# Tab toggles compact <-> expanded TOPOLOGY (§5), not merely hide/show panes.
nav_border_label() {
  read_list_mode
  case "$REPLY" in
    sessions-only) printf '%s' ' ↵ open · Tab expanded · ^/ details · ? help · compact ' ;;
    *) printf '%s' ' ↵ open · Tab compact · ^/ details · ? help · expanded ' ;;
  esac
}

# nav_key_help — the `?` panel for nav: the full action list stays here, never
# in the persistent footer (ADR Decision 8 / section 17).
nav_key_help() {
  cat <<'EOF'
xtmux nav — keys

  Enter          go to the highlighted session/window/pane
  Alt-Enter      open it in a popup (detached client)
  Tab            compact <-> expanded topology (sessions <-> session/window/pane)
  Space          mark rows (multi-select)
  Alt-X          bulk-kill marked rows (multi-select only)
  Alt-x          kill the highlighted row
  Alt-r          rename the highlighted row
  ^Y             approve a waiting agent pane
  Alt-i          interrupt the highlighted agent pane
  ^O             message the highlighted agent pane
  ^A all · ^W wait · ^E run     attention presets
  ^F             structured filter (repo:/branch:/cmd:/grep:)
  Ctrl-r         refresh list (bypasses the git cache)
  ^/             toggle the bottom inspector
  Alt-p          inspector compact <-> large
  ?              this help

Every action resolves the hidden action token; displayed text is never parsed.
EOF
}

# pick_classic — the original newline-TSV launcher, byte-compatible with the
# legacy picker. Used by bare `xtmux`/`tmux-session-picker`, by
# XTMUX_NAV_LAYOUT=classic, and as the nav fallback when machine-field action
# safety cannot be proven. fzf receives five-field TSV rows; every action reads
# machine fields {1} {2} {4} and the Enter flow parses the row like the
# original picker.
pick_classic() {
  if ! command -v fzf >/dev/null 2>&1; then
    tmux display-message 'fzf non trovato'
    exit 1
  fi
  local preview_window='right,62%,wrap,follow'
  local preview_window_max='right,94%,wrap,follow'
  local border_label=' Enter switch · Tab mark · Alt-R rename · Alt-X bulk kill · Alt-x kill · ^Y ok · Alt-I int · ^O msg · ^A all ^W wait ^E run · ^F filter · Ctrl-r refresh · ? help · Ctrl-/ preview '
  local choice type sid name target _
  case "$mode" in
    compact-wrap)
      preview_window='right,68%,wrap,follow'
      preview_window_max='right,94%,wrap,follow'
      border_label=' compact wrap · Enter switch · Alt-Enter popup · Alt-x kill · ^Y approve · Alt-I interrupt · ^O msg · ^A/^W/^E filtri · ^F filter · Ctrl-r refresh · ? help '
      ;;
    compact-nowrap)
      preview_window='right,68%,follow'
      preview_window_max='right,94%,follow'
      border_label=' compact no-wrap · Enter switch · Alt-Enter popup · Alt-x kill · ^Y approve · Alt-I interrupt · ^O msg · ^A/^W/^E filtri · ^F filter · Ctrl-r refresh · ? help '
      ;;
  esac
  choice="$({
    "$self" list all
  } | fzf \
    --ansi \
    --delimiter=$'\t' \
    --with-nth=5 \
    --layout=reverse-list \
    --height=100% \
    --margin=1,2 \
    --border=none \
    --list-border=none \
    --header "$border_label" \
    --header-first \
    --no-scrollbar \
    --cycle \
    --no-bold \
    --multi \
    --prompt='all> ' \
    --pointer='>' \
    --marker='✓ ' \
    --info=inline-right \
    --color='fg:#b8bcc0,bg:-1,hl:#ffffff,fg+:#ffffff,bg+:#222222,hl+:#ffffff,info:#8a8f94,prompt:#8a8f94,pointer:#c6cacf,marker:#c6cacf,label:#8a8f94,border:#303030,gutter:-1' \
    --preview-window="$preview_window" \
    --bind="load:transform-prompt($self prompt-label)" \
    --bind="ctrl-/:toggle-preview" \
    --bind="?:change-preview($self mux-help)" \
    --bind="ctrl-r:reload(TMUX_PICKER_NO_CACHE=1 $self list-active)" \
    --bind="ctrl-a:execute-silent($self filter-preset all)+change-prompt(all> )+reload($self list all)" \
    --bind="ctrl-w:execute-silent($self filter-preset waiting)+change-prompt(wait> )+reload($self list waiting)" \
    --bind="ctrl-e:execute-silent($self filter-preset running)+change-prompt(run> )+reload($self list running)" \
    --bind="ctrl-f:execute($self filter-menu)+reload($self list-active)+transform-prompt($self prompt-label)" \
    --bind="tab:execute($self mode-toggle)+reload($self list-active)+transform-prompt($self prompt-label)" \
    --bind="space:toggle+down" \
    --bind="alt-p:change-preview-window($preview_window_max|$preview_window)" \
    --bind="alt-x:execute-silent($self kill {1} {2} {4})+reload($self list-active)" \
    --bind="alt-X:execute-silent($self bulk-kill-targets {+4})+reload($self list-active)" \
    --bind="alt-r:execute($self rename {1} {2} {4})+reload($self list-active)" \
    --bind="ctrl-y:execute-silent($self act {1} {2} {4} approve)+reload($self list-active)" \
    --bind="alt-i:execute-silent($self act {1} {2} {4} interrupt)+reload($self list-active)" \
    --bind="ctrl-o:execute($self act {1} {2} {4} message)+reload($self list-active)" \
    --bind="alt-enter:become($self popup {1} {2} {4})" \
    --preview "$self preview {1} {2} {3} {4}"
  )" || true
  [ -n "${choice:-}" ] || exit 0
  IFS=$'\t' read -r type sid name target _ <<< "$choice"
  jump_to_target "$type" "$sid" "$target"
}

# nav_reserve_fzf_width — convert popup columns into usable row columns. With
# the borderless rendering the multi-select pointer/marker gutter still consumes
# four terminal cells (no fzf border anymore; was eight with one).
nav_reserve_fzf_width() {
  local w="${XTMUX_NAV_WIDTH:-${COLUMNS:-52}}"
  case "$w" in ''|*[!0-9]*) w=52 ;; esac
  w=$(( w - 4 ))
  [ "$w" -lt 1 ] && w=1
  XTMUX_NAV_WIDTH="$w"
  export XTMUX_NAV_WIDTH
}

# nav_snapshot_project_stream <flat-file> <single|multi>
# Pure ancestry projection over an already-rendered NUL nav snapshot.
# Fields 1-5 remain byte-identical; only display field 6 gains parent
# cards. No tmux/git/fzf calls occur here.
nav_snapshot_project_stream() {
  local input="${1:-}" lines="${2:-multi}" record type sid name target token display prefix out
  local sdisp='' sname='' wdisp='' wname=''
  [ -f "$input" ] || return 1
  case "$lines" in single|multi) ;; *) return 2 ;; esac
  while IFS= read -r -d '' record; do
    IFS=$'\t' read -r type sid name target token _ <<< "$record"
    prefix="$type"$'\t'"$sid"$'\t'"$name"$'\t'"$target"$'\t'"$token"$'\t'
    display="${record#"$prefix"}"
    out="$record"
    case "$type" in
      session)
        sdisp="$display"; sname="$name"; wdisp=''; wname=''
        ;;
      window)
        wdisp="$display"; wname="$name"
        if [ "$lines" = single ]; then
          display="${sname}  $display"
        else
          display="${sdisp}"$'\n'"$display"
        fi
        out="$prefix$display"
        ;;
      pane)
        if [ "$lines" = single ]; then
          display="${sname}  ${wname}  $display"
        elif [ -n "$wdisp" ]; then
          display="${sdisp}"$'\n'"${wdisp}"$'\n'"$display"
        else
          display="${sdisp}"$'\n'"$display"
        fi
        out="$prefix$display"
        ;;
    esac
    if [ "${#out}" -gt "$NAV_MAX_RECORD_CHARS" ]; then
      nav_enforce_bounded "$out"; out="$REPLY"
    fi
    printf '%s\0' "$out"
  done < "$input"
}

nav_snapshot_path_ok() {
  local path="${1:-}" prefix="${TMPDIR:-/tmp}/xtmux-nav."
  [ -n "$path" ] || return 1
  case "$path" in "$prefix"*) ;; *) return 1 ;; esac
  [ -f "$path" ] && [ ! -L "$path" ] && [ -O "$path" ]
}

# Per-keystroke path: local file read only. Query text selects flat vs
# ancestry snapshot and never reaches tmux/git/eval.
nav_snapshot_view() {
  local flat="${1:-}" chain="${2:-}" query="${3:-}"
  nav_snapshot_path_ok "$flat" || return 1
  nav_snapshot_path_ok "$chain" || return 1
  if [ -n "$query" ]; then cat -- "$chain"; else cat -- "$flat"; fi
}

# Explicit live refresh. Build one flat snapshot, derive ancestry from
# those exact bytes, then replace both temp-backed files before output.
nav_snapshot_refresh() {
  local flat="${1:-}" chain="${2:-}" lines="${3:-}" requested="${4:-active}" query="${5:-}"
  local spec mode flat_tmp chain_tmp
  nav_snapshot_path_ok "$flat" || return 1
  nav_snapshot_path_ok "$chain" || return 1
  case "$lines" in single|multi) ;; *) return 2 ;; esac
  case "$requested" in
    active) picker_state_read filter || true; spec="$REPLY" ;;
    all|waiting|running) spec="$requested" ;;
    *) return 2 ;;
  esac
  read_list_mode; mode="$REPLY"
  flat_tmp="${flat}.tmp.$$"; chain_tmp="${chain}.tmp.$$"
  rm -f -- "$flat_tmp" "$chain_tmp"
  build_list "$spec" "$mode" nav "$lines" > "$flat_tmp" || { rm -f -- "$flat_tmp" "$chain_tmp"; return 1; }
  nav_snapshot_project_stream "$flat_tmp" "$lines" > "$chain_tmp" || { rm -f -- "$flat_tmp" "$chain_tmp"; return 1; }
  mv -f -- "$chain_tmp" "$chain" || { rm -f -- "$flat_tmp" "$chain_tmp"; return 1; }
  mv -f -- "$flat_tmp" "$flat" || { rm -f -- "$flat_tmp"; return 1; }
  nav_snapshot_view "$flat" "$chain" "$query"
}

# pick_nav — the drawer launcher for bare `xtmux nav`. Routes on the capability
# probe: multiline -> NUL hierarchy cards; oneline -> NUL one-line cards (same
# hidden token architecture); classic -> the classic launcher.
# XTMUX_NAV_LAYOUT=classic forces the classic launcher. fzf runs --track with
# reload-sync+track-current binds (probe-proven); the footer is the short ADR
# string only; the inspector sits at the bottom, initially compact, ^/ toggles.
pick_nav() {
  if ! command -v fzf >/dev/null 2>&1; then
    tmux display-message 'fzf non trovato'
    exit 1
  fi
  local layout navmode lines self_q
  layout="${XTMUX_NAV_LAYOUT:-}"
  if [ "$layout" = classic ]; then pick_classic; return $?; fi
  nav_route; navmode="$REPLY"
  case "$navmode" in
    classic) pick_classic; return $? ;;
    oneline) lines='single' ;;
    *) lines='multi' ;;
  esac
  nav_reserve_fzf_width
  local footer=' ↵ open · Tab compact · ^/ details · ? help '
  local inspector='hidden,bottom,7,wrap,follow'
  local inspector_max='bottom,50%,wrap,follow'
  printf -v self_q '%q' "$self"
  (
    local flat_file chain_file flat_q chain_q lall lwait lrun lactive lchain
    local record type sid name target token display prefix pos=1 index=0 spec
    flat_file="$(mktemp "${TMPDIR:-/tmp}/xtmux-nav.flat.XXXXXX")" || exit 1
    chain_file="$(mktemp "${TMPDIR:-/tmp}/xtmux-nav.chain.XXXXXX")" || { rm -f "$flat_file"; exit 1; }
    trap 'rm -f "$flat_file" "$chain_file"' EXIT INT TERM

    # Initial open performs one ordinary live projection. Query changes below
    # never return to live inventory; they switch between local snapshots.
    if [ "$lines" = single ]; then
      "$self" list-active-nav-single > "$flat_file"
    else
      "$self" list-active-nav > "$flat_file"
    fi
    nav_snapshot_project_stream "$flat_file" "$lines" > "$chain_file"

    printf -v flat_q '%q' "$flat_file"
    printf -v chain_q '%q' "$chain_file"
    lall="$self_q nav-snapshot-refresh $flat_q $chain_q $lines all '{q}'"
    lwait="$self_q nav-snapshot-refresh $flat_q $chain_q $lines waiting '{q}'"
    lrun="$self_q nav-snapshot-refresh $flat_q $chain_q $lines running '{q}'"
    lactive="$self_q nav-snapshot-refresh $flat_q $chain_q $lines active '{q}'"
    lchain="$self_q nav-snapshot-view $flat_q $chain_q '{q}'"

    while IFS= read -r -d '' record; do
      index=$((index + 1))
      IFS=$'\t' read -r type sid name target token _ <<< "$record"
      prefix="$type"$'\t'"$sid"$'\t'"$name"$'\t'"$target"$'\t'"$token"$'\t'
      display="${record#"$prefix"}"
      case "$display" in '▎ '*|*$'\n''▎ '*) pos="$index"; break ;; esac
    done < "$flat_file"

    fzf \
      --ansi --read0 --track --delimiter=$'\t' --with-nth=6 \
      --layout=reverse-list --height=100% --margin=1,2 \
      --border=none --list-border=none --no-scrollbar --cycle --no-bold --multi \
      --header=" xtmux nav · state groups · type to filter $footer" --header-first \
      --prompt='all> ' --pointer='>' --marker='✓ ' --info=inline-right \
      --color='fg:#b8bcc0,bg:-1,hl:#68a8c4,fg+:#ffffff,bg+:#222222,hl+:#68a8c4,info:#8a8f94,prompt:#8a8f94,pointer:#68a8c4,marker:#68a8c4,label:#8a8f94,border:#303030,gutter:-1' \
      --preview-window="$inspector" \
      --bind="load:pos($pos)+transform-prompt($self_q prompt-label nav)" \
      --bind="change:reload-sync($lchain)" \
      --bind="ctrl-/:toggle-preview" \
      --bind="?:change-preview($self_q nav-key-help)+show-preview" \
      --bind="ctrl-r:reload-sync(TMUX_PICKER_NO_CACHE=1 $lactive)+track-current" \
      --bind="ctrl-a:execute-silent($self_q filter-preset all)+change-prompt(all> )+reload-sync($lall)+track-current" \
      --bind="ctrl-w:execute-silent($self_q filter-preset waiting)+change-prompt(wait> )+reload-sync($lwait)+track-current" \
      --bind="ctrl-e:execute-silent($self_q filter-preset running)+change-prompt(run> )+reload-sync($lrun)+track-current" \
      --bind="ctrl-f:execute($self_q filter-menu)+reload-sync($lactive)+track-current+transform-prompt($self_q prompt-label nav)" \
      --bind="tab:execute($self_q mode-toggle)+reload-sync($lactive)+track-current+transform-prompt($self_q prompt-label nav)" \
      --bind="space:toggle+down" \
      --bind="alt-p:change-preview-window($inspector_max|$inspector)" \
      --bind="enter:become($self_q nav-go {5})" \
      --bind="alt-enter:become($self_q nav-act {5} popup)" \
      --bind="alt-x:execute-silent($self_q nav-act {5} kill)+reload-sync($lactive)+track-current" \
      --bind="alt-X:execute-silent($self_q bulk-kill {+5})+reload-sync($lactive)+track-current" \
      --bind="alt-r:execute($self_q nav-act {5} rename)+reload-sync($lactive)+track-current" \
      --bind="ctrl-y:execute-silent($self_q nav-act {5} approve)+reload-sync($lactive)+track-current" \
      --bind="alt-i:execute-silent($self_q nav-act {5} interrupt)+reload-sync($lactive)+track-current" \
      --bind="ctrl-o:execute($self_q nav-act {5} message)+reload-sync($lactive)+track-current" \
      --preview "$self_q preview {1} {2} {3} {4}" < "$flat_file" || true
  )
  return 0
}
# parse_filter <spec> -> sets FF_ATTN FF_REPO FF_BRANCH FF_CMD FF_GREP
# grammar (comma-separated clauses, ANDed):
#   all | waiting | running          attention presets
#   repo:<substr>                    substring match on repo basename
#   branch:<name>                    exact branch match
#   cmd:<agent|shell|bun>            session has a pane of that class
#   grep:<text>                      case-insensitive fixed text in pane capture
parse_filter() {
  FF_ATTN='all'; FF_REPO=''; FF_BRANCH=''; FF_CMD=''; FF_GREP=''
  local spec="${1:-}" clause
  [ -n "$spec" ] || return 0
  local _clauses=()
  IFS=',' read -ra _clauses <<< "$spec"
  for clause in "${_clauses[@]}"; do
    clause="${clause## }"; clause="${clause%% }"
    [ -n "$clause" ] || continue
    case "$clause" in
      all|waiting|running) FF_ATTN="$clause" ;;
      repo:*)   FF_REPO="${clause#repo:}" ;;
      branch:*) FF_BRANCH="${clause#branch:}" ;;
      cmd:*)    FF_CMD="${clause#cmd:}" ;;
      grep:*)   FF_GREP="${clause#grep:}" ;;
      *) ;;  # unknown clause ignored (defensive: never break the list)
    esac
  done
}

# classify_pane_cmd <pane_cmd> <normalized_state> -> REPLY=agent|shell|bun|other
# truthful source for "agent" is @agent_state (xtmux-rib.2); specialists run bun.
classify_pane_cmd() {
  local cmd="${1:-}" state="${2:-}"
  case "$cmd" in
    bun) REPLY='bun'; return 0 ;;
  esac
  if [ -n "$state" ] && [ "$state" != '-' ]; then REPLY='agent'; return 0; fi
  case "$cmd" in
    bash|zsh|sh|fish|dash|ksh|tcsh|csh|osh) REPLY='shell' ;;
    *) REPLY='other' ;;
  esac
}

# __repo_matches <root> <name-substr> -> return 0 if root basename contains name
__repo_matches() {
  local root="${1:-}" name="${2:-}" base lbase lname
  [ -n "$root" ] && [ -n "$name" ] || return 1
  base="${root##*/}"; lbase="${base,,}"; lname="${name,,}"
  case "$lbase" in *"$lname"*) return 0 ;; esac
  lbase="${root,,}"
  case "$lbase" in *"$lname"*) return 0 ;; esac
  return 1
}

# branch_from_root_status <root_status> -> REPLY=branch ('' if unparseable)
# root_status format: "REPO <icon> BRANCH [flags] <icon> <path>"
branch_from_root_status() {
  local raw="${1:-}" rest
  [ -n "$raw" ] || { REPLY=''; return 0; }
  rest="${raw#* }"            # drop REPO token
  [ "$rest" = "$raw" ] && { REPLY=''; return 0; }
  rest="${rest#* }"           # drop icon token
  REPLY="${rest%% *}"         # first token of remainder == BRANCH
}

# __filter_distinct <repo|branch> -> print distinct values across live sessions
__filter_distinct() {
  local kind="$1" p root val
  local -A seen=()
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    git_root_for_path "$p"; root="$REPLY"
    [ -n "$root" ] || continue
    if [ "$kind" = repo ]; then
      val="${root##*/}"
    else
      val="$(run_git -C "$root" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
    fi
    [ -n "$val" ] || continue
    [[ -v seen["$val"] ]] && continue
    seen["$val"]=1
    printf '%s\n' "$val"
  done < <(tmux list-sessions -F '#{pane_current_path}' 2>/dev/null)
  return 0
}

# cmd_filter_menu: the ctrl-f submenu. picks dimension+value, writes spec to the
# state file. two-level for repo/branch (live sessions), one-level for cmd,
# free text for grep.
cmd_filter_menu() {
  command -v fzf >/dev/null 2>&1 || return 0
  local dim spec=''
  dim="$(printf '%s\n' 'repo' 'branch' 'cmd' 'grep' '' 'clear' \
    | fzf --prompt='filter by> ' --height=40% --no-sort --tiebreak=index --cycle 2>/dev/null)" || return 0
  case "$dim" in
    repo)
      spec="$(__filter_distinct repo | fzf --prompt='repo> ' --height=50% --no-sort 2>/dev/null)" || spec=''
      [ -n "$spec" ] && spec="repo:$spec"
      ;;
    branch)
      spec="$(__filter_distinct branch | fzf --prompt='branch> ' --height=50% --no-sort 2>/dev/null)" || spec=''
      [ -n "$spec" ] && spec="branch:$spec"
      ;;
    cmd)
      spec="$(printf '%s\n' agent shell bun | fzf --prompt='cmd> ' --height=30% --no-sort 2>/dev/null)" || spec=''
      [ -n "$spec" ] && spec="cmd:$spec"
      ;;
    grep)
      local _q
      _q="$(printf '%s\n' 'type text, then Enter' | fzf --prompt='grep> ' --print-query --height=30% --no-sort 2>/dev/null)" \
        && spec="grep:$(printf '%s\n' "$_q" | head -1)" || spec=''
      ;;
    clear) spec='' ;;
    *) spec='' ;;
  esac
  picker_state_write filter "$spec" || true
}

# build_list <spec> [<mode>] [<emit>] [<lines>]
# spec: all|waiting|running, or comma clauses repo:/branch:/cmd:/grep:
# mode: expanded (default) | sessions-only (suppress pane rows)
# emit: tsv (default, public five-field newline TSV) | nav (private
# six-field NUL-delimited records: type<TAB>sid<TAB>name<TAB>target
# <TAB>token<TAB>display<NUL>; token is s:$N / p:$N:%N)
# lines: multi (session primary/context plus one-line panes) | single (bounded one-line cards,
# the fzf-multiline off fallback; same token architecture)
build_list() (
  local filter="${1:-all}" list_mode="${2:-expanded}" emit="${3:-tsv}" lines="${4:-multi}" chain="${5:-}"
  local tmp_sessions tmp_panes pane_rows sid sname pane_id pane_path session_activity root sort_key group_key display root_status name_width=12 session_col
  local window_id window_index window_name window_active pane_index pane_active pane_cmd pane_row_path pane_col pane_state pane_pid pane_bead pane_task pane_parent pane_rank cur_rank _cls
  local psid pwi ppi ppid pcol attn idle stale_bucket section last_section=-1 header_label now
  local cur_pane='' cur_sid='' cur_window='' cur_session='' _sstate _stag _marker _sctx _scard _pblock _pline
  local nav_win_key=''
  local _last_wsid='' _last_wid='' _wlabel='' _wname='' _wtag='' _wcard='' _wmarker='' _wk='' _ploc='' _pname='' _wcur=0 _pcur=0
  local pcmd pstate pbead ptask ppath proot pctx pstate_tag pdisp _nav_group _nav_state _branch _seen
  local -a _prow=()
  declare -A root_cache=()
  declare -A root_status_cache=()
  declare -A sess_name=()
  declare -A sess_attn=()
  declare -A sess_stale=()
  declare -A sess_section=()
  declare -A pane_block=()
  declare -A sess_root=()
  declare -A sess_group_root=()
  declare -A sess_root_status=()
  declare -A sess_nav_state=()
  declare -A sess_pane_count=()
  declare -A sess_pane_seen=()
  declare -A sess_classes=()
  declare -A sess_grep_hit=()
  declare -A root_sids=()
  declare -A sess_shared_wt=()
  declare -A sess_idle_plain=()
  parse_filter "$filter"

  # Persistent git cache (path -> root, root -> status). The expensive, near-static
  # half of the list. Agent state (@agent_state) and the attention sort derived
  # from it are NEVER cached — they're read fresh every call (see xtmux-rib.17).
  local _gcd _gcf _gnow _gmt _ghit=0 _gp _gr _gs
  cache_dir; _gcd="$REPLY"
  _gcf="$_gcd/git-table"
  if [ "${TMUX_PICKER_NO_CACHE:-0}" != '1' ] && [ -f "$_gcf" ]; then
    _gnow=$(date +%s)
    _gmt=$(stat -c %Y "$_gcf" 2>/dev/null || echo 0)
    if [ "$_gmt" -gt 0 ] && (( _gnow - _gmt < ${TMUX_PICKER_GIT_CACHE_TTL:-30} )); then
      while IFS=$'\t' read -r _gp _gr _gs; do
        [ -n "$_gp" ] || continue
        root_cache["$_gp"]="$_gr"
        [ -n "$_gr" ] && root_status_cache["$_gr"]="$_gs"
      done < "$_gcf"
      _ghit=1
    fi
  fi

  tmp_sessions="$(mktemp)"
  tmp_panes="$(mktemp)"
  now="$(date +%s)"
  trap 'rm -f "${tmp_sessions:-}" "${tmp_panes:-}" "${_gtmp:-}"' EXIT INT TERM

  while IFS=$'\t' read -r sid sname pane_id pane_path session_activity; do
    [ -n "$sid" ] || continue
    pane_path="${pane_path:-$HOME}"

    if [[ -v root_cache["$pane_path"] ]]; then
      root="${root_cache[$pane_path]}"
    else
      git_root_for_path "$pane_path"; root="$REPLY"
      root_cache["$pane_path"]="$root"
    fi

    if [ -n "$root" ]; then
      if [[ -v root_status_cache["$root"] ]]; then
        root_status="${root_status_cache[$root]}"
      else
        status_for_path "" "$root"; root_status="$REPLY"
        root_status_cache["$root"]="$root_status"
      fi
    else
      root_status=''
    fi

    group_root_for_path "$pane_path" "$root"; group_key="$REPLY"
    sort_key="$group_key"
    if [ "$emit" = nav ]; then
      display=''
      idle_label_plain "$session_activity" "$now"; sess_idle_plain["$sid"]="$REPLY"; stale_bucket="$IDLE_STALE"
    else
      render_list_status "$pane_path" "$root" "$root_status"; display="$REPLY"
      idle_badge "$session_activity" "$now"; idle="$REPLY"; stale_bucket="$IDLE_STALE"
      [ -n "$idle" ] && display+=" $idle"
    fi
    section=0
    [[ "$sname" == sp-* ]] && section=1
    if [ "$emit" = nav ]; then nav_text_clean "$sname"; sname="$REPLY"; fi
    sess_name["$sid"]="$sname"
    sess_stale["$sid"]="$stale_bucket"
    sess_section["$sid"]="$section"
    sess_root["$sid"]="$root"
    sess_group_root["$sid"]="${root:+$group_key}"
    sess_root_status["$sid"]="$root_status"
    [ "${#sname}" -gt "$name_width" ] && name_width="${#sname}"

    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$section" "$sort_key" "$stale_bucket" "$sid" "$sname" "$display" >> "$tmp_sessions"
  done < <(session_meta)

  # Single bulk pane inventory -> derived session→window→pane projection in one
  # list-panes pass (structural gate: no per-window/per-session tmux fanout).
  pane_rows="$(pane_meta)"
  build_nav_inventory <<< "$pane_rows"

  # Current location derives from the enumerated inventory (NAV-2/NAV-T2):
  # current pane/window/session are proven present, not inferred from text.
  nav_current_location
  cur_sid="$cur_session"

  while IFS=$'\t' read -r sid window_id window_index window_name window_active pane_id pane_index pane_active pane_cmd pane_row_path pane_state pane_pid pane_bead pane_task pane_parent pane_transition; do
    [ -n "$sid" ] || continue
    pane_row_path="${pane_row_path:-$HOME}"

    if [[ -v root_cache["$pane_row_path"] ]]; then
      root="${root_cache[$pane_row_path]}"
    else
      git_root_for_path "$pane_row_path"; root="$REPLY"
      root_cache["$pane_row_path"]="$root"
    fi

    if [ -n "$root" ]; then
      case " ${root_sids[$root]:-} " in *" $sid "*) ;; *) root_sids[$root]+=" $sid" ;; esac
    fi

    normalize_agent_state "$pane_id" "$pane_state" "$pane_cmd" "$pane_transition"; pane_state="$REPLY"

    # NAV-T2: fold the normalized pane state up through window and session with
    # the ONE canonical priority (nav_state_max over agent_rank). Exposed to both
    # renderers via the shared normalized inventory (prompt 7/8); no extra tmux.
    # Session folds each window's aggregate, so the session = strongest window.
    NAV_PANE_STATE["$pane_id"]="$pane_state"
    nav_win_key="$sid|$window_id"
    if [ -z "${NAV_WIN_STATE["$nav_win_key"]+x}" ]; then
      NAV_WIN_STATE["$nav_win_key"]="$pane_state"
    else
      nav_state_max "${NAV_WIN_STATE["$nav_win_key"]}" "$pane_state"; NAV_WIN_STATE["$nav_win_key"]="$REPLY"
    fi
    nav_state_max "${NAV_SESS_STATE["$sid"]:-}" "${NAV_WIN_STATE["$nav_win_key"]}"; NAV_SESS_STATE["$sid"]="$REPLY"

    if [ "$emit" = nav ]; then
      sess_pane_count["$sid"]=$(( ${sess_pane_count[$sid]:-0} + 1 ))
      sess_nav_state["$sid"]="${NAV_SESS_STATE[$sid]}"
    fi
    # specialist state takes precedence when tracked: a waiting specialist should
    # rank for attention like a waiting agent pane (xtmux-rib.4).
    # fast specialist detection for list hot path: session name + live pane pid.
    # no pgrep/ps/sp here; bead/details are resolved in preview only. do not
    # synthesize stale/running state without process-tree evidence; explicit
    # @agent_state is the only state source in the hot list path.
    sp_is_specialist "${sess_name[$sid]:-}" "$pane_pid"; sp_role="$REPLY"
    agent_rank "$pane_state"; pane_rank="$REPLY"
    cur_rank="${sess_attn[$sid]:-4}"
    [ "$pane_rank" -lt "$cur_rank" ] && sess_attn["$sid"]="$pane_rank"

    # richer filters (xtmux-rib.11): collect per-session cmd classes + grep hits.
    # only the work for an active clause is done (free-text grep is lazy here).
    if [ -n "$FF_CMD" ]; then
      classify_pane_cmd "$pane_cmd" "$pane_state"; _cls="$REPLY"
      case " ${sess_classes[$sid]:-} " in *" $_cls "*) ;; *) sess_classes["$sid"]+=" $_cls";; esac
    fi
    if [ -n "$FF_GREP" ] && [ "${sess_grep_hit[$sid]:-0}" != 1 ]; then
      if capture_pane_safe "$pane_id" -50 | sed -E $'s/\x1b\\[[0-9;]*m//g' | grep -qiF -- "$FF_GREP"; then
        sess_grep_hit["$sid"]=1
      fi
    fi

    if [ "$emit" = nav ]; then
      # NAV-2 card inputs ride in the temp row (never used by the tsv path).
      # window_id/window_name ride along so NAV-T3 can emit the interim window
      # record (token proof) without a second inventory pass. Empty values are
      # written as '-' because bash `read -a` collapses consecutive IFS-whitespace
      # delimiters: an empty middle field would silently shift every later field
      # (the emit loop below maps '-' back to '').
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$sid" "$window_index" "$pane_index" "$pane_id" "$pane_cmd" "${pane_state:--}" "${pane_bead:--}" "${pane_task:--}" "$pane_row_path" "${root:--}" "${window_id:--}" "${window_name:--}" >> "$tmp_panes"
    else
      render_pane_line "$window_index" "$window_name" "$pane_id" "$pane_active" "$pane_cmd" "$pane_row_path" "$root" "$pane_state" "${sess_name[$sid]:-}" "$pane_pid" "$pane_bead" "$pane_task" "$pane_parent"; pane_col="$REPLY"
      printf '%s\t%s\t%s\t%s\t%s\n' "$sid" "$window_index" "$pane_index" "$pane_id" "$pane_col" >> "$tmp_panes"
    fi
  done <<< "$pane_rows"

  if [ -s "$tmp_panes" ]; then
    if [ "$emit" = nav ]; then
      while IFS=$'\t' read -r -a _prow; do
        [ -n "${_prow[0]:-}" ] || continue
        psid="${_prow[0]}"; ppid="${_prow[3]}"
        pcmd="${_prow[4]:-}"; pstate="${_prow[5]:-}"; pbead="${_prow[6]:-}"; ptask="${_prow[7]:-}"; ppath="${_prow[8]:-}"
        proot="${_prow[9]:-}"; [ "$proot" = - ] && proot=''
        pwid="${_prow[10]:-}"; pwname="${_prow[11]:-}"; [ "$pwname" = - ] && pwname=''
        # NAV-T4 window row (§15): one per (session, window), emitted right
        # before that window's panes so the block reads session -> window ->
        # panes. Machine identity is the @N target and the w:$sid:@N token;
        # index:name is presentation only. The card is compact and
        # independently selectable (already from NAV-T3) — @id never truncated,
        # index:name truncates, aggregate state + pane count from the folded
        # inventory. The ancestry glyph is ALWAYS `↳` (uniform, invariant to
        # sibling position, PART V); the current window is distinguished by
        # ACCENT styling on `↳`/@id inside nav_window_card, never by a `▸`.
        if [ -n "$pwid" ] && { [ "$psid" != "$_last_wsid" ] || [ "$pwid" != "$_last_wid" ]; }; then
          nav_window_label "${_prow[1]}" "$pwname"; _wlabel="$REPLY"
          _wmarker='↳'
          _wcur=0
          [ -n "$cur_sid" ] && [ -n "$cur_window" ] && [ "$psid" = "$cur_sid" ] && [ "$pwid" = "$cur_window" ] && _wcur=1
          _wk="$psid|$pwid"
          nav_state_tag "${NAV_WIN_STATE["$_wk"]:-idle}"; _wtag="$REPLY"
          nav_window_card "$_wmarker" "$pwid" "$_wlabel" "$_wtag" "${NAV_WIN_COUNT["$_wk"]:-0}" "$lines" "$_wcur"; _wcard="$REPLY"
          nav_bounded_name "$_wlabel"; _wname="$REPLY"
          pane_block["$psid"]+="$(printf 'window\t%s\t%s\t%s\tw:%s:%s\t%s' "$psid" "$_wname" "$pwid" "$psid" "$pwid" "$_wcard")"$'\x1f'
          _last_wsid="$psid"; _last_wid="$pwid"
        fi
        nav_pane_context "$pbead" "$ptask" "$ppath" "$proot"; pctx="$REPLY"
        nav_state_tag "$pstate"; pstate_tag="$REPLY"
        # NAV-T4 pane location: bounded paneLocation projection from the
        # already-collected pane cwd + cached git root — zero new subprocesses
        # on the hot path (§3/§17/§31). Rides inline on the single pane line;
        # full path is details-only.
        nav_pane_location "$ppath" "$proot"; _ploc="$REPLY"
        _seen=$(( ${sess_pane_seen[$psid]:-0} + 1 )); sess_pane_seen["$psid"]="$_seen"
        # Uniform `↳` ancestry glyph for every pane, invariant to sibling
        # position (§ PART V — no more ●/└/├). The current pane is distinguished
        # by ACCENT styling on `↳`/%pane-id inside nav_pane_card, never by a ●.
        _branch='↳'
        _pcur=0
        [ -n "$cur_pane" ] && [ "$psid" = "$cur_sid" ] && [ "$ppid" = "$cur_pane" ] && _pcur=1
        nav_pane_card "$_branch" "$ppid" "${pcmd:-shell}" "$pstate_tag" "$pctx" "${sess_nav_state[$psid]:-idle}" "$lines" "$_ploc" "$_pcur"; pdisp="$REPLY"
        nav_bounded_name "${sess_name[$psid]:-}"; _pname="$REPLY"
        pane_block["$psid"]+="$(printf 'pane\t%s\t%s\t%s\tp:%s:%s\t%s' "$psid" "$_pname" "$ppid" "$psid" "$ppid" "$pdisp")"$'\x1f'
      done < <(sort -t $'\t' -k1,1 -k2,2n -k3,3n "$tmp_panes")
    else
      while IFS=$'\t' read -r psid pwi ppi ppid pcol; do
        [ -n "$psid" ] || continue
        pane_block["$psid"]+="$(printf 'pane\t%s\t%s\t%s\t%s' "$psid" "${sess_name[$psid]:-}" "$ppid" "$pcol")"$'\n'
      done < <(sort -t $'\t' -k1,1 -k2,2n -k3,3n "$tmp_panes")
    fi
  fi

  for root in "${!root_sids[@]}"; do
    _sid_list="${root_sids[$root]}"
    # Count words in the sid list; more than one session in the same git
    # worktree is a multiplexing collision warning, not a hard error.
    set -- $_sid_list
    if [ "$#" -gt 1 ]; then
      for _sid in "$@"; do sess_shared_wt["$_sid"]=1; done
    fi
  done

  # Persist the git cache if this call was a miss. Agent state is deliberately
  # excluded — only path/root/status (near-static, expensive) is stored.
  if [ "$_ghit" = '0' ] && [ "${TMUX_PICKER_NO_CACHE:-0}" != '1' ]; then
    mkdir -p "$_gcd"
    local _gtmp="$_gcf.tmp.$$"
    if {
      for _gp in "${!root_cache[@]}"; do
        _gr="${root_cache[$_gp]}"
        _gs=""
        [ -n "$_gr" ] && _gs="${root_status_cache[$_gr]:-}"
        printf '%s\t%s\t%s\n' "$_gp" "$_gr" "$_gs"
      done
    } > "$_gtmp" 2>/dev/null; then
      mv -f "$_gtmp" "$_gcf" || rm -f "$_gtmp"
    else
      rm -f "$_gtmp"
    fi
  fi

  [ "$name_width" -gt 22 ] && name_width=22

  while IFS=$'\t' read -r section sort_key stale_bucket sid sname display; do
    if [ "$emit" = nav ]; then
      _nav_state="${sess_nav_state[$sid]:-idle}"
      # PROMPT 14 (option B documented): the visible group label is a NARROW
      # attention-relevance bucket (stale + needs-input -> `urgent`, the waiting
      # preset, rank ≤1) while the authoritative attention-next traversal
      # (attn_list, agent_rank ≤2) also includes finished/done panes. The label
      # was renamed from `attn` to `urgent` precisely so it cannot overclaim
      # full attention membership; the hierarchy aggregation behind both stays
      # the single nav_state_max order. Done sessions sit in `other` and remain
      # attention-cycle targets.
      case "$_nav_state" in stale|needs-input) _nav_group=0 ;; running) _nav_group=1 ;; *) _nav_group=2 ;; esac
      section="$_nav_group"
    else
      section="${sess_section[$sid]:-$section}"
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$section" "${sess_attn[$sid]:-4}" "${sess_stale[$sid]:-$stale_bucket}" "$sort_key" "$sid" "$sname" "$display"
  done < "$tmp_sessions" |
    sort -t $'\t' -k1,1n -k2,2n -k3,3n -k4,4 -k6,6 |
    while IFS=$'\t' read -r section attn stale_bucket _ sid sname display; do
      # attention preset (xtmux-rib.23/.25): waiting = stale + needs-input
      # (rank<=1), running = any actually-running pane (rank<=3). The old
      # guards (rank==0 / rank<=2) silently dropped needs-input panes from
      # waiting and running panes from running.
      case "$FF_ATTN" in
        waiting) [ "$attn" -le 1 ] || continue ;;
        running) [ "$attn" -le 3 ] || continue ;;
      esac
      # content filters (xtmux-rib.11): AND of repo/branch/cmd/grep clauses
      if [ -n "$FF_REPO" ]; then
        __repo_matches "${sess_root[$sid]:-}" "$FF_REPO" || continue
      fi
      if [ -n "$FF_BRANCH" ]; then
        branch_from_root_status "${sess_root_status[$sid]:-}"
        [ "$REPLY" = "$FF_BRANCH" ] || continue
      fi
      if [ -n "$FF_CMD" ]; then
        case " ${sess_classes[$sid]:-} " in *" $FF_CMD "*) ;; *) continue ;; esac
      fi
      if [ -n "$FF_GREP" ]; then
        [ "${sess_grep_hit[$sid]:-0}" = 1 ] || continue
      fi
      if [ "$emit" != nav ] && [ "${section:-0}" = 1 ] && [ "$last_section" != 1 ]; then
        paint "$c_sp" "── specialists (sp-*) ──"; header_label="$REPLY"
        printf 'header\t\tspecialists\t\t  %s\n' "$header_label"
        last_section=1
      fi
      printf -v session_col '%-*s' "$name_width" "$sname"
      if [ "${stale_bucket:-0}" = 1 ] && [ "$attn" -gt 1 ]; then
        paint "$c_dim" "$session_col"
      else
        paint "$c_session" "$session_col"
      fi
      session_col="$REPLY"
      if [ "$emit" = nav ]; then
        # NAV-2 transport: field 5 is the session action token (s:$sid); field 6
        # is the bounded card (presentation-only). The ▎ marker comes from
        # TMUX_PANE and is independent of fzf's › pointer.
        _sstate="${sess_nav_state[$sid]:-idle}"
        nav_state_tag "$_sstate"; _stag="$REPLY"
        _marker=' '
        [ -n "$cur_sid" ] && [ "$sid" = "$cur_sid" ] && _marker='▎'
        nav_session_context "${sess_group_root[$sid]:-${sess_root[$sid]:-}}" "${sess_root_status[$sid]:-}" "${sess_idle_plain[$sid]:-}" "${sess_shared_wt[$sid]:-0}"; _sctx="$REPLY"
        nav_session_card "$_marker" "$sname" "$_stag" "${sess_idle_plain[$sid]:-}" "$_sctx" "$lines"; _scard="$REPLY"
        # §19: session record field-3 name is hard-capped; the emission guard
        # defends the record byte bound against unforeseen hostile input.
        nav_bounded_name "$sname"; _sname="$REPLY"
        _srec="$(printf 'session\t%s\t%s\t%s\ts:%s\t%s' "$sid" "$_sname" "$sid" "$sid" "$_scard")"
        if [ "${#_srec}" -gt "$NAV_MAX_RECORD_CHARS" ]; then
          nav_enforce_bounded "$_srec"; _srec="$REPLY"
        fi
        printf '%s\0' "$_srec"
      else
        if [ "${sess_shared_wt[$sid]:-0}" = 1 ]; then
          paint "$c_stale" "[shared-wt]"; display+=" $REPLY"
        fi
        printf 'session\t%s\t%s\t%s\t  %s  %s\n' "$sid" "$sname" "$sid" "$session_col" "$display"
      fi
      if [ "$list_mode" != 'sessions-only' ]; then
        if [ "$emit" = nav ]; then
          # bash strings cannot hold NUL, so the block is \x1f-separated
          # internally and each row is re-terminated with NUL at emit time.
          _pblock="${pane_block[$sid]:-}"
          if [ -n "$_pblock" ]; then
            _cur_wdisp=''; _cur_wflat=''
            while IFS= read -r -d $'\x1f' _pline; do
              [ -n "$_pline" ] || continue
              if [ "$chain" = chain ]; then
                # Ancestry-preserving projection (PART: fuzzy search must never
                # orphan a match). fzf filters records independently, so a flat
                # pane row loses its window and session the moment a query
                # matches it. Here each record's DISPLAY carries the full
                # session -> window -> pane chain while fields 1-5 (machine
                # identity + action token) stay byte-identical to the flat
                # stream: enter/kill/popup still act on exactly the matched
                # node. multi stacks the chain lines (same cards, same order as
                # the unfiltered tree); single inlines them bounded on one
                # line. Window rows carry the session line; pane rows carry
                # session + window.
                _rtype="${_pline%%$'\t'*}"
                _rest="$_pline"; _hdr=''; _fname=''
                for _i in 1 2 3 4 5; do
                  _f="${_rest%%$'\t'*}"
                  [ "$_i" = 3 ] && _fname="$_f"
                  _hdr+="$_f"; [ "$_i" -lt 5 ] && _hdr+=$'\t'
                  _rest="${_rest#*$'\t'}"
                done
                case "$_rtype" in
                  window)
                    _cur_wdisp="$_rest"; _cur_wflat="$_fname"
                    if [ "$lines" = single ]; then
                      _rest="${_sname}  $_rest"
                    else
                      _rest="${_scard}"$'\n'"$_rest"
                    fi
                    ;;
                  pane)
                    if [ "$lines" = single ]; then
                      _rest="${_sname}  ${_cur_wflat}  $_rest"
                    elif [ -n "$_cur_wdisp" ]; then
                      _rest="${_scard}"$'\n'"${_cur_wdisp}"$'\n'"$_rest"
                    else
                      _rest="${_scard}"$'\n'"$_rest"
                    fi
                    ;;
                esac
                _pline="$_hdr"$'\t'"$_rest"
              fi
              # §19: emission guard — hostile input cannot grow a record past
              # the byte budget; the display tail yields, machine fields never.
              if [ "${#_pline}" -gt "$NAV_MAX_RECORD_CHARS" ]; then
                nav_enforce_bounded "$_pline"; _pline="$REPLY"
              fi
              printf '%s\0' "$_pline"
            done <<< "$_pblock"
          fi
        else
          printf '%s' "${pane_block[$sid]:-}"
        fi
      fi
    done
)

attn_list() {
  local sid sname pane_id pane_cmd activity pane_state pane_pid pane_transition rank
  while IFS=$'\t' read -r sid sname pane_id pane_cmd activity pane_state pane_pid pane_transition; do
    [ -n "$pane_id" ] || continue
    normalize_agent_state "$pane_id" "$pane_state" "$pane_cmd" "$pane_transition"; pane_state="$REPLY"
    sp_is_specialist "$sname" "$pane_pid"; sp_role="$REPLY"
    # no synthetic specialist state here: attn-jump/waiting use explicit
    # @agent_state only for sp panes, keeping the hot path truthful.
    agent_rank "$pane_state"; rank="$REPLY"
    # stale/needs-input/done. The bound tracks agent_rank: inserting `stale` at 0
    # shifted done from 1 to 2, and leaving the bound at 1 would have silently
    # dropped finished panes out of attn-jump.
    [ "$rank" -le 2 ] || continue
    printf '%s\t%s\t%s\t%s
' "$rank" "${activity:-0}" "$sid" "$pane_id"
  done < <(tmux list-panes -a -F $'#{session_id}\t#{session_name}\t#{pane_id}\t#{pane_current_command}\t#{window_activity}\t#{?@agent_state,#{@agent_state},-}\t#{pane_pid}\t#{?@agent_last_transition,#{@agent_last_transition},-}') |
    sort -t $'\t' -k1,1n -k2,2nr
}

# attn_cycle_target <next|prev> <current_pane>
# Prints 'sid<TAB>pane' of the attention-cycle target in attn_list order
# (rank asc, activity desc), wrapping at the boundaries. When the current
# pane is not in the list, next picks the first row and prev the last. An
# empty attention list prints nothing and exits 0 (non-error). Reuses
# attn_list; never enriches git/preview (xtmux-rib.25).
attn_cycle_target() {
  local dir="${1:-next}" current="${2:-}"
  local line n=0 i idx=-1 sid pane
  local -a rows=()
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    rows+=("$line")
  done < <(attn_list)
  n="${#rows[@]}"
  [ "$n" -gt 0 ] || return 0
  for ((i = 0; i < n; i++)); do
    IFS=$'\t' read -r _ _ _ pane <<< "${rows[$i]}"
    if [ "$pane" = "$current" ]; then idx=$i; break; fi
  done
  if [ "$idx" -ge 0 ]; then
    if [ "$dir" = prev ]; then
      idx=$(( (idx - 1 + n) % n ))
    else
      idx=$(( (idx + 1) % n ))
    fi
  elif [ "$dir" = prev ]; then
    idx=$(( n - 1 ))
  else
    idx=0
  fi
  IFS=$'\t' read -r _ _ sid pane <<< "${rows[$idx]}"
  printf '%s\t%s\n' "$sid" "$pane"
}

record_prev() {
  local cur_sid="${1:-}" cur_pane="${2:-}" current
  if [ -z "$cur_sid" ] || [ -z "$cur_pane" ]; then
    current="$(tmux display-message -p $'#{session_id}\t#{pane_id}' 2>/dev/null || true)"
    IFS=$'\t' read -r cur_sid cur_pane <<< "$current"
  fi
  [ -n "$cur_sid" ] && [ -n "$cur_pane" ] && tmux set -g @picker_prev "$cur_sid:$cur_pane" 2>/dev/null || true
}

attn_jump() {
  local n="${1:-1}" line sid pane
  line="$(attn_list | sed -n "${n}p")"
  if [ -z "$line" ]; then
    tmux display-message "tmux-picker: nessun agente in attesa #$n"
    return 0
  fi
  IFS=$'\t' read -r _ _ sid pane <<< "$line"
  jump_to_target pane "$sid" "$pane"
}

jump_back() {
  local prev sid pane
  prev="$(tmux show -gv @picker_prev 2>/dev/null || true)"
  if [ -z "$prev" ]; then
    tmux display-message 'tmux-picker: nessun pane precedente'
    return 0
  fi
  sid="${prev%%:*}"
  pane="${prev#*:}"
  jump_to_target pane "$sid" "$pane"
}

# ── nav verb family (xtmux-rib.25) ────────────────────────────────────────
# Direct commands: never build inventory, never call git/fzf. Session cycling
# uses tmux's OWN session order (switch-client -n/-p); window cycling uses the
# native next-window/previous-window operations; attention cycling reuses
# attn_list; back reuses the previous-target mechanism.

# nav_session_cycle <next|prev> — record the current target, then switch to
# the next/previous tmux session in tmux's own order.
nav_session_cycle() {
  local dir="${1:-next}"
  record_prev
  case "$dir" in
    next) tmux switch-client -n ;;
    prev) tmux switch-client -p ;;
  esac
}

# nav_window_cycle <next|prev> — record the current target, then move to the
# next/previous window in tmux's OWN window order within the current session.
# Syntax verified against tmux 3.5a (man tmux): both commands take an optional
# [-a] (move to the next window WITH AN ALERT) and [-t target-session]; with
# NO arguments they operate on the current client's session and wrap around
# ("Move to the next window in the session"). [-a] requires an alert-bearing
# window and errors otherwise, so the positional default is used here. This is
# a single native tmux call — it never builds the nav list, never runs git or
# fzf, and never enumerates sessions (§21).
nav_window_cycle() {
  local dir="${1:-next}"
  record_prev
  case "$dir" in
    next) tmux next-window ;;
    prev) tmux previous-window ;;
  esac
}

# nav_attention_cycle <next|prev> — record the current target, then jump to
# the adjacent row in the authoritative attention ordering (wrap, current
# pane absent, and empty list are all non-errors).
nav_attention_cycle() {
  local dir="${1:-next}"
  local current cur_sid cur target sid pane
  current="$(tmux display-message -p $'#{session_id}\t#{pane_id}' 2>/dev/null || true)"
  IFS=$'\t' read -r cur_sid cur <<< "$current"
  target="$(attn_cycle_target "$dir" "$cur")"
  if [ -z "$target" ]; then
    tmux display-message 'tmux-picker: nessun target di attenzione' 2>/dev/null || true
    return 0
  fi
  record_prev "$cur_sid" "$cur"
  IFS=$'\t' read -r sid pane <<< "$target"
  jump_to_target pane "$sid" "$pane"
}

# parse_nav_token <token> -> REPLY='type<TAB>sid<TAB>target'. IDs use tmux's
# immutable machine forms only; window names, indexes and general tmux target
# syntax never enter this path (§10/§11 — display text is not identity).
# Accepted grammar (anchored, no trailing junk):
#   s:$N            session
#   w:$N:@N         window (@N claimed to belong to $N; ownership revalidated
#                   against live tmux before any action)
#   p:$N:%N         pane (same ownership claim)
#   p:%N            legacy bare-pane shorthand: claims NO session, so the live
#                   owning session resolved at action time is the authority —
#                   ownership is still verified against tmux, there is just
#                   nothing to compare against (see resolve_nav_pane_session).
#                   Kept for the classic bulk-kill path and pre-existing
#                   contract tests; it cannot weaken safety because the pane
#                   must still resolve live.
parse_nav_token() {
  local tok="${1:-}"
  REPLY=''
  # machine tokens are pure printable ASCII — any control byte (tab, newline,
  # the rest of [:cntrl:]) is structurally rejected, independent of the regex
  # anchors, so an appended delimiter can never smuggle a partial match in.
  case "$tok" in *[[:cntrl:]]*) return 1 ;; esac
  if [[ "$tok" =~ ^s:(\$[0-9]+)$ ]]; then
    REPLY="session"$'\t'"${BASH_REMATCH[1]}"$'\t'
  elif [[ "$tok" =~ ^w:(\$[0-9]+):(@[0-9]+)$ ]]; then
    REPLY="window"$'\t'"${BASH_REMATCH[1]}"$'\t'"${BASH_REMATCH[2]}"
  elif [[ "$tok" =~ ^p:(\$[0-9]+):(%[0-9]+)$ ]]; then
    REPLY="pane"$'\t'"${BASH_REMATCH[1]}"$'\t'"${BASH_REMATCH[2]}"
  elif [[ "$tok" =~ ^p:(%[0-9]+)$ ]]; then
    REPLY="pane"$'\t-\t'"${BASH_REMATCH[1]}"
  else
    return 1
  fi
}

# resolve_nav_window_session <encoded-sid-or-empty> <window> -> REPLY=live sid.
# Resolves the exact @window_id occurrence against live tmux and proves the
# encoded session+window PAIR, not a bare @id (a window LINKED into several
# sessions makes a bare @id's owning session ambiguous). tmux `-t "$sid:@wid"`
# falls back to the session's current window when that winlink does NOT exist,
# so a single display-message reads BOTH #{session_id} and #{window_id} and both
# must match the claim (live session == encoded AND live window == claimed
# @wid). This rejects a link present elsewhere while accepting each real
# occurrence. Refuses (nonzero, no partial state) on any mismatch — a stale
# record must fail safely. Machine identity only: names/indexes never influence
# resolution. One display-message per action, never on the hot path.
resolve_nav_window_session() {
  local encoded="${1:-}" window="$2" live tgt
  if [ -n "$encoded" ]; then
    tgt="$encoded:$window"
    live="$(tmux display-message -p -t "$tgt" $'#{session_id}\t#{window_id}' 2>/dev/null || true)"
    local livewin
    IFS=$'\t' read -r live livewin <<< "$live"
    [ -n "$live" ] || return 1
    [ "$live" = "$encoded" ] || return 1
    [ "$livewin" = "$window" ] || return 1
  else
    live="$(tmux display-message -p -t "$window" '#{session_id}' 2>/dev/null || true)"
    live="${live%%$'\t'*}"
    [ -n "$live" ] || return 1
  fi
  REPLY="$live"
}

# resolve_nav_pane_session <encoded-sid-or-empty> <pane> -> REPLY=live sid.
# Proves the encoded session+pane occurrence without constructing
# `session:%pane`: tmux parses %N there as a window target and may
# silently fall back to the session's current pane. That can reject a
# valid NON-CURRENT pane. For an encoded session, enumerate that
# session's panes once and require exact %pane_id membership. This is
# action-time validation only; it is never part of the nav hot path.
resolve_nav_pane_session() {
  local encoded="${1:-}" pane="$2" live
  if [ -n "$encoded" ]; then
    live="$(tmux list-panes -s -t "$encoded" -F '#{pane_id}' 2>/dev/null || true)"
    case $'\n'"$live"$'\n' in
      *$'\n'"$pane"$'\n'*) REPLY="$encoded"; return 0 ;;
      *) return 1 ;;
    esac
  fi
  live="$(tmux display-message -p -t "$pane" '#{session_id}' 2>/dev/null || true)"
  live="${live%%$'\t'*}"
  [ -n "$live" ] || return 1
  REPLY="$live"
}
# nav_go <token> acts on hidden machine identity and records the previous target.
# §12: session -> record previous exact pane -> switch session. window ->
# validate @N belongs to $N -> record previous exact pane -> select exact @N.
# pane -> validate %N belongs to $N -> record previous exact pane -> select %N.
# Validation precedes record_prev so a stale token leaves no partial state.
nav_go() {
  local parsed type sid target
  parse_nav_token "${1:-}" || return 1
  parsed="$REPLY"
  IFS=$'\t' read -r type sid target <<< "$parsed"
  [ "$sid" = - ] && sid=''
  case "$type" in
    session)
      record_prev
      jump_to_target session "$sid" "$sid"
      ;;
    window)
      resolve_nav_window_session "$sid" "$target" || return 1
      sid="$REPLY"
      record_prev
      jump_to_target window "$sid" "$target"
      ;;
    pane)
      resolve_nav_pane_session "$sid" "$target" || return 1
      sid="$REPLY"
      record_prev
      jump_to_target pane "$sid" "$target"
      ;;
  esac
}

nav_help() {
  cat <<'EOF'
xtmux nav — operator navigation over tmux sessions, windows and attention targets.

usage:  xtmux nav                      open the interactive navigator (fzf)
        xtmux nav next                 switch to the next tmux session
        xtmux nav prev                 switch to the previous tmux session
        xtmux nav window-next          move to the next window of the current session
        xtmux nav window-prev          move to the previous window of the current session
        xtmux nav attention-next       cycle to the next attention target
        xtmux nav attention-prev       cycle to the previous attention target
        xtmux nav back                 return to the target recorded before the last jump
        xtmux nav help                 this reference

next/prev follow tmux's own session order (switch-client -n / -p) and
record the previous target so `back` can return. window-next/window-prev
invoke the native tmux next-window/previous-window operations (single tmux
call, no inventory, no fzf/git — verified syntax: no -t needed, current
client's session, wraps around). attention-next/prev cycle
the authoritative attention ordering (stale, needs-input, done); an empty
attention list is a non-error. back reuses the existing @picker_prev
mechanism. The nav family is interactive-only: --json is refused.

Machine tokens (hidden per record, never display text): s:$N session,
w:$N:@N window, p:$N:%N pane. Before any jump or action the claimed
$session_id is revalidated against live tmux (window: its live owning session;
pane: its live session); a stale or moved target fails safely with no state
change. In the drawer, window rows support go (Enter selects the exact
@window_id), rename window and kill window; pane-only actions (approve /
interrupt / message) on a window row are refused with a bounded message.
EOF
}

parse_wait_duration() {
  local raw="${1:-}" n unit
  [ -n "$raw" ] || { REPLY=0; return 0; }
  if [[ "$raw" =~ ^([0-9]+)([smhd]?)$ ]]; then
    n="${BASH_REMATCH[1]}"; unit="${BASH_REMATCH[2]}"
    case "$unit" in
      h) REPLY=$(( n * 3600 )) ;;
      m) REPLY=$(( n * 60 )) ;;
      d) REPLY=$(( n * 86400 )) ;;
      *) REPLY="$n" ;;
    esac
    return 0
  fi
  return 1
}

resolve_tmux_pane() {
  local target="${1:-}"
  [ -n "$target" ] || return 1
  REPLY="$(tmux display-message -p -t "$target" '#{pane_id}' 2>/dev/null || true)"
  [ -n "$REPLY" ]
}

observe_agent_state() {
  local pane="$1" raw cmd state
  raw="$(tmux show-options -p -t "$pane" -qv @agent_state 2>/dev/null || true)"
  if [ -n "$raw" ]; then
    normalize_agent_state "$pane" "$raw" ""; REPLY="$REPLY"; return 0
  fi
  # Fallback for panes without @agent_state: use the same opt-in inference as the
  # picker, scoped to this call. This is intentionally secondary because UI
  # markers are brittle across agent harnesses.
  cmd="$(tmux display-message -p -t "$pane" '#{pane_current_command}' 2>/dev/null || true)"
  if [ -n "$cmd" ]; then
    TMUX_PICKER_AGENT=1 normalize_agent_state "$pane" "" "$cmd"
    state="$REPLY"
    [ -n "$state" ] || state='unknown'
    REPLY="$state"
  else
    REPLY='unknown'
  fi
}

wait_agent() {
  local target='' timeout=0 interval=30 wait_for_transition=0 json=0 arg pane state start started_ms now elapsed armed=1
  while [ "$#" -gt 0 ]; do
    arg="$1"; shift
    case "$arg" in
      --wait-for-transition) wait_for_transition=1 ;;
      --timeout=*) parse_wait_duration "${arg#--timeout=}" || return 2; timeout="$REPLY" ;;
      --timeout) [ "$#" -gt 0 ] || return 2; parse_wait_duration "$1" || return 2; timeout="$REPLY"; shift ;;
      --interval=*) parse_wait_duration "${arg#--interval=}" || return 2; interval="$REPLY" ;;
      --interval) [ "$#" -gt 0 ] || return 2; parse_wait_duration "$1" || return 2; interval="$REPLY"; shift ;;
      --json) json=1 ;;
      -h|--help) return 2 ;;
      *) [ -z "$target" ] || return 2; target="$arg" ;;
    esac
  done
  [ -n "$target" ] || { command_error "$json" XTMUX_INVALID_ARGUMENT 'wait-agent: target required' wait-agent 2; return $?; }
  resolve_tmux_pane "$target" || { command_error "$json" XTMUX_TARGET_NOT_FOUND "wait-agent: target not found: $target" wait-agent 1; return $?; }
  pane="$REPLY"
  start="$(date +%s)"
  started_ms="$(date +%s%3N)"
  if [ "$wait_for_transition" = 1 ]; then
    observe_agent_state "$pane"
    agent_state_is_working "$REPLY" || armed=0
  fi
  while :; do
    observe_agent_state "$pane"; state="$REPLY"
    if [ "$armed" = 0 ]; then
      agent_state_is_working "$state" && armed=1
    elif ! agent_state_is_working "$state"; then
      if [ "$json" = 1 ]; then
        printf '{"target":"%s","sessionId":null,"paneId":"%s","state":"%s","status":"done","startedAtMs":%s,"completedAtMs":%s,"timeoutMs":%s,"intervalMs":%s}\n' \
          "$(json_escape "$target")" "$(json_escape "$pane")" "$(json_escape "$state")" "$started_ms" "$(date +%s%3N)" "$(( timeout * 1000 ))" "$(( interval * 1000 ))"
      else
        printf 'target=%s pane=%s state=%s\n' "$target" "$pane" "$state"
      fi
      return 0
    fi
    if [ "$timeout" -gt 0 ]; then
      now="$(date +%s)"; elapsed=$(( now - start ))
      if [ "$elapsed" -ge "$timeout" ]; then
        if [ "$json" = 1 ]; then
          json_error XTMUX_WAIT_TIMEOUT "wait-agent: timeout target=$target pane=$pane state=$state elapsed=${elapsed}s" wait-agent
        else
          printf 'wait-agent: timeout target=%s pane=%s state=%s elapsed=%ss\n' "$target" "$pane" "$state" "$elapsed" >&2
        fi
        return 124
      fi
    fi
    sleep "$interval"
  done
}

monitor_dir() {
  REPLY="${TMPDIR:-/tmp}/tmux-picker-state-${UID:-$(id -u)}/monitors"
}

monitor_file() {
  local id="${1:-}"
  monitor_dir
  REPLY="$REPLY/$id.tsv"
}

monitor_write_record() {
  local id="$1" pid="$2" target="$3" pane="$4" state="$5" start="$6" timeout="$7" interval="$8" updated="$9"
  local file tmp dir mode
  # Under XTMUX_OBS_V2=1 the monitors table is authoritative and the /tmp registry
  # is not written at all (xtmux-3xs.4: "no /tmp writes from the V2 monitor path").
  obs_v2_mode; mode="$REPLY"
  [ "$mode" = 'on' ] && return 0
  monitor_file "$id"; file="$REPLY"; dir="${file%/*}"
  mkdir -p "$dir" 2>/dev/null || true
  tmp="$file.tmp.$$"
  printf 'monitor\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$(tsv_clean "$id")" "$(tsv_clean "$pid")" "$(tsv_clean "$target")" "$(tsv_clean "$pane")" \
    "$(tsv_clean "$state")" "$(tsv_clean "$start")" "$(tsv_clean "$timeout")" "$(tsv_clean "$interval")" "$(tsv_clean "$updated")" \
    > "$tmp" && mv -f "$tmp" "$file"
}

monitor_run() {
  local id="$1" target="$2" pane="$3" timeout="$4" interval="$5" start="$6" wait_for_transition="${7:-0}" initial_state="${8:-}"
  local state now elapsed mode armed=1
  [ "$wait_for_transition" = 1 ] && ! agent_state_is_working "$initial_state" && armed=0
  obs_v2_mode; mode="$REPLY"
  cleanup_monitor() {
    local cleanup_id="$1" cleanup_mode="$2"
    # V2 keeps the row (it carries the terminal history); only the TSV goes.
    [ "$cleanup_mode" = 'on' ] || { monitor_file "$cleanup_id"; rm -f "$REPLY" 2>/dev/null || true; }
  }
  trap "cleanup_monitor '$id' '$mode'" EXIT INT TERM
  while :; do
    observe_agent_state "$pane"; state="$REPLY"
    now="$(date +%s)"
    monitor_write_record "$id" "$$" "$target" "$pane" "$state" "$start" "$timeout" "$interval" "$now"
    # A tick updates the row in place. It does not append a historical event —
    # that is the whole point of the phase.
    [ "$mode" = 'off' ] || obs_call monitor heartbeat --id "$id" --state "$state"
    if [ "$armed" = 0 ]; then
      agent_state_is_working "$state" && armed=1
    elif ! agent_state_is_working "$state"; then
      log_event monitor.done id="$id" target="$target" pane="$pane" state="$state"
      [ "$mode" = 'off' ] || obs_call monitor terminate --id "$id" --status done
      return 0
    fi
    if [ "$timeout" -gt 0 ]; then
      elapsed=$(( now - start ))
      if [ "$elapsed" -ge "$timeout" ]; then
        log_event monitor.timeout id="$id" target="$target" pane="$pane" state="$state" elapsed="$elapsed"
        [ "$mode" = 'off' ] || obs_call monitor terminate --id "$id" --status timeout
        return 124
      fi
    fi
    sleep "$interval"
  done
}

monitor_agent() {
  local target='' timeout=0 interval=30 wait_for_transition=0 json=0 arg pane state start id pid mode session
  while [ "$#" -gt 0 ]; do
    arg="$1"; shift
    case "$arg" in
      --wait-for-transition) wait_for_transition=1 ;;
      --timeout=*) parse_wait_duration "${arg#--timeout=}" || return 2; timeout="$REPLY" ;;
      --timeout) [ "$#" -gt 0 ] || return 2; parse_wait_duration "$1" || return 2; timeout="$REPLY"; shift ;;
      --interval=*) parse_wait_duration "${arg#--interval=}" || return 2; interval="$REPLY" ;;
      --interval) [ "$#" -gt 0 ] || return 2; parse_wait_duration "$1" || return 2; interval="$REPLY"; shift ;;
      --json) json=1 ;;
      -h|--help) return 2 ;;
      *) [ -z "$target" ] || return 2; target="$arg" ;;
    esac
  done
  [ -n "$target" ] || { command_error "$json" XTMUX_INVALID_ARGUMENT 'usage: monitor-agent <target> [--wait-for-transition] [--timeout 30m] [--interval 30s]' monitor-agent 2; return $?; }
  resolve_tmux_pane "$target" || { command_error "$json" XTMUX_TARGET_NOT_FOUND "monitor-agent: target not found: $target" monitor-agent 1; return $?; }
  pane="$REPLY"
  observe_agent_state "$pane"; state="$REPLY"
  start="$(date +%s)"
  id="m${start}-$(printf '%s' "$pane" | tr -cd '0-9A-Za-z')-$$"
  obs_v2_mode; mode="$REPLY"
  monitor_write_record "$id" "starting" "$target" "$pane" "$state" "$start" "$timeout" "$interval" "$start"
  current_tmux_session_id; session="$REPLY"
  if [ "$mode" != 'off' ]; then
    local register_args=(monitor register --id "$id" --target "$target" --pane "$pane" \
      --state "$state" --timeout "$timeout" --interval "$interval")
    [ -n "$session" ] && register_args+=(--session "$session")
    obs_call "${register_args[@]}"
  fi
  "$self" monitor-run "$id" "$target" "$pane" "$timeout" "$interval" "$start" "$wait_for_transition" "$state" >/dev/null 2>&1 &
  pid="$!"
  monitor_write_record "$id" "$pid" "$target" "$pane" "$state" "$start" "$timeout" "$interval" "$start"
  # The poller now has a PID: adopt it, so reconciliation can tell a crashed
  # monitor from one that simply has not ticked yet.
  [ "$mode" = 'off' ] || obs_call monitor adopt --id "$id" --pid "$pid"
  log_event monitor.started id="$id" pid="$pid" target="$target" pane="$pane" state="$state" timeout="$timeout" interval="$interval"
  if [ "$json" = 1 ]; then
    printf '{"monitorId":"%s","target":"%s","sessionId":%s,"paneId":"%s","state":"%s","startedAtMs":%s,"timeoutMs":%s,"intervalMs":%s}\n' \
      "$(json_escape "$id")" "$(json_escape "$target")" "$([ -n "$session" ] && printf '"%s"' "$(json_escape "$session")" || printf 'null')" \
      "$(json_escape "$pane")" "$(json_escape "$state")" "$(( start * 1000 ))" "$(( timeout * 1000 ))" "$(( interval * 1000 ))"
  else
    printf 'monitor\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$pid" "$target" "$pane" "$state" "$start" "$timeout" "$interval" "$start"
  fi
}

# _monitor_list_v1_body — V1 TSV scan of the monitor state dir; extracted so
# the shadow-tee path can capture stdout before diffing.
_monitor_list_v1_body() {
  local dir file line type id pid target pane state start timeout interval updated now
  monitor_dir; dir="$REPLY"
  [ -d "$dir" ] || return 0
  now="$(date +%s)"
  for file in "$dir"/*.tsv; do
    [ -e "$file" ] || continue
    IFS=$'\t' read -r type id pid target pane state start timeout interval updated < "$file" || continue
    if [ -n "$pid" ] && [ "$pid" != starting ] && ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$file" 2>/dev/null || true
      continue
    fi
    if [ -n "$pane" ]; then
      observe_agent_state "$pane"; state="$REPLY"
      monitor_write_record "$id" "$pid" "$target" "$pane" "$state" "$start" "$timeout" "$interval" "$now"
    fi
    printf 'monitor\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$pid" "$target" "$pane" "$state" "$start" "$timeout" "$interval" "$now"
  done | sort -t $'\t' -k6,6 -k2,2
}

monitor_list() {
  local json=0
  [ "${1:-}" = '--json' ] && json=1
  obs_v2_mode; local mode="$REPLY"
  # V2 authoritative: the table is the registry, and reconciliation of crashed
  # pollers happens inside the scan.
  if [ "$mode" = 'on' ]; then
    local args=(monitor list)
    [ "$json" = 1 ] && args+=(--json)
    obs_call_strict "${args[@]}"
    return "$?"
  fi
  if [ "$mode" = 'shadow' ]; then
    local v1_out v2_out=''
    v1_out="$(_monitor_list_v1_body)"
    if obs_available; then
      v2_out="$(obs_call_strict monitor list 2>/dev/null || true)"
    fi
    obs_shadow_diff monitors monitor-list content "$v1_out" "$v2_out"
    [ -n "$v1_out" ] && printf '%s\n' "$v1_out"
    return 0
  fi
  _monitor_list_v1_body
}

monitor_kill() {
  local id='' json=0 arg file type rid pid rest mode
  for arg in "$@"; do
    case "$arg" in --json) json=1 ;; --*) return 2 ;; *) [ -z "$id" ] || return 2; id="$arg" ;; esac
  done
  [ -n "$id" ] || { printf 'usage: monitor-kill <id>\n' >&2; return 2; }
  obs_v2_mode; mode="$REPLY"
  # V2 authoritative: the row is preserved with terminal_status=killed. V1 deleted
  # the TSV here, which is why a killed monitor left no history at all.
  if [ "$mode" = 'on' ]; then
    local args=(monitor kill --id "$id")
    [ "$json" = 1 ] && args+=(--json)
    obs_call_strict "${args[@]}"
    return "$?"
  fi
  monitor_file "$id"; file="$REPLY"
  [ -f "$file" ] || { printf 'monitor-kill: not found: %s\n' "$id" >&2; return 1; }
  IFS=$'\t' read -r type rid pid rest < "$file" || true
  if [ -n "${pid:-}" ] && [ "$pid" != starting ]; then kill "$pid" 2>/dev/null || true; fi
  rm -f "$file" 2>/dev/null || true
  log_event monitor.killed id="$id" pid="${pid:-}"
  [ "$mode" = 'off' ] || obs_call monitor terminate --id "$id" --status killed
  printf 'killed\t%s\n' "$id"
}

# monitors_view — human-scannable projection of monitor-list + obligations.
# Reads monitor-list --json (authoritative under V2), filters to non-terminal
# rows by default (`--all` shows everything), and prints one row per monitor as
# aligned columns so an operator can glance and see who is waiting on whom,
# how long, and how close to timeout each one is.
#
# ponytail: leans on the existing --json projection and jq; no new schema, no
# per-domain re-implementation. If jq is missing, we fall back to plain
# `monitor-list` TSV so the alias never blows up on minimal boxes.
monitors_view() {
  local show_all=0 json=0 from_file='' arg
  while [ $# -gt 0 ]; do
    case "$1" in
      --all) show_all=1 ;;
      --json) json=1 ;;
      # test hook: read monitor-list JSON from a file instead of shelling to
      # $self. Undocumented on purpose — only the formatter test uses it.
      --from-json) shift; from_file="${1:-}" ;;
      --from-json=*) from_file="${1#*=}" ;;
      -h|--help)
        cat <<'EOF'
usage: xtmux monitors [--all] [--json]
  Operator-scannable view of active monitors (target pane state, timeout progress,
  requester pane). By default hides monitors that have reached a terminal state;
  --all shows every row. --json passes through monitor-list --json unchanged.
EOF
        return 0
        ;;
      *) printf 'monitors: unknown flag: %s\n' "$1" >&2; return 2 ;;
    esac
    shift
  done
  # Reuse the picker's own `monitor-list` dispatch so we hit the same runtime
  # (compiled binary / bun / node launcher) and the same authoritative
  # projection as `xtmux monitor-list --json`. `--from-json` short-circuits
  # for tests.
  if [ "$json" = 1 ]; then
    if [ -n "$from_file" ]; then
      cat -- "$from_file"
      return $?
    fi
    # `exec` so stdout/stderr/exit propagate unaltered — this is a pure
    # passthrough over monitor-list --json.
    exec "$self" monitor-list --json
  fi
  if ! command -v jq >/dev/null 2>&1; then
    printf 'monitors: jq not found; falling back to `monitor-list`. install jq for the pretty view.\n' >&2
    "$self" monitor-list
    return $?
  fi
  local raw raw_err raw_rc
  if [ -n "$from_file" ]; then
    if ! raw="$(cat -- "$from_file" 2>/dev/null)"; then
      printf 'monitors: --from-json cannot read %s\n' "$from_file" >&2
      return 2
    fi
  else
    # Capture stderr and exit status separately so a backend failure surfaces
    # instead of masquerading as "no monitors" (Codex P2).
    raw_err="$(mktemp)"
    raw="$("$self" monitor-list --json 2>"$raw_err")" || raw_rc=$?
    raw_rc=${raw_rc:-0}
    if [ "$raw_rc" != 0 ]; then
      printf 'monitors: monitor-list failed (exit %s):\n' "$raw_rc" >&2
      cat "$raw_err" >&2
      rm -f "$raw_err"
      return "$raw_rc"
    fi
    rm -f "$raw_err"
  fi
  case "$raw" in ''|'[]') printf 'no monitors registered.\n'; return 0 ;; esac
  if [ "$show_all" = 0 ]; then
    local active_count
    active_count="$(printf '%s\n' "$raw" | jq -r '[.[] | select(.terminalStatus == null)] | length' 2>/dev/null || echo 0)"
    if [ "$active_count" = 0 ]; then
      printf 'no active monitors. add --all to see terminal rows.\n'
      return 0
    fi
  fi
  # Resolve session-name for target/requester on the fly. Names are best-effort
  # (a dead sid resolves to empty and we print the raw $sid). We build a
  # sid->name map from tmux once so we avoid a display-message call per row.
  local sidmap=''
  if command -v tmux >/dev/null 2>&1; then
    sidmap="$(tmux list-sessions -F '#{session_id}\t#{session_name}' 2>/dev/null || true)"
  fi
  local now_ms
  now_ms="$(date +%s%3N 2>/dev/null || printf '%s000' "$(date +%s)")"
  {
    printf 'STATE\tAGE\tTIMEOUT\tTARGET\tREQUESTER\tID\n'
    printf '%s\n' "$raw" | jq -r --arg all "$show_all" --arg now "$now_ms" --arg sidmap "$sidmap" '
      def fmt_dur(ms):
        (ms / 1000) as $s
        | if $s < 60 then "\($s|floor)s"
          elif $s < 3600 then "\(($s/60)|floor)m"
          elif $s < 86400 then "\(($s/3600)|floor)h"
          else "\(($s/86400)|floor)d" end;
      def name_of(sid):
        if sid == null or sid == "" then "-"
        else
          ($sidmap | split("\n")
           | map(select(length > 0) | split("\t") | {(.[0]): .[1]})
           | add // {}) as $m
          | ($m[sid] // sid)
        end;
      def target_label(row):
        (row.target // "-") as $t
        | (name_of($t)) as $tn
        | if row.paneId then "\($tn) (\(row.paneId))" else $tn end;
      def requester_label(row):
        if row.requesterSessionId == null then "-"
        else
          (name_of(row.requesterSessionId)) as $rn
          | if row.requesterPaneId then "\($rn) (\(row.requesterPaneId))" else $rn end
        end;
      def state_label(row):
        if row.terminalStatus != null then row.terminalStatus else (row.state // "?") end;
      def is_active(row): row.terminalStatus == null;
      map(select(($all == "1") or is_active(.)))
      | sort_by(-.startedAtMs)
      | .[]
      | [
          state_label(.),
          fmt_dur(($now|tonumber) - .startedAtMs),
          "\(fmt_dur(($now|tonumber) - .startedAtMs))/\(fmt_dur(.timeoutMs))",
          target_label(.),
          requester_label(.),
          (.monitorId // "?")
        ]
      | @tsv
    '
  } | awk -F '\t' '
    { for (i=1;i<=NF;i++) { if (length($i) > w[i]) w[i] = length($i); rows[NR,i] = $i }
      cols = NF; n = NR }
    END { for (r=1; r<=n; r++) {
            line = ""
            for (i=1; i<=cols; i++) {
              cell = rows[r,i]
              if (i < cols) line = line sprintf("%-*s  ", w[i], cell)
              else          line = line cell
            }
            print line
          } }
  '
}

handoff_default_file() {
  local target="${1:-target}" bead="${2:-bead}" safe
  safe="$(printf '%s-%s' "$target" "$bead" | tr -cs 'A-Za-z0-9._-' '-')"
  REPLY="${TMPDIR:-/tmp}/xtmux-handoff-${safe}.txt"
}

handoff_prompt_file_allowed() {
  local file="$1" real root
  case "$file" in /*) ;; *) return 1 ;; esac
  [ -f "$file" ] && [ -r "$file" ] || return 1
  real="$(realpath -e -- "$file" 2>/dev/null || readlink -f -- "$file" 2>/dev/null || true)"
  [ -n "$real" ] || return 1
  for root in "${TMPDIR:-/tmp}" "$PWD" "${XDG_STATE_HOME:-$HOME/.local/state}"; do
    root="$(realpath -m -- "$root" 2>/dev/null || printf '%s' "$root")"
    case "$real" in "$root"/*) return 0 ;; esac
  done
  return 1
}

# Readiness is a property of the AGENT INSTANCE, not of the pane.
#
# `log query` is a history query, so asking "does this pane have an agent.ready
# row?" answers yes for a pane whose PREVIOUS occupant readied and exited — and
# --wait-ready would then stop waiting and inject the pointer into a pane whose
# current agent has not finished initializing, which is precisely the failure
# readiness exists to prevent. Match the ready event against the pane's CURRENT
# @agent_instance_id (rotated on --new-instance by scripts/agent-state.sh).
#
# No instance id means no agent has claimed this pane at all: not ready, and never
# "ready by default".
handoff_ready_seen() {
  local pane="$1" out instance
  obs_available || return 1
  instance="$(tmux show-options -p -t "$pane" -qv @agent_instance_id 2>/dev/null || true)"
  [ -n "$instance" ] || return 1
  obs_runtime_argv
  out="$("${OBS_ARGV[@]}" log-query --type agent.ready --pane "$pane" --limit 50 --json 2>/dev/null || true)"
  printf '%s\n' "$out" | grep -F "\"instanceId\":\"$instance\"" >/dev/null 2>&1
}

handoff_wait_ready() {
  local target="$1" pane="$2" timeout="$3" json="$4" start now elapsed
  start="$(date +%s)"
  while :; do
    handoff_ready_seen "$pane" && return 0
    now="$(date +%s)"; elapsed=$(( now - start ))
    if [ "$timeout" -gt 0 ] && [ "$elapsed" -ge "$timeout" ]; then
      if [ "$json" = 1 ]; then
        json_error XTMUX_READY_TIMEOUT "handoff: agent.ready timeout target=$target pane=$pane elapsed=${elapsed}s" handoff
      else
        printf 'handoff: agent.ready timeout target=%s pane=%s elapsed=%ss\n' "$target" "$pane" "$elapsed" >&2
      fi
      return 124
    fi
    sleep 1
  done
}

handoff_v2() {
  local execute="$1" json="$2" target="$3" bead="$4" prompt_file="$5" wait_ready="$6" monitor="$7" handoff_key="$8" parent="$9" pane="${10}"; shift 10
  local target_session source_session monitor_id safe_key state create_out ready_timeout pointer
  handoff_prompt_file_allowed "$prompt_file" || {
    command_error "$json" XTMUX_PROMPT_FILE_REJECTED "handoff: prompt file must be readable existing file under local allowed path: $prompt_file" handoff 2
    return $?
  }
  current_tmux_session_id; source_session="$REPLY"
  resolve_to_session_id "$target" && target_session="$REPLY" || target_session=''
  # NOT a default. This used to substitute the literal string 'prompt-file' for a
  # missing --bead, which then landed in the durable handoff row AND in the journal
  # envelope's bead_id — a fabricated reference to a bead that does not exist,
  # indistinguishable downstream from a real one. A handoff whose contract nobody
  # can look up is not a handoff; the bead IS the contract, in both modes.
  [ -n "$bead" ] || { command_error "$json" XTMUX_INVALID_ARGUMENT 'handoff: --bead is required — the bead is the durable contract the target reads' handoff 2; return $?; }
  # Build and validate the pointer BEFORE anything durable is written.
  # handoff_prompt_file_allowed accepts a file under $PWD or XDG_STATE_HOME, but
  # safe_pointer_payload only accepts a payload referencing /tmp — so such a path
  # used to pass validation, create the durable handoff row, and only THEN have its
  # pointer rejected, leaving a handoff that claims a delegation nobody ever
  # attempted. Whatever we cannot deliver, we must not first record as delegated.
  pointer="leggi $prompt_file e seguilo. contratto durevole: bd show $bead. report finale nel bead."
  safe_pointer_payload "$pointer" >/dev/null 2>&1 || {
    command_error "$json" XTMUX_PROMPT_FILE_REJECTED "handoff: prompt file must live where a pointer may reference it (see safe-send-pointer rules): $prompt_file" handoff 2
    return $?
  }
  # Preflight target resolution and state before registering the durable handoff.
  # The actual send records a delivery_failed attempt if the target changes after
  # this check; failures before an attempt must not leave a created row behind.
  safe_send_pointer --dry-run "$target" "$pointer" >/dev/null 2>&1 || {
    command_error "$json" XTMUX_HANDOFF_DELIVERY_FAILED "handoff: pointer is not deliverable target=$target pane=$pane" handoff 1
    return $?
  }
  [ -n "$handoff_key" ] || handoff_key="ho-$(date +%s)-$$-${RANDOM}"
  safe_key="$(printf '%s' "$handoff_key" | tr -cs 'A-Za-z0-9._-' '-')"
  [ -n "$safe_key" ] || safe_key="ho-$(date +%s)-$$"
  monitor_id="hm-$safe_key"
  if [ "$execute" != 1 ]; then
    if [ "$json" = 1 ]; then
      printf '{"target":"%s","paneId":"%s","beadId":"%s","promptFile":"%s","handoffKey":"%s","monitorId":%s,"sent":false,"dryRun":true}\n' \
        "$(json_escape "$target")" "$(json_escape "$pane")" "$(json_escape "$bead")" "$(json_escape "$prompt_file")" "$(json_escape "$handoff_key")" \
        "$([ "$monitor" = 1 ] && printf '"%s"' "$(json_escape "$monitor_id")" || printf null)"
    else
      printf 'prompt-file\t%s\n' "$prompt_file"
      printf 'handoff-key\t%s\n' "$handoff_key"
      printf 'dry-run\tno durable writes or delivery\n'
    fi
    return 0
  fi
  obs_available || { command_error "$json" XTMUX_RUNTIME_UNAVAILABLE 'handoff: durable handoff requires V2 runtime' handoff 1; return $?; }
  obs_runtime_argv
  local create_args=(handoff create --id "$handoff_key" --key "$handoff_key" --target "$target" --target-pane "$pane" --bead "$bead" --prompt-file "$prompt_file")
  [ -n "$target_session" ] && create_args+=(--target-session "$target_session")
  [ -n "$source_session" ] && create_args+=(--source-session "$source_session")
  [ -n "$parent" ] && create_args+=(--parent-session "$parent")
  if [ "$monitor" = 1 ]; then
    create_args+=(--monitor-id "$monitor_id" --monitor-state waiting-ready --monitor-interval-ms 1000)
    [ "$wait_ready" -gt 0 ] && create_args+=(--monitor-timeout-ms "$((wait_ready * 1000))")
  fi
  # Keep the runtime's OWN structured error when it has one. Collapsing every
  # failure into XTMUX_HANDOFF_CREATE_FAILED throws away the only thing the caller
  # can act on: a reused idempotency key that names a different delegation
  # (XTMUX_HANDOFF_KEY_CONFLICT, exit 4) needs a new key, while a storage failure
  # needs a retry — and "durable registration failed" cannot tell them apart.
  local create_err
  create_err="$(mktemp)"
  create_out="$("${OBS_ARGV[@]}" "${create_args[@]}" 2>"$create_err")" || {
    local rc=$? err_body
    err_body="$(cat "$create_err" 2>/dev/null || true)"
    rm -f "$create_err"
    case "$err_body" in
      *'"code"'*) [ "$json" = 1 ] && printf '%s\n' "$err_body" >&2 || printf '%s\n' "$err_body" >&2 ;;
      *) if [ "$json" = 1 ]; then json_error XTMUX_HANDOFF_CREATE_FAILED 'handoff: durable registration failed' handoff; else printf '%s\n' "$err_body" >&2; fi ;;
    esac
    return "$rc"
  }
  rm -f "$create_err"
  if [ "$wait_ready" -gt 0 ]; then
    handoff_wait_ready "$target" "$pane" "$wait_ready" "$json" || {
      local ready_rc=$?
      if [ "$monitor" = 1 ]; then
        "${OBS_ARGV[@]}" monitor terminate --id "$monitor_id" --status timeout >/dev/null 2>&1 || true
      fi
      return "$ready_rc"
    }
  fi
  tmux set-option -p -t "$pane" -q @agent_bead "$bead" 2>/dev/null || true
  tmux set-option -p -t "$pane" -q @agent_prompt_file "$prompt_file" 2>/dev/null || true
  [ -n "$parent" ] && tmux set-option -p -t "$pane" -q @agent_parent_session "$parent" 2>/dev/null || true
  local delivery_rc=0
  set +e
  XTMUX_HANDOFF_ID="$handoff_key" safe_send_pointer --yes "$target" "$pointer" >/dev/null
  delivery_rc=$?
  set -e
  if [ "$delivery_rc" -ne 0 ]; then
    if [ "$json" = 1 ]; then
      json_error XTMUX_HANDOFF_DELIVERY_FAILED "handoff: pointer injection failed target=$target pane=$pane" handoff
    fi
    return "$delivery_rc"
  fi
  if [ "$json" = 1 ]; then
    printf '{"target":"%s","paneId":"%s","beadId":"%s","promptFile":"%s","handoffKey":"%s","monitorId":%s,"sent":true,"durable":true}\n' \
      "$(json_escape "$target")" "$(json_escape "$pane")" "$(json_escape "$bead")" "$(json_escape "$prompt_file")" "$(json_escape "$handoff_key")" \
      "$([ "$monitor" = 1 ] && printf '"%s"' "$(json_escape "$monitor_id")" || printf null)"
  fi
}

handoff() {
  local execute=0 json=0 target='' bead='' note='' file='' prompt_file='' wait_ready=0 monitor=0 handoff_key='' parent='' arg pane state bead_line pointer qtarget qpointer new_mode=0
  while [ "$#" -gt 0 ]; do
    arg="$1"; shift
    case "$arg" in
      --yes|--send) execute=1 ;;
      --dry-run) execute=0 ;;
      --json) json=1 ;;
      --target) [ "$#" -gt 0 ] || return 2; target="$1"; shift ;;
      --target=*) target="${arg#--target=}" ;;
      --bead) [ "$#" -gt 0 ] || return 2; bead="$1"; shift ;;
      --bead=*) bead="${arg#--bead=}" ;;
      --note) [ "$#" -gt 0 ] || return 2; note="$1"; shift ;;
      --note=*) note="${arg#--note=}" ;;
      --file) [ "$#" -gt 0 ] || return 2; file="$1"; shift ;;
      --file=*) file="${arg#--file=}" ;;
      --prompt-file) [ "$#" -gt 0 ] || return 2; prompt_file="$1"; shift; new_mode=1 ;;
      --prompt-file=*) prompt_file="${arg#--prompt-file=}"; new_mode=1 ;;
      --wait-ready) [ "$#" -gt 0 ] || return 2; parse_wait_duration "$1" || return 2; wait_ready="$REPLY"; new_mode=1; shift ;;
      --wait-ready=*) parse_wait_duration "${arg#--wait-ready=}" || return 2; wait_ready="$REPLY"; new_mode=1 ;;
      --monitor) monitor=1; new_mode=1 ;;
      --handoff-key) [ "$#" -gt 0 ] || return 2; handoff_key="$1"; new_mode=1; shift ;;
      --handoff-key=*) handoff_key="${arg#--handoff-key=}"; new_mode=1 ;;
      --parent) [ "$#" -gt 0 ] || return 2; parent="$1"; shift ;;
      --parent=*) parent="${arg#--parent=}" ;;
      -h|--help) return 2 ;;
      *) printf 'handoff: unknown arg: %s\n' "$arg" >&2; return 2 ;;
    esac
  done
  if [ "$new_mode" = 1 ]; then
    [ -n "$target" ] || { command_error "$json" XTMUX_INVALID_ARGUMENT 'usage: handoff --target <target> --prompt-file <path> [--wait-ready <dur>] [--monitor] [--yes]' handoff 2; return $?; }
    [ -n "$prompt_file" ] || { command_error "$json" XTMUX_INVALID_ARGUMENT 'handoff: --prompt-file required with readiness-aware flags' handoff 2; return $?; }
    resolve_tmux_pane "$target" || { command_error "$json" XTMUX_TARGET_NOT_FOUND "handoff: target not found: $target" handoff 1; return $?; }
    pane="$REPLY"
    handoff_v2 "$execute" "$json" "$target" "$bead" "$prompt_file" "$wait_ready" "$monitor" "$handoff_key" "$parent" "$pane"
    return $?
  fi
  [ -n "$target" ] && [ -n "$bead" ] || { command_error "$json" XTMUX_INVALID_ARGUMENT 'usage: handoff --target <pane/session> --bead <id> [--note text] [--file /tmp/x] [--yes]' handoff 2; return $?; }
  resolve_tmux_pane "$target" || { command_error "$json" XTMUX_TARGET_NOT_FOUND "handoff: target not found: $target" handoff 1; return $?; }
  pane="$REPLY"
  observe_agent_state "$pane"; state="$REPLY"
  if agent_state_is_working "$state"; then
    if [ "$json" = 1 ]; then
      json_error XTMUX_TARGET_WORKING "handoff: refused target=$target pane=$pane state=$state" handoff
    else
      printf 'handoff: refused target=%s pane=%s state=%s\n' "$target" "$pane" "$state" >&2
    fi
    return 75
  fi
  if command -v bd >/dev/null 2>&1; then
    bead_line="$(bd show "$bead" 2>/dev/null | head -1 || true)"
    [ -n "$bead_line" ] || { command_error "$json" XTMUX_BEAD_NOT_FOUND "handoff: bead not found: $bead" handoff 1; return $?; }
  else
    bead_line="$bead"
  fi
  [ -n "$file" ] || { handoff_default_file "$pane" "$bead"; file="$REPLY"; }
  mkdir -p "$(dirname "$file")" 2>/dev/null || true
  {
    printf 'bead: %s\n' "$bead"
    printf 'contract: bd show %s\n' "$bead"
    printf 'summary: %s\n' "$bead_line"
    [ -n "$parent" ] && printf 'parent-session: %s\n' "$parent"
    [ -n "$note" ] && { printf '\nmeta-protocol:\n'; printf '%s\n' "$note"; }
    printf '\nexpected-report:\n'
    printf '%s\n' '- read the bead as the durable task contract'
    printf '%s\n' '- update bead notes with findings/results'
    printf '%s\n' '- do not send multiline payloads over tmux; use this file as context'
  } > "$file"
  pointer="leggi $file e seguilo. contratto durevole: bd show $bead. report finale nel bead."
  safe_pointer_payload "$pointer" || return 2
  printf -v qtarget '%q' "$target"
  printf -v qpointer '%q' "$pointer"
  log_event handoff.created target="$target" pane="$pane" bead="$bead" prompt_file="$file" parent="$parent" state="$state"
  if [ "$json" != 1 ]; then
    printf 'prompt-file\t%s\n' "$file"
    printf 'bead\t%s\n' "$bead"
    printf 'pointer\t%s\n' "$pointer"
    printf 'command\t%s safe-send-pointer --yes %s %s\n' "$self" "$qtarget" "$qpointer"
  fi
  if [ "$execute" = 1 ]; then
    tmux set-option -p -t "$pane" -q @agent_bead "$bead" 2>/dev/null || true
    tmux set-option -p -t "$pane" -q @agent_prompt_file "$file" 2>/dev/null || true
    [ -n "$parent" ] && tmux set-option -p -t "$pane" -q @agent_parent_session "$parent" 2>/dev/null || true
    [ -n "$bead_line" ] && tmux set-option -p -t "$pane" -q @agent_task "$(tsv_clean "$bead_line")" 2>/dev/null || true
    log_event handoff.sent target="$target" pane="$pane" bead="$bead" prompt_file="$file" parent="$parent"
    safe_send_pointer --yes "$target" "$pointer" >/dev/null
  fi
  if [ "$json" = 1 ]; then
    printf '{"target":"%s","paneId":"%s","beadId":"%s","promptFile":"%s","sent":%s,"createdAtMs":%s}\n' \
      "$(json_escape "$target")" "$(json_escape "$pane")" "$(json_escape "$bead")" "$(json_escape "$file")" \
      "$([ "$execute" = 1 ] && printf true || printf false)" "$(date +%s%3N)"
  fi
}

safe_pointer_payload() {
  local payload="${1:-}"
  local force_freeform="${2:-0}"
  [ -n "$payload" ] || { printf 'safe-send-pointer: empty payload\n' >&2; return 1; }
  case "$payload" in *$'\n'*|*$'\r'*) printf 'safe-send-pointer: multiline payload rejected\n' >&2; return 1 ;; esac
  case "$payload" in *'`'*|*'$('*) printf 'safe-send-pointer: command substitution/backticks rejected\n' >&2; return 1 ;; esac
  if [ "$force_freeform" = 1 ]; then
    return 0                                # multi-line + shell-substitution guards still enforced above
  fi
  case "$payload" in
    /*) return 0 ;;                         # slash command, e.g. /compact
    *'/tmp/'*) return 0 ;;                  # pointer to prompt-file
    *) printf 'safe-send-pointer: payload must be a slash command or reference /tmp/<file> (use --force-freeform to bypass)\n' >&2; return 1 ;;
  esac
}

# Return 0 if the given pane is running a Claude Code process, 1 otherwise.
# Claude Code deterministically consumes the first Enter as paste-detection;
# other agents (pi, codex, raw shell) do not. Auto-detected here so
# safe-send-pointer / handoff callers do not need to know pane type.
# Is `claude` running anywhere in this process subtree? Bounded depth, first match
# wins — we are answering a yes/no question, not building an inventory.
pane_has_claude_descendant() {
  local pid="${1:-}" depth="${2:-0}" child comm
  [ -n "$pid" ] || return 1
  [ "$depth" -gt 0 ] || return 1
  for child in $(pgrep -P "$pid" 2>/dev/null || true); do
    comm="$(ps -o comm= -p "$child" 2>/dev/null || true)"
    case "${comm##*/}" in
      claude|claude-*) return 0 ;;
    esac
    pane_has_claude_descendant "$child" "$((depth - 1))" && return 0
  done
  return 1
}

pane_is_claude_code() {
  local pane="${1:-}" cmd='' pid=''
  [ -n "$pane" ] || return 1
  cmd="$(tmux display-message -p -t "$pane" '#{pane_current_command}' 2>/dev/null || true)"
  case "$cmd" in
    claude|claude-*|*/claude|*/claude-*) return 0 ;;
  esac
  # pane_current_command names only the FOREGROUND process. A pane launched with
  # `xt claude` runs a node wrapper (`node .../bin/xt claude`) which spawns claude
  # underneath it, so the pane reports `node` and this check used to miss — the
  # pane got double_enter=0, Claude Code's paste-detection ate the single Enter,
  # and the pointer sat in the input box, never submitted, while the sender was
  # told `sent`. A silent non-delivery is the worst failure this command can have,
  # so when the command name is inconclusive, look for claude in the subtree.
  #
  # Depth 3 covers the shapes we have: `claude` direct (1), `xt claude` wrapper
  # (2), and one extra level of shell nesting.
  pid="$(tmux display-message -p -t "$pane" '#{pane_pid}' 2>/dev/null || true)"
  pane_has_claude_descendant "$pid" 3
}

safe_send_pointer() {
  local execute=0 double_enter=-1 force_freeform=0 json=0 target='' payload='' reply_to='' fulfilment_json='' arg pane state qpane qpayload cmd
  while [ "$#" -gt 0 ]; do
    arg="$1"; shift
    case "$arg" in
      --yes|--send) execute=1 ;;
      --dry-run) execute=0 ;;
      --double-enter) double_enter=1 ;;
      --no-double-enter) double_enter=0 ;;
      --force-freeform) force_freeform=1 ;;
      --reply-to) [ "$#" -gt 0 ] || return 2; reply_to="$1"; shift ;;
      --reply-to=*) reply_to="${arg#--reply-to=}" ;;
      --json) json=1 ;;
      -h|--help) return 2 ;;
      --*) printf 'safe-send-pointer: unknown option: %s\n' "$arg" >&2; return 2 ;;
      *)
        if [ -z "$target" ]; then
          target="$arg"
        else
          payload+="${payload:+ }$arg"
        fi
        ;;
    esac
  done
  [ -n "$target" ] && [ -n "$payload" ] || { command_error "$json" XTMUX_INVALID_ARGUMENT 'usage: safe-send-pointer [--yes] [--double-enter|--no-double-enter] [--force-freeform] [--reply-to <messageKey>] <target> <slash-command|/tmp pointer>' safe-send-pointer 2; return $?; }
  if [ -n "$reply_to" ]; then
    obs_v2_mode
    [ "$REPLY" = on ] || { command_error "$json" XTMUX_JSON_REQUIRES_V2 'safe-send-pointer --reply-to requires XTMUX_OBS_V2=1' safe-send-pointer 2; return $?; }
  fi
  if [ "$json" = 1 ]; then
    safe_pointer_payload "$payload" "$force_freeform" 2>/dev/null || { command_error 1 XTMUX_POINTER_REJECTED 'safe-send-pointer: payload rejected' safe-send-pointer 2; return $?; }
  else
    safe_pointer_payload "$payload" "$force_freeform" || return 2
  fi
  resolve_tmux_pane "$target" || { command_error "$json" XTMUX_TARGET_NOT_FOUND "safe-send-pointer: target not found: $target" safe-send-pointer 1; return $?; }
  pane="$REPLY"
  observe_agent_state "$pane"; state="$REPLY"
  if agent_state_is_working "$state"; then
    if [ "$json" = 1 ]; then
      json_error XTMUX_TARGET_WORKING "safe-send-pointer: refused target=$target pane=$pane state=$state" safe-send-pointer
    else
      printf 'safe-send-pointer: refused target=%s pane=%s state=%s\n' "$target" "$pane" "$state" >&2
    fi
    return 75
  fi

  # Auto-double-Enter for Claude Code targets unless the caller explicitly opted out.
  # Codex/pi/raw-shell panes never get the auto second Enter.
  if [ "$double_enter" = -1 ]; then
    if pane_is_claude_code "$pane"; then double_enter=1; else double_enter=0; fi
  fi

  # --force-freeform without --yes prints a confirmation banner so the operator sees
  # exactly what is being bypassed before they re-run with --yes.
  if [ "$force_freeform" = 1 ] && [ "$execute" != 1 ] && [ "$json" != 1 ]; then
    printf 'safe-send-pointer: --force-freeform bypasses the slash/tmp payload check.\n'
    printf '  payload guards STILL enforced: no newlines, no `...`, no $(...).\n'
    printf '  Re-run with --yes to send. Target=%s state=%s double_enter=%s\n' "$target" "${state:-unknown}" "$double_enter"
  fi

  printf -v qpane '%q' "$pane"
  printf -v qpayload '%q' "$payload"
  if [ "$json" != 1 ]; then
    printf 'tmux send-keys -t %s %s Enter\n' "$qpane" "$qpayload"
    if [ "$double_enter" = 1 ]; then
      printf '# followed by second Enter after 2s (Claude Code paste-detection auto-double-Enter)\n'
    fi
  fi
  if [ "$execute" = 1 ]; then
    local send_rc=0 second_rc=0
    set +e
    tmux send-keys -t "$pane" "$payload" Enter
    send_rc=$?
    if [ "$send_rc" = 0 ] && [ "$double_enter" = 1 ]; then
      sleep 2
      tmux send-keys -t "$pane" Enter
      second_rc=$?
      [ "$second_rc" = 0 ] || send_rc="$second_rc"
    fi
    set -e
    current_tmux_session_id; _from_session="$REPLY"
    obs_v2_mode; local send_mode="$REPLY"
    local target_sid='' summary
    resolve_to_session_id "$target" && target_sid="$REPLY" || target_sid="$target"
    summary="$(printf '%s' "$payload" | head -c 80)"
    if [ -n "${XTMUX_HANDOFF_ID:-}" ] && [ "$send_mode" = 'on' ]; then
      obs_runtime_argv
      safe_pointer_obs_call handoff attempt --id "$XTMUX_HANDOFF_ID" --summary "$summary" \
        --succeeded "$([ "$send_rc" = 0 ] && printf true || printf false)" \
        $([ "$send_rc" = 0 ] || printf '%s' '--failure-code target_gone') >/dev/null || true
    elif [ "$send_mode" = 'on' ]; then
      # V2: pane pointer is a DELIVERY attempt, not a durable message.
      obs_runtime_argv
      safe_pointer_obs_call delivery-record \
        --kind pane_pointer --source-session "${_from_session:-unknown}" \
        --target-session "$target_sid" --target-pane "$pane" --summary "$summary" \
        --succeeded "$([ "$send_rc" = 0 ] && printf true || printf false)" >/dev/null || true
    else
      log_event message.sent via=safe-send-pointer from="${_from_session:-unknown}" to="$target" pane="$pane" text="$payload" state="${state:-unknown}" double_enter="$double_enter" force_freeform="$force_freeform"
    fi
    if [ "$send_rc" != 0 ]; then
      command_error "$json" XTMUX_DELIVERY_FAILED 'safe-send-pointer: tmux injection failed; reply not fulfilled' safe-send-pointer 1
      return $?
    fi
    if [ -n "$reply_to" ]; then
      obs_runtime_argv
      local reply_args=(message-reply --in-reply-to "$reply_to" --text "$payload")
      [ "$json" = 1 ] && reply_args+=(--json)
      fulfilment_json="$(safe_pointer_obs_call "${reply_args[@]}")" || return $?
      [ "$json" = 1 ] || printf '%s' "$fulfilment_json"
    fi
    [ "$json" = 1 ] || printf 'sent target=%s pane=%s state=%s double_enter=%s\n' "$target" "$pane" "${state:-unknown}" "$double_enter"
  fi
  if [ "$json" = 1 ]; then
    if [ -n "$reply_to" ] && [ "$execute" = 1 ]; then
      printf '{"injection":{"target":"%s","paneId":"%s","state":"%s","doubleEnter":%s,"sent":true},"fulfilment":%s}\n' \
        "$(json_escape "$target")" "$(json_escape "$pane")" "$(json_escape "${state:-unknown}")" \
        "$([ "$double_enter" = 1 ] && printf true || printf false)" "$fulfilment_json"
    else
      printf '{"target":"%s","paneId":"%s","state":"%s","doubleEnter":%s,"sent":%s}\n' \
        "$(json_escape "$target")" "$(json_escape "$pane")" "$(json_escape "${state:-unknown}")" \
        "$([ "$double_enter" = 1 ] && printf true || printf false)" "$([ "$execute" = 1 ] && printf true || printf false)"
    fi
  fi
}

preview_field() {
  local label="$1" value="${2:-}"
  [ -n "$value" ] || return 0
  printf '  %-9s %s\n' "$label" "$value"
}

preview_session_row() {
  local sid="$1" name="$2" pane_path root root_name hdr attached window_count panes_raw pane_count
  local line window_index window_name pane_id pane_index pane_active pane_cmd pane_row_path pane_width pane_height pane_left pane_top pane_state pane_pid
  local meta_bead meta_task meta_prompt meta_parent meta_last rank best=4 best_line='' session_state bead sp_view_state
  pane_path="$(tmux display-message -p -t "$sid" '#{pane_current_path}' 2>/dev/null || true)"
  pane_path="${pane_path:-$HOME}"
  hdr="$(tmux display-message -p -t "$sid" $'#{session_attached}\t#{session_windows}' 2>/dev/null || true)"
  IFS=$'\t' read -r attached window_count <<< "$hdr"
  panes_raw="$(tmux list-panes -s -t "$sid" -F $'#{window_index}\t#{window_name}\t#{pane_id}\t#{pane_index}\t#{pane_active}\t#{pane_current_command}\t#{pane_current_path}\t#{pane_width}\t#{pane_height}\t#{pane_left}\t#{pane_top}\t#{?@agent_state,#{@agent_state},-}\t#{pane_pid}\t#{?@agent_bead,#{@agent_bead},-}\t#{?@agent_task,#{@agent_task},-}\t#{?@agent_prompt_file,#{@agent_prompt_file},-}\t#{?@agent_parent_session,#{@agent_parent_session},-}\t#{?@agent_last_transition,#{@agent_last_transition},-}' 2>/dev/null || true)"
  pane_count=0
  while IFS= read -r line; do
    IFS=$'\t' read -r window_index window_name pane_id pane_index pane_active pane_cmd pane_row_path pane_width pane_height pane_left pane_top pane_state pane_pid meta_bead meta_task meta_prompt meta_parent meta_last <<< "$line"
    [ -n "$pane_id" ] || continue
    pane_count=$((pane_count + 1))
    normalize_agent_state "$pane_id" "$pane_state" "$pane_cmd" "$meta_last"; pane_state="$REPLY"
    agent_rank "$pane_state"; rank="$REPLY"
    if [ -z "$best_line" ] || [ "$rank" -lt "$best" ]; then best="$rank"; best_line="$line"; fi
  done <<< "$panes_raw"
  attn_state_name "$best"; session_state="$REPLY"
  git_root_for_path "$pane_path"; root="$REPLY"; root_name="${root:+${root##*/}}"

  line="$best_line"
  IFS=$'\t' read -r window_index window_name pane_id pane_index pane_active pane_cmd pane_row_path pane_width pane_height pane_left pane_top pane_state pane_pid meta_bead meta_task meta_prompt meta_parent meta_last <<< "$line"
  agent_meta_value "$meta_bead"; meta_bead="$REPLY"
  agent_meta_value "$meta_task"; meta_task="$REPLY"
  agent_meta_value "$meta_prompt"; meta_prompt="$REPLY"
  agent_meta_value "$meta_parent"; meta_parent="$REPLY"
  agent_meta_value "$meta_last"; meta_last="$REPLY"
  bead="$meta_bead"
  if [ -z "$bead" ]; then derive_bead_id "$name" "$pane_path" "$root"; bead="$REPLY"; fi

  printf 'SESSION\n'
  preview_field name "$name"
  preview_field state "$session_state"
  preview_field repo "$root_name"
  preview_field windows "${window_count:-?}"
  preview_field panes "$pane_count"
  preview_field attached "${attached:-0}"

  if [ -n "$pane_id" ]; then
    printf '\nAGENT\n'
    preview_field pane "$pane_id"
    preview_field window "$window_index:$window_name.$pane_index"
    preview_field geometry "${pane_width}x${pane_height}+${pane_left}+${pane_top}"
    preview_field runtime "${pane_cmd:-shell}"
    preview_field bead "$bead"
    preview_field task "$meta_task"
    preview_field prompt "$meta_prompt"
    preview_field parent "$meta_parent"
    preview_field last "$meta_last"
    sp_meta "$name" "$pane_pid"
    if [ -n "$sp_role" ]; then
      sp_view_state="${sp_state:-${sp_stale:+stale}}"
      preview_field specialist "$sp_role"
      preview_field sp-state "${sp_view_state:-unknown}"
    fi
    bead_preview_summary "$pane_path" "$bead"
  fi

  printf '\nWORKTREE\n'
  preview_field path "$pane_path"
  if [ -n "$root" ]; then
    printf '\nGIT\n'
    git_worktree_preview "$root"
  fi

  printf '\n──────────────────────────────────\n'
  while IFS=$'\t' read -r window_index window_name pane_id pane_index pane_active pane_cmd pane_row_path pane_width pane_height pane_left pane_top pane_state pane_pid meta_bead meta_task meta_prompt meta_parent meta_last; do
    [ -n "$pane_id" ] || continue
    printf 'PANE %s  %s:%s.%s\n' "$pane_id" "$window_index" "$window_name" "$pane_index"
    capture_pane_safe "$pane_id" -8
    printf '\n'
  done <<< "$panes_raw"
}

preview_pane_row() {
  local sid="$1" name="$2" target_pane="$3" pinfo pane_path pane_cmd window_line pane_state pane_pid pane_width pane_height pane_left pane_top
  local meta_bead meta_task meta_prompt meta_parent meta_last root root_name attached bead sp_view_state
  pinfo="$(tmux display-message -p -t "$target_pane" $'#{pane_current_path}\t#{pane_current_command}\t#I:#W\t#{pane_width}\t#{pane_height}\t#{pane_left}\t#{pane_top}\t#{?@agent_state,#{@agent_state},-}\t#{pane_pid}\t#{?@agent_bead,#{@agent_bead},-}\t#{?@agent_task,#{@agent_task},-}\t#{?@agent_prompt_file,#{@agent_prompt_file},-}\t#{?@agent_parent_session,#{@agent_parent_session},-}\t#{?@agent_last_transition,#{@agent_last_transition},-}' 2>/dev/null || true)"
  IFS=$'\t' read -r pane_path pane_cmd window_line pane_width pane_height pane_left pane_top pane_state pane_pid meta_bead meta_task meta_prompt meta_parent meta_last <<< "$pinfo"
  pane_path="${pane_path:-$HOME}"
  normalize_agent_state "$target_pane" "$pane_state" "$pane_cmd" "$meta_last"; pane_state="$REPLY"
  git_root_for_path "$pane_path"; root="$REPLY"; root_name="${root:+${root##*/}}"
  attached="$(tmux display-message -p -t "$sid" '#{session_attached}' 2>/dev/null || true)"
  agent_meta_value "$meta_bead"; meta_bead="$REPLY"
  agent_meta_value "$meta_task"; meta_task="$REPLY"
  agent_meta_value "$meta_prompt"; meta_prompt="$REPLY"
  agent_meta_value "$meta_parent"; meta_parent="$REPLY"
  agent_meta_value "$meta_last"; meta_last="$REPLY"
  bead="$meta_bead"
  if [ -z "$bead" ]; then derive_bead_id "$name" "$pane_path" "$root"; bead="$REPLY"; fi

  printf 'SESSION\n'
  preview_field name "$name"
  preview_field repo "$root_name"
  preview_field attached "${attached:-0}"

  printf '\nAGENT\n'
  preview_field pane "$target_pane"
  preview_field window "$window_line"
  preview_field geometry "${pane_width}x${pane_height}+${pane_left}+${pane_top}"
  preview_field runtime "${pane_cmd:-shell}"
  preview_field state "$pane_state"
  preview_field bead "$bead"
  preview_field task "$meta_task"
  preview_field prompt "$meta_prompt"
  preview_field parent "$meta_parent"
  preview_field last "$meta_last"
  sp_meta "$name" "$pane_pid"
  if [ -n "$sp_role" ]; then
    sp_view_state="${sp_state:-${sp_stale:+stale}}"
    preview_field specialist "$sp_role"
    preview_field sp-state "${sp_view_state:-unknown}"
  fi
  bead_preview_summary "$pane_path" "$bead"

  printf '\nWORKTREE\n'
  preview_field path "$pane_path"
  if [ -n "$root" ]; then
    printf '\nGIT\n'
    git_worktree_preview "$root"
  fi
  printf '\n──────────────────────────────────\n'
  capture_pane_safe "$target_pane" -48
}

preview_window_row() {
  local sid="$1" name="$2" wid="$3"
  local panes_raw line window_id window_index window_name window_active pane_id pane_index pane_active pane_cmd pane_row_path pane_width pane_height pane_left pane_top pane_state pane_pid
  local wname windex wactive wcount state rank best=4 best_line=''
  local meta_bead meta_task meta_prompt meta_parent meta_last
  panes_raw="$(tmux list-panes -s -t "$sid" -F $'#{window_id}\t#{window_index}\t#{window_name}\t#{window_active}\t#{pane_id}\t#{pane_index}\t#{pane_active}\t#{pane_current_command}\t#{pane_current_path}\t#{pane_width}\t#{pane_height}\t#{pane_left}\t#{pane_top}\t#{?@agent_state,#{@agent_state},-}\t#{pane_pid}\t#{?@agent_bead,#{@agent_bead},-}\t#{?@agent_task,#{@agent_task},-}\t#{?@agent_prompt_file,#{@agent_prompt_file},-}\t#{?@agent_parent_session,#{@agent_parent_session},-}\t#{?@agent_last_transition,#{@agent_last_transition},-}' 2>/dev/null || true)"
  wcount=0
  while IFS= read -r line; do
    IFS=$'\t' read -r window_id window_index window_name window_active pane_id pane_index pane_active pane_cmd pane_row_path pane_width pane_height pane_left pane_top pane_state pane_pid meta_bead meta_task meta_prompt meta_parent meta_last <<< "$line"
    [ -n "$pane_id" ] || continue
    [ "$window_id" = "$wid" ] || continue
    wcount=$((wcount + 1)); windex="$window_index"; wname="$window_name"; wactive="$window_active"
    normalize_agent_state "$pane_id" "$pane_state" "$pane_cmd" "$meta_last"; pane_state="$REPLY"
    agent_rank "$pane_state"; rank="$REPLY"
    if [ -z "$best_line" ] || [ "$rank" -lt "$best" ]; then best="$rank"; best_line="$line"; fi
  done <<< "$panes_raw"
  attn_state_name "$best"; state="$REPLY"

  printf 'WINDOW\n'
  preview_field id "$wid"
  preview_field index "${windex:-?}"
  preview_field name "$wname"
  preview_field active "${wactive:-0}"
  preview_field panes "$wcount"
  preview_field state "$state"
  printf '\nSESSION\n'
  preview_field name "$name"

  local pane_line
  while IFS= read -r pane_line; do
    IFS=$'\t' read -r _window_id _ _ _ pane_id pane_index pane_active pane_cmd pane_row_path pane_width pane_height pane_left pane_top pane_state pane_pid meta_bead meta_task meta_prompt meta_parent meta_last <<< "$pane_line"
    [ -n "$pane_id" ] || continue
    [ "$_window_id" = "$wid" ] || continue
    printf '\nPANE %s  %s:%s.%s\n' "$pane_id" "${windex:-?}" "${wname:-?}" "$pane_index"
    printf '  %-9s %s\n' runtime "${pane_cmd:-shell}"
    printf '  %-9s %s\n' path "${pane_row_path:-}"
    capture_pane_safe "$pane_id" -8
    printf '\n'
  done <<< "$panes_raw"
}

preview_row() {
  local type="${1:-}"
  local sid="${2:-}"
  local name="${3:-}"
  local target="${4:-}"

  if [ "$type" = 'header' ]; then
    printf 'specialists (sp-*)\n\nreal tmux sessions from specialists are grouped here so normal interactive sessions stay at the top.\n'
    return 0
  fi
  [ -n "$sid" ] || return 0
  case "$type" in
    pane) preview_pane_row "$sid" "$name" "$target" ;;
    window) preview_window_row "$sid" "$name" "$target" ;;
    *) preview_session_row "$sid" "$name" ;;
  esac
}

open_popup_client() {
  local type="$1"
  local sid="$2"
  local target="$3"

  if [ "$type" = 'header' ] || [ -z "$sid" ]; then
    return 0
  fi

  # the detached-client popup selects the exact @window_id / %pane_id with the
  # same attach+select machinery every row type already uses
  if [ "$type" = 'window' ] && [ -n "$target" ]; then
    exec env -u TMUX tmux attach-session -t "$sid" \; select-window -t "$target"
  fi

  if [ "$type" = 'pane' ] && [ -n "$target" ]; then
    exec env -u TMUX tmux attach-session -t "$sid" \; select-window -t "$target" \; select-pane -t "$target"
  fi

  exec env -u TMUX tmux attach-session -t "$sid"
}

jump_to_target() {
  local type="$1"
  local sid="$2"
  local target="$3"

  if [ "$type" = 'header' ] || [ -z "$sid" ]; then
    return 0
  fi

  # window: MOVE THE INVOKING CLIENT to the encoded session and select the exact
  # @window occurrence there. select-window alone only picks the target session's
  # current winlink without reattaching the operator, so a cross-session row would
  # leave them behind; switch-client first, then select the exact @wid in that
  # session (ownership was already validated against live tmux by the caller).
  if [ "$type" = 'window' ] && [ -n "$target" ]; then
    exec tmux switch-client -t "$sid" \; select-window -t "$target"
  fi

  if [ "$type" = 'pane' ] && [ -n "$target" ]; then
    exec tmux switch-client -t "$sid" \; select-window -t "$target" \; select-pane -t "$target"
  fi

  exec tmux switch-client -t "$sid"
}

kill_confirm() {
  local sid="${1:-}"
  local answer="${2:-}"

  [ -n "$sid" ] || return 1
  case "$answer" in
    y|Y|yes|YES|Yes)
      tmux kill-session -t "$sid"
      tmux display-message "tmux-picker: sessione uccisa $sid" 2>/dev/null || true
      ;;
    *)
      tmux display-message "tmux-picker: kill annullato" 2>/dev/null || true
      ;;
  esac
}

bulk_kill_confirm() {
  local answer="${1:-}" sid killed=0
  shift || true

  case "$answer" in
    y|Y|yes|YES|Yes) ;;
    *) tmux display-message "tmux-picker: bulk kill annullato" 2>/dev/null || true; return 0 ;;
  esac

  for sid in "$@"; do
    [ -n "$sid" ] || continue
    tmux kill-session -t "$sid" 2>/dev/null && killed=$((killed + 1))
  done
  tmux display-message "tmux-picker: sessioni uccise $killed" 2>/dev/null || true
}

bulk_kill() {
  local tok parsed type sid target i panes=0 _sep
  local -a sessions=() windows=() pane_targets=() confirm_cmd=()

  # Validate the complete selection before any mutation. One malformed or stale
  # token rejects the request instead of producing a partial destructive action.
  for tok in "$@"; do
    parse_nav_token "$tok" || return 1
    parsed="$REPLY"
    IFS=$'\t' read -r type sid target <<< "$parsed"
    [ "$sid" = - ] && sid=''
    case "$type" in
      session)
        tmux has-session -t "$sid" 2>/dev/null || return 1
        sessions+=("$sid")
        ;;
      window)
        resolve_nav_window_session "$sid" "$target" || return 1
        windows+=("$target")
        ;;
      pane)
        resolve_nav_pane_session "$sid" "$target" || return 1
        pane_targets+=("$target")
        ;;
    esac
  done

  for pane in "${pane_targets[@]}"; do
    tmux kill-pane -t "$pane" 2>/dev/null && panes=$((panes + 1))
  done
  if [ "${#sessions[@]}" -gt 0 ] || [ "${#windows[@]}" -gt 0 ]; then
    # confirm-before executes tmux commands directly. Session/window IDs never
    # cross a shell or command-prompt substitution boundary.
    confirm_cmd=(confirm-before -p "kill ${#sessions[@]} session(s) and ${#windows[@]} window(s)? [y/N]")
    _sep=1
    for _sid in "${sessions[@]}"; do
      [ "$_sep" = 0 ] && confirm_cmd+=(';')
      confirm_cmd+=(kill-session -t "$_sid"); _sep=0
    done
    for _wid in "${windows[@]}"; do
      [ "$_sep" = 0 ] && confirm_cmd+=(';')
      confirm_cmd+=(kill-window -t "$_wid"); _sep=0
    done
    tmux "${confirm_cmd[@]}"
  elif [ "$panes" -gt 0 ]; then
    tmux display-message "tmux-picker: pane uccisi $panes" 2>/dev/null || true
  fi
}

# bulk_kill_targets adapts classic hidden target field 4 to strict tokens.
# Rendered display text never enters this command.
bulk_kill_targets() {
  local target
  local -a tokens=()
  for target in "$@"; do
    if [[ "$target" =~ ^\$[0-9]+$ ]]; then
      tokens+=("s:$target")
    elif [[ "$target" =~ ^%[0-9]+$ ]]; then
      tokens+=("p:$target")
    else
      return 1
    fi
  done
  bulk_kill "${tokens[@]}"
}

kill_target() {
  local type="$1"
  local sid="$2"
  local target="$3"
  local sname

  if [ "$type" = 'pane' ] && [ -n "$target" ]; then
    tmux kill-pane -t "$target"
    return 0
  fi

  # a window holds multiple panes, so it is confirmed like a session, never
  # killed silently. The exact @window_id is the target; the name never is.
  if [ "$type" = 'window' ] && [ -n "$target" ]; then
    tmux confirm-before -p "kill window $target? [y/N]" kill-window -t "$target"
    return 0
  fi

  [ -n "$sid" ] || return 1
  sname="$(tmux display-message -p -t "$sid" '#S' 2>/dev/null || printf '%s' "$sid")"
  tmux confirm-before -p "kill session ${sname:-$sid}? [y/N]" kill-session -t "$sid"
}

# rename_target / rename_apply were called by the dispatcher and by the Alt-R
# fzf binding but never existed: both exited 127 ("command not found"), so the
# advertised inline rename has never worked. The contract tests for them failed
# on every run, in a subshell that swallowed the count (xtmux-d0a.19).
#
# rename_target prompts; rename_apply performs. Splitting them is what lets the
# tmux command-prompt hand the typed name back through `run-shell`.
rename_apply() {
  local type="${1:-}" handle="${2:-}" name="${3:-}"

  [ -n "$type" ] && [ -n "$handle" ] || return 1
  # An empty name is a cancelled prompt, not a request to blank the name.
  if [ -z "$name" ]; then
    tmux display-message 'tmux-picker: rename annullato' 2>/dev/null || true
    return 0
  fi

  case "$type" in
    session) tmux rename-session -t "$handle" "$name" ;;
    # a pane row renames the window that holds it — panes have no name of their
    # own; a window row renames the exact @window_id directly
    pane|window) tmux rename-window -t "$handle" "$name" ;;
    *)       return 1 ;;
  esac
}

# The tmux command that command-prompt runs with %1 replaced by the typed name.
# Split out from rename_target so it can be tested without an attached client.
#
# It renames with tmux's OWN commands and never reaches /bin/sh. The obvious
# spelling routes the name through `run-shell '... rename-apply %1'`, and that is
# a free-text field going through an unquoted shell expansion: tmux substitutes
# the text, then sh word-splits it, so "new sprint board" arrives as "new" and a
# name containing `;` or `$(...)` is EXECUTED. Quoting %1 for sh would only move
# the hole (an apostrophe in the name reopens it). With no shell in the path,
# tmux performs no command substitution and the name is inert text.
#
# %1 is single-quoted at the tmux parse level so spaces stay in one argument.
# A typed apostrophe makes tmux fail to parse — it renames nothing and reports a
# parse error. That is a safe failure, not an executed one.
rename_prompt_command() {
  local type="${1:-}" handle="${2:-}"
  [ -n "$handle" ] || return 1
  case "$type" in
    # a pane row renames the window that holds it; a window row renames itself
    pane|window) printf "rename-window -t '%s' '%%1'" "$handle" ;;
    session) printf "rename-session -t '%s' '%%1'" "$handle" ;;
    *) return 1 ;;
  esac
}

prompt_line() {
  local prompt="$1" initial="${2:-}" value
  [ -r /dev/tty ] || return 1
  IFS= read -e -i "$initial" -p "$prompt" value < /dev/tty > /dev/tty || return 1
  REPLY="$value"
}

rename_target() {
  local type="${1:-}" sid="${2:-}" target="${3:-}" handle current
  case "$type" in
    pane|window) handle="$target"; current="$(tmux display-message -p -t "$target" '#W' 2>/dev/null || true)" ;;
    session) handle="$sid"; current="$(tmux display-message -p -t "$sid" '#S' 2>/dev/null || true)" ;;
    *) return 1 ;;
  esac
  [ -n "$handle" ] || return 1
  prompt_line "rename $type: " "$current" || return 0
  rename_apply "$type" "$handle" "$REPLY"
}

# act_on_target <type> <sid> <target> <action>
# act on a pane from the list without attaching. no-op on session rows (only
# pane rows carry a usable target). cross-session safe: send-keys -t <pane>.
# actions:
#   approve   -> send 'y Enter'         (yes to a waiting agent permission)
#   interrupt -> send 'C-c'             (cancel the current turn)
#   message   -> prompt the operator for a one-line message, send it + Enter
act_on_target() {
  local type="$1"
  local sid="$2"
  local target="$3"
  local action="$4"
  local toast

  # session rows have no pane target to act on. this guard keeps the binds safe
  # when the highlight lands on a session line.
  if [ "$type" != 'pane' ] || [ -z "$target" ]; then
    tmux display-message "tmux-picker: nessun pane su cui agire (riga sessione)"
    return 0
  fi

  case "$action" in
    approve)
      tmux send-keys -t "$target" 'y' Enter
      toast="approvato $target"
      ;;
    interrupt)
      tmux send-keys -t "$target" C-c
      toast="interrotto $target"
      ;;
    message)
      prompt_line 'invia: ' '' || return 0
      tmux send-keys -t "$target" -l -- "$REPLY"
      tmux send-keys -t "$target" Enter
      return 0
      ;;
    *)
      tmux display-message "tmux-picker: azione sconosciuta: $action"
      return 1
      ;;
  esac

  [ -n "$toast" ] && tmux display-message "tmux-picker: $toast"
}

if json_requested "${@:2}"; then
  json_request_preflight "${1:-}" "${2:-}" || exit $?
  case "${1:-}" in
    message-status|unread-count)
      _json_args=("$1")
      shift
      for _json_arg in "$@"; do [ "$_json_arg" = '--json' ] || _json_args+=("$_json_arg"); done
      set -- "${_json_args[@]}"
      ;;
  esac
fi

case "${1:-}" in
  list)
    # Output cache removed (xtmux-rib.17): it froze agent-derived sort/badges
    # for the whole TTL. Only the git half is cached (in build_list); the list
    # is always rendered fresh so @agent_state changes are immediate.
    shift
    # xtmux-rib.12: accept mode as optional second arg (for CLI/test), else
    # read from the persisted state file (for reloads from inside fzf).
    if [ -n "${2:-}" ]; then
      _list_mode="$2"
    else
      read_list_mode; _list_mode="$REPLY"
    fi
    build_list "${1:-all}" "$_list_mode"
    exit 0
    ;;
  list-nav)
    # NAV-1 private transport: same inventory/filter/sort as `list`, emitted
    # as six-field NUL-delimited records (type/sid/name/target/token/display)
    # for the interactive fzf. Public `list` stays five-field newline TSV.
    shift
    if [ -n "${2:-}" ]; then
      _list_mode="$2"
    else
      read_list_mode; _list_mode="$REPLY"
    fi
    build_list "${1:-all}" "$_list_mode" nav multi
    exit 0
    ;;
  list-nav-single)
    # NAV-2 one-line fallback: same records and tokens as list-nav, but every
    # card is collapsed to one bounded line (fzf_multiline_probe=off).
    shift
    if [ -n "${2:-}" ]; then
      _list_mode="$2"
    else
      read_list_mode; _list_mode="$REPLY"
    fi
    build_list "${1:-all}" "$_list_mode" nav single
    exit 0
    ;;
  list-active)
    # richer filters (xtmux-rib.11): rebuild the list applying the active
    # content filter and the current sessions-only/expanded mode (xtmux-rib.12).
    shift
    picker_state_read filter || true; _spec="$REPLY"
    read_list_mode
    build_list "$_spec" "$REPLY"
    exit 0
    ;;
  list-active-nav)
    shift
    picker_state_read filter || true; _spec="$REPLY"
    read_list_mode
    build_list "$_spec" "$REPLY" nav multi
    exit 0
    ;;
  list-active-nav-single)
    shift
    picker_state_read filter || true; _spec="$REPLY"
    read_list_mode
    build_list "$_spec" "$REPLY" nav single
    exit 0
    ;;
  nav-snapshot-view)
  shift
  [ "$#" -eq 3 ] || die_usage "nav-snapshot-view requires <flat> <chain> <query>"
  nav_snapshot_view "$@"
  exit $?
  ;;
nav-snapshot-refresh)
  shift
  [ "$#" -eq 5 ] || die_usage "nav-snapshot-refresh requires <flat> <chain> <single|multi> <active|all|waiting|running> <query>"
  nav_snapshot_refresh "$@"
  exit $?
  ;;
  list-active-nav-chain|list-active-nav-single-chain)
    # Ancestry-preserving fuzzy projection, bound to fzf's `change` event. An
    # empty query re-emits the flat tree verbatim (the drawer's browse view);
    # any active query re-emits records whose display carries the full
    # session -> window -> pane chain, so ordinary fuzzy filtering can never
    # orphan a pane from its window and session. $1 carries fzf's {q} and is
    # used ONLY for the emptiness test — it is data, never reaches tmux or
    # eval, and is not part of any record.
    _chain_single=0
    [ "${1:-}" = list-active-nav-single-chain ] && _chain_single=1
    shift
    _chain_q="${1:-}"
    picker_state_read filter || true; _spec="$REPLY"
    read_list_mode
    if [ -n "$_chain_q" ]; then
      if [ "$_chain_single" = 1 ]; then
        build_list "$_spec" "$REPLY" nav single chain
      else
        build_list "$_spec" "$REPLY" nav multi chain
      fi
    else
      if [ "$_chain_single" = 1 ]; then
        build_list "$_spec" "$REPLY" nav single
      else
        build_list "$_spec" "$REPLY" nav multi
      fi
    fi
    exit 0
    ;;
  nav-go)
    # fzf Enter binding: act on the hidden action token {5} directly.
    shift
    nav_go "${1:-}"
    exit $?
    ;;
  nav-act)
    # NAV-2 single-row action dispatcher: the ONLY inputs are the hidden
    # action token {5} and a fixed action literal from the bind. Display text
    # never crosses the command line.
    shift
    nav_act "${1:-}" "${2:-}"
    exit $?
    ;;
  nav-border-label)
    shift
    nav_border_label
    exit 0
    ;;
  nav-key-help)
    shift
    nav_key_help
    exit 0
    ;;
  nav)
    # xtmux-rib.23/.25/.24: operator navigation family. Bare `nav` opens the
    # nav launcher (drawer; XTMUX_NAV_LAYOUT=classic or an unprovable fzf
    # routes it to the classic launcher). The verbs are direct tmux actions and
    # never build inventory or call git/fzf. Interactive-only: --json is
    # refused by the preflight above.
    shift
    case "${1:-}" in
      "") pick_nav; exit $? ;;
      help|-h|--help) [ "$#" -eq 1 ] || { printf 'usage: xtmux nav help\n' >&2; exit 2; }; nav_help; exit 0 ;;
      next) [ "$#" -eq 1 ] || { printf 'usage: xtmux nav next\n' >&2; exit 2; }; nav_session_cycle next; exit 0 ;;
      prev) [ "$#" -eq 1 ] || { printf 'usage: xtmux nav prev\n' >&2; exit 2; }; nav_session_cycle prev; exit 0 ;;
      window-next) [ "$#" -eq 1 ] || { printf 'usage: xtmux nav window-next\n' >&2; exit 2; }; nav_window_cycle next; exit 0 ;;
      window-prev) [ "$#" -eq 1 ] || { printf 'usage: xtmux nav window-prev\n' >&2; exit 2; }; nav_window_cycle prev; exit 0 ;;
      attention-next) [ "$#" -eq 1 ] || { printf 'usage: xtmux nav attention-next\n' >&2; exit 2; }; nav_attention_cycle next; exit 0 ;;
      attention-prev) [ "$#" -eq 1 ] || { printf 'usage: xtmux nav attention-prev\n' >&2; exit 2; }; nav_attention_cycle prev; exit 0 ;;
      back) [ "$#" -eq 1 ] || { printf 'usage: xtmux nav back\n' >&2; exit 2; }; jump_back; exit 0 ;;
      *) printf 'xtmux nav: unknown subcommand: %s\n' "$1" >&2; exit 2 ;;
    esac
    ;;
  mode-toggle)
    # xtmux-rib.12: flip sessions-only <-> expanded; the bind then reloads
    # with the flipped mode so the list immediately reflects it.
    shift
    toggle_list_mode
    exit 0
    ;;
  obligations)
    shift
    obs_v2_mode
    [ "$REPLY" = on ] || { printf 'obligations: requires XTMUX_OBS_V2=1\n' >&2; exit 2; }
    obs_runtime_argv
    exec "${OBS_ARGV[@]}" obligations "$@"
    ;;
  wait-agent)
    shift
    obs_v2_mode
    if [ "$REPLY" = on ]; then
      obs_runtime_argv
      exec "${OBS_ARGV[@]}" wait-agent "$@"
    fi
    wait_agent "$@"
    exit $?
    ;;
  monitor-agent)
    shift
    obs_v2_mode
    if [ "$REPLY" = on ]; then
      obs_runtime_argv
      exec "${OBS_ARGV[@]}" monitor-agent "$@"
    fi
    monitor_agent "$@"
    exit $?
    ;;
  monitor-run)
    shift
    monitor_run "$@"
    exit $?
    ;;
  monitor-list)
    shift
    obs_v2_mode
    if [ "$REPLY" = on ]; then
      obs_runtime_argv
      exec "${OBS_ARGV[@]}" monitor-list "$@"
    fi
    monitor_list "$@"
    exit $?
    ;;
  monitor-kill)
    shift
    monitor_kill "$@"
    exit $?
    ;;
  monitors)
    # Human-scannable operator view. Alias for monitor-list --pretty.
    shift
    monitors_view "$@"
    exit $?
    ;;
  safe-send-pointer)
    shift
    safe_send_pointer "$@"
    exit $?
    ;;
  worktree-collisions)
    shift
    worktree_collisions "$@"
    exit $?
    ;;
